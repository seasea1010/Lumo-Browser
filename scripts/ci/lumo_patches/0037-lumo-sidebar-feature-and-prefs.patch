+namespace {
+
+// Default web panels for the Lumo sidebar (patch 0037): name/URL
+// pairs shown as buttons in the sidebar bar. Users can edit or
+// remove them through the lumo.sidebar.web_panels pref.
+base::ListValue DefaultLumoSidebarWebPanels() {
+  base::ListValue panels;
+  auto add_panel = [&panels](const char* name, const char* url) {
+    base::DictValue panel;
+    panel.Set("name", std::string(name));
+    panel.Set("url", std::string(url));
+    panels.Append(std::move(panel));
+  };
+  add_panel("YouTube", "https://www.youtube.com/");
+  add_panel("X", "https://x.com/");
+  add_panel("ChatGPT", "https://chatgpt.com/");
+  add_panel("Claude", "https://claude.ai/");
+  add_panel("GitHub", "https://github.com/");
+  add_panel("Spotify", "https://open.spotify.com/");
+  return panels;
+}
+
+}  // namespace
+
 void RegisterBrowserUserPrefs(user_prefs::PrefRegistrySyncable* registry) {
