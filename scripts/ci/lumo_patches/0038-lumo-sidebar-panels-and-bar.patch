+// Copyright 2026 seasea1010
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/side_panel/lumo/lumo_web_panel_view.h"
+
+#include <string>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/common/pref_names.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/base/page_transition_types.h"
+#include "ui/views/controls/webview/webview.h"
+#include "url/gurl.h"
+
+namespace lumo_sidebar {
+
+LumoWebPanelView::LumoWebPanelView(Profile* profile) : profile_(profile) {
+  SetUseDefaultFillLayout(true);
+
+  content::WebContents::CreateParams create_params(profile);
+  web_contents_ = content::WebContents::Create(create_params);
+  web_view_ = AddChildView(std::make_unique<views::WebView>(profile));
+  web_view_->SetWebContents(web_contents_.get());
+
+  pref_change_registrar_.Init(profile->GetPrefs());
+  pref_change_registrar_.Add(
+      prefs::kLumoSidebarWebPanelUrl,
+      base::BindRepeating(&LumoWebPanelView::NavigateToPrefUrl,
+                          base::Unretained(this)));
+  NavigateToPrefUrl();
+}
+
+LumoWebPanelView::~LumoWebPanelView() {
+  // Detach the WebContents from the WebView before destroying it,
+  // so the WebView never points at a dead WebContents.
+  if (web_view_) {
+    web_view_->SetWebContents(nullptr);
+  }
+  web_contents_.reset();
+}
+
+void LumoWebPanelView::NavigateToPrefUrl() {
+  const std::string url_string =
+      profile_->GetPrefs()->GetString(prefs::kLumoSidebarWebPanelUrl);
+  const GURL url(url_string);
+  if (!url.is_valid() || web_contents_->GetURL() == url) {
+    return;
+  }
+  content::NavigationController::LoadURLParams params(url);
+  params.transition_type = ui::PAGE_TRANSITION_TYPED;
+  web_contents_->GetController().LoadURLWithParams(params);
+}
+
+}  // namespace lumo_sidebar
