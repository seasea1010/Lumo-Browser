+#ifndef CHROME_BROWSER_UI_VIEWS_SIDE_PANEL_LUMO_LUMO_SIDEBAR_BAR_H_
+#define CHROME_BROWSER_UI_VIEWS_SIDE_PANEL_LUMO_LUMO_SIDEBAR_BAR_H_
+
+#include <string>
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "chrome/browser/ui/side_panel/side_panel_entry_key.h"
+#include "ui/gfx/paint_vector_icon.h"
+#include "ui/views/view.h"
+
+class BrowserWindowInterface;
+class Profile;
+
+namespace views {
+class LabelButton;
+}  // namespace views
+
+namespace lumo_sidebar {
+
+// The Floorp-style vertical icon bar shown at the left edge of the
+// browser window while the kLumoSidebar feature is enabled (Lumo
+// patch 0038). Buttons toggle the built-in side panel entries, open
+// web panels, and toggle extension side panels. The bar is an
+// overlay: BrowserView::Layout() pins it to the left edge of the
+// contents area without shrinking the web contents.
+class LumoSidebarBar : public views::View {
+ public:
+  static constexpr int kExpandedWidth = 52;
+  static constexpr int kCollapsedWidth = 20;
+  // Space left above the first button so the always-visible
+  // development-stage label (patch 0008) never overlaps a button.
+  static constexpr int kTopInset = 40;
+
+  explicit LumoSidebarBar(BrowserWindowInterface* browser);
+  LumoSidebarBar(const LumoSidebarBar&) = delete;
+  LumoSidebarBar& operator=(const LumoSidebarBar&) = delete;
+  ~LumoSidebarBar() override;
+
+  // views::View:
+  void AddedToWidget() override;
+
+ private:
+  void BuildButtons();
+  void AddEntryButton(SidePanelEntryKey key);
+  void AddWebPanelPresetButton(const std::string& name,
+                               const std::string& url);
+  void AddUtilityButton(const gfx::VectorIcon& icon,
+                        const std::u16string& tooltip,
+                        const std::string& url);
+  void AddSeparator();
+  void ShowWebPanel(const std::string& url);
+  void ToggleEntry(SidePanelEntryKey key);
+  void OnCollapseToggle();
+  void OnSettingsPressed();
+  void RefreshCollapsedState();
+  bool IsCollapsed() const;
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+  raw_ptr<Profile> profile_;
+  bool buttons_built_ = false;
+  raw_ptr<views::LabelButton> collapse_button_ = nullptr;
+  std::vector<raw_ptr<views::View>> collapsible_children_;
+  base::WeakPtrFactory<LumoSidebarBar> weak_factory_{this};
+};
+
+}  // namespace lumo_sidebar
+
+#endif  // CHROME_BROWSER_UI_VIEWS_SIDE_PANEL_LUMO_LUMO_SIDEBAR_BAR_H_
