@@ -0,0 +1,263 @@
+// Copyright 2026 seasea1010
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/side_panel/lumo/lumo_sidebar_bar.h"
+
+#include <memory>
+#include <string>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/values.h"
+#include "chrome/app/vector_icons/vector_icons.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/chrome_pages.h"
+#include "chrome/browser/ui/color/chrome_color_id.h"
+#include "chrome/browser/ui/side_panel/side_panel_entry.h"
+#include "chrome/browser/ui/side_panel/side_panel_entry_id.h"
+#include "chrome/browser/ui/side_panel/side_panel_registry.h"
+#include "chrome/browser/ui/side_panel/side_panel_ui.h"
+#include "chrome/browser/ui/views/side_panel/side_panel_helper.h"
+#include "chrome/common/pref_names.h"
+#include "chrome/grit/generated_resources.h"
+#include "components/prefs/pref_service.h"
+#include "ui/actions/action_item.h"
+#include "ui/base/l10n/l10n_util.h"
+#include "ui/base/models/image_model.h"
+#include "ui/gfx/geometry/insets.h"
+#include "ui/gfx/text_constants.h"
+#include "ui/views/background.h"
+#include "ui/views/controls/button/image_button.h"
+#include "ui/views/controls/button/image_button_factory.h"
+#include "ui/views/controls/button/label_button.h"
+#include "ui/views/controls/separator.h"
+#include "ui/views/layout/box_layout.h"
+#include "ui/views/vector_icons.h"
+
+namespace lumo_sidebar {
+
+namespace {
+
+constexpr int kIconSize = 20;
+constexpr int kButtonSpacing = 4;
+
+std::unique_ptr<views::ImageButton> MakeIconButton(
+    views::Button::PressedCallback callback,
+    const gfx::VectorIcon& icon,
+    const std::u16string& tooltip) {
+  auto button = views::CreateVectorImageButtonWithNativeTheme(
+      std::move(callback), icon, kIconSize, kColorToolbarButtonIcon,
+      kColorToolbarButtonIconInactive);
+  button->SetTooltipText(tooltip);
+  return button;
+}
+
+}  // namespace
+
+LumoSidebarBar::LumoSidebarBar(BrowserWindowInterface* browser)
+    : browser_(browser), profile_(browser->GetProfile()) {
+  auto* layout = SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical,
+      gfx::Insets::TLBR(kTopInset, 6, 6, 6), kButtonSpacing));
+  layout->set_main_axis_alignment(
+      views::BoxLayout::MainAxisAlignment::kStart);
+  layout->set_cross_axis_alignment(
+      views::BoxLayout::CrossAxisAlignment::kCenter);
+  SetBackground(views::CreateThemedSolidBackground(kColorToolbar));
+  // The bar overlaps the web contents, so it must paint to its own
+  // layer to stay visible above the contents layer (the same reason
+  // the patch 0008 label paints to a layer).
+  SetPaintToLayer();
+  layer()->SetFillsBoundsOpaquely(false);
+  layer()->SetName("Lumo Sidebar Bar");
+}
+
+LumoSidebarBar::~LumoSidebarBar() = default;
+
+void LumoSidebarBar::AddedToWidget() {
+  views::View::AddedToWidget();
+  if (buttons_built_) {
+    return;
+  }
+  buttons_built_ = true;
+  // The BrowserWindowFeatures (BrowserActions, SidePanelRegistry,
+  // ...) may not be initialized yet while the window is being
+  // created, so build the buttons on the next task.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&LumoSidebarBar::BuildButtons,
+                                weak_factory_.GetWeakPtr()));
+}
+
+void LumoSidebarBar::BuildButtons() {
+  if (!browser_ || !profile_) {
+    return;
+  }
+
+  AddEntryButton(SidePanelEntryKey(SidePanelEntryId::kBookmarks));
+  AddEntryButton(SidePanelEntryKey(SidePanelEntryId::kHistory));
+  AddEntryButton(SidePanelEntryKey(SidePanelEntryId::kReadingList));
+  AddEntryButton(SidePanelEntryKey(SidePanelEntryId::kLumoWebPanel));
+
+  AddSeparator();
+
+  // Web panel presets from the pref (name/URL pairs).
+  const base::ListValue& panels =
+      profile_->GetPrefs()->GetList(prefs::kLumoSidebarWebPanels);
+  for (const base::Value& panel : panels) {
+    if (!panel.is_dict()) {
+      continue;
+    }
+    const base::DictValue& dict = panel.GetDict();
+    const std::string* name = dict.FindString("name");
+    const std::string* url = dict.FindString("url");
+    if (name && url && !name->empty() && !url->empty()) {
+      AddWebPanelPresetButton(*name, *url);
+    }
+  }
+
+  AddSeparator();
+
+  AddUtilityButton(vector_icons::kDownloadIcon,
+                   l10n_util::GetStringUTF16(IDS_LUMO_SIDEBAR_DOWNLOADS),
+                   "chrome://downloads/");
+  AddUtilityButton(vector_icons::kPasswordIcon,
+                   l10n_util::GetStringUTF16(IDS_LUMO_SIDEBAR_PASSWORDS),
+                   "chrome://password-manager/");
+  AddUtilityButton(views::kMenuIcon,
+                   l10n_util::GetStringUTF16(IDS_LUMO_SIDEBAR_TOOLS),
+                   "chrome://tools/");
+
+  // Extension side panel entries registered for this window.
+  // Extensions enabled later appear from the next window on.
+  if (SidePanelRegistry* registry = SidePanelRegistry::From(browser_)) {
+    for (const auto& entry : registry->entries()) {
+      if (entry->key().id() == SidePanelEntryId::kExtension) {
+        AddEntryButton(entry->key());
+      }
+    }
+  }
+
+  // Flexible spacer pushes the bottom controls down.
+  auto spacer = std::make_unique<views::View>();
+  views::View* spacer_ptr = AddChildView(std::move(spacer));
+  static_cast<views::BoxLayout*>(layout_manager())
+      ->SetFlexForView(spacer_ptr, 1);
+  collapsible_children_.push_back(spacer_ptr);
+
+  auto collapse = std::make_unique<views::LabelButton>(
+      base::BindRepeating(&LumoSidebarBar::OnCollapseToggle,
+                          base::Unretained(this)),
+      u"\u2039");
+  collapse_button_ = AddChildView(std::move(collapse));
+
+  collapsible_children_.push_back(AddChildView(MakeIconButton(
+      base::BindRepeating(&LumoSidebarBar::OnSettingsPressed,
+                          base::Unretained(this)),
+      vector_icons::kSettingsIcon,
+      l10n_util::GetStringUTF16(IDS_LUMO_SIDEBAR_SETTINGS))));
+
+  RefreshCollapsedState();
+  InvalidateLayout();
+}
+
+void LumoSidebarBar::AddEntryButton(SidePanelEntryKey key) {
+  actions::ActionItem* item = SidePanelHelper::GetActionItem(browser_, key);
+  if (!item) {
+    return;
+  }
+  ui::ImageModel image = item->GetImage();
+  if (!image.IsVectorIcon()) {
+    return;
+  }
+  const gfx::VectorIcon* icon = image.GetVectorIcon().vector_icon();
+  if (!icon) {
+    return;
+  }
+  collapsible_children_.push_back(AddChildView(MakeIconButton(
+      base::BindRepeating(&LumoSidebarBar::ToggleEntry,
+                          base::Unretained(this), key),
+      *icon, item->GetText())));
+}
+
+void LumoSidebarBar::AddWebPanelPresetButton(const std::string& name,
+                                             const std::string& url) {
+  // Preset buttons show the first letters of the site name, like a
+  // favicon fallback tile, instead of a fake icon.
+  std::string initials = name.substr(0, name.size() >= 2 ? 2 : 1);
+  auto button = std::make_unique<views::LabelButton>(
+      base::BindRepeating(&LumoSidebarBar::ShowWebPanel,
+                          base::Unretained(this), url),
+      base::UTF8ToUTF16(initials));
+  button->SetTooltipText(base::UTF8ToUTF16(name));
+  button->SetHorizontalAlignment(gfx::ALIGN_CENTER);
+  collapsible_children_.push_back(AddChildView(std::move(button)));
+}
+
+void LumoSidebarBar::AddUtilityButton(const gfx::VectorIcon& icon,
+                                       const std::u16string& tooltip,
+                                       const std::string& url) {
+  collapsible_children_.push_back(AddChildView(MakeIconButton(
+      base::BindRepeating(&LumoSidebarBar::ShowWebPanel,
+                          base::Unretained(this), url),
+      icon, tooltip)));
+}
+
+void LumoSidebarBar::AddSeparator() {
+  auto separator = std::make_unique<views::Separator>();
+  separator->SetPreferredLength(kExpandedWidth - 16);
+  collapsible_children_.push_back(AddChildView(std::move(separator)));
+}
+
+void LumoSidebarBar::ShowWebPanel(const std::string& url) {
+  profile_->GetPrefs()->SetString(prefs::kLumoSidebarWebPanelUrl, url);
+  if (auto* side_panel_ui = SidePanelUI::From(browser_)) {
+    side_panel_ui->Show(SidePanelEntryId::kLumoWebPanel,
+                        SidePanelOpenTrigger::kToolbarButton);
+  }
+}
+
+void LumoSidebarBar::ToggleEntry(SidePanelEntryKey key) {
+  if (auto* side_panel_ui = SidePanelUI::From(browser_)) {
+    side_panel_ui->Toggle(key, SidePanelOpenTrigger::kToolbarButton);
+  }
+}
+
+void LumoSidebarBar::OnCollapseToggle() {
+  if (!profile_) {
+    return;
+  }
+  PrefService* prefs = profile_->GetPrefs();
+  prefs->SetBoolean(prefs::kLumoSidebarBarCollapsed,
+                    !prefs->GetBoolean(prefs::kLumoSidebarBarCollapsed));
+  RefreshCollapsedState();
+  InvalidateLayout();
+}
+
+void LumoSidebarBar::OnSettingsPressed() {
+  if (profile_) {
+    chrome::ShowSettings(profile_);
+  }
+}
+
+void LumoSidebarBar::RefreshCollapsedState() {
+  const bool collapsed = IsCollapsed();
+  for (views::View* child : collapsible_children_) {
+    child->SetVisible(!collapsed);
+  }
+  if (collapse_button_) {
+    collapse_button_->SetText(collapsed ? u"\u203a" : u"\u2039");
+    collapse_button_->SetTooltipText(l10n_util::GetStringUTF16(
+        collapsed ? IDS_LUMO_SIDEBAR_EXPAND : IDS_LUMO_SIDEBAR_COLLAPSE));
+  }
+}
+
+bool LumoSidebarBar::IsCollapsed() const {
+  return profile_ &&
+         profile_->GetPrefs()->GetBoolean(prefs::kLumoSidebarBarCollapsed);
+}
+
+}  // namespace lumo_sidebar
