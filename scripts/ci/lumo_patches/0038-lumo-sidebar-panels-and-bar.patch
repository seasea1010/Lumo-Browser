+
+SidePanelNativeView CreateWebPanelView(Profile* profile,
+                                       SidePanelEntryScope& scope) {
+  return std::make_unique<LumoWebPanelView>(profile);
+}
+
+}  // namespace
+
+void RegisterLumoSidebarEntries(BrowserWindowInterface* browser,
+                                SidePanelRegistry* window_registry) {
+  Profile* profile = browser->GetProfile();
+  auto entry = std::make_unique<SidePanelEntry>(
+      SidePanelEntry::Key(SidePanelEntryId::kLumoWebPanel),
+      base::BindRepeating(&CreateWebPanelView, profile),
+      /*default_content_width_callback=*/base::NullCallback());
+  window_registry->Register(std::move(entry));
+}
+
+}  // namespace lumo_sidebar
