+// Copyright 2026 seasea1010
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_SIDE_PANEL_LUMO_LUMO_WEB_PANEL_VIEW_H_
+#define CHROME_BROWSER_UI_VIEWS_SIDE_PANEL_LUMO_LUMO_WEB_PANEL_VIEW_H_
+
+#include <memory>
+
+#include "base/memory/raw_ptr.h"
+#include "components/prefs/pref_change_registrar.h"
+#include "ui/views/view.h"
+
+class Profile;
+
+namespace content {
+class WebContents;
+}  // namespace content
+
+namespace views {
+class WebView;
+}  // namespace views
+
+namespace lumo_sidebar {
+
+// The content view of the Lumo sidebar web panel (patch 0038): a
+// plain WebContents hosted in a views::WebView. It shows the URL
+// stored in the lumo.sidebar.web_panel_url pref and navigates
+// whenever that pref changes (the sidebar bar sets it when a web
+// panel button is pressed). No WebContentsDelegate is attached, so
+// links that would open a new window do nothing in this version.
+class LumoWebPanelView : public views::View {
+ public:
+  explicit LumoWebPanelView(Profile* profile);
+  LumoWebPanelView(const LumoWebPanelView&) = delete;
+  LumoWebPanelView& operator=(const LumoWebPanelView&) = delete;
+  ~LumoWebPanelView() override;
+
+ private:
+  void NavigateToPrefUrl();
+
+  const raw_ptr<Profile> profile_;
+  std::unique_ptr<content::WebContents> web_contents_;
+  raw_ptr<views::WebView> web_view_ = nullptr;
+  PrefChangeRegistrar pref_change_registrar_;
+};
+
+}  // namespace lumo_sidebar
+
+#endif  // CHROME_BROWSER_UI_VIEWS_SIDE_PANEL_LUMO_LUMO_WEB_PANEL_VIEW_H_
