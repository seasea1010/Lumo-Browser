@@ -192,6 +206,60 @@ void TabStripModel::ExecuteContextMenuCommand(int context_index,
       break;
     }
 
+    // Lumo (patch 0042): discard the selected tabs without closing
+    // them. This is the manual form of what memory saver does
+    // automatically: the tab stays in the strip (shown dimmed, like
+    // an automatically discarded tab) and reloads when revisited.
+    case CommandDiscardTab: {
+      base::UmaHistogramCounts1000(
+          "Tab.ContextMenu.DiscardTab.SelectedTabsCount",
+          selection_model_.size());
+      base::RecordAction(UserMetricsAction("TabContextMenu_DiscardTab"));
+
+      std::vector<int> indices = GetIndicesForCommand(context_index);
+      std::vector<tabs::TabInterface*> tabs = GetTabsAtIndices(indices);
+
+      // A visible (active) tab cannot be discarded. If the active
+      // tab is among the targets, activate a neighbouring tab that
+      // is not itself a target first; if every tab is a target
+      // there is nowhere to move to, so the active tab is skipped.
+      tabs::TabInterface* active_tab = GetActiveTab();
+      const bool active_is_target =
+          active_tab && std::ranges::contains(tabs, active_tab);
+      if (active_is_target) {
+        std::optional<int> neighbour;
+        for (int i = 0; i < count(); ++i) {
+          if (!std::ranges::contains(indices, i)) {
+            neighbour = i;
+            break;
+          }
+        }
+        if (neighbour) {
+          ActivateTabAt(*neighbour,
+                        TabStripUserGestureDetails(
+                            TabStripUserGestureType::kOther));
+        }
+      }
+
+      for (tabs::TabInterface* tab : tabs) {
+        if (tab == active_tab && active_is_target &&
+            GetActiveTab() == active_tab) {
+          continue;
+        }
+        content::WebContents* contents = tab->GetContents();
+        auto* lifecycle_unit =
+            contents ? resource_coordinator::TabLifecycleUnitExternal::
+                           FromWebContents(contents)
+                     : nullptr;
+        if (lifecycle_unit) {
+          lifecycle_unit->DiscardTab(
+              resource_coordinator::mojom::LifecycleUnitDiscardReason::
+                  EXTERNAL);
+        }
+      }
+      break;
+    }
+
     case CommandSendTabToSelf: {
       base::UmaHistogramCounts1000(
           "Tab.ContextMenu.SendTabToSelf.SelectedTabsCount",
