@@ -717,6 +733,20 @@ ThemeService::BrowserColorScheme ThemeService::GetBrowserColorScheme() const {
       profile_->GetPrefs()->GetInteger(prefs::kBrowserColorScheme));
 }
 
+void ThemeService::ApplyLumoDarkModeSchedule() {
+  // Lumo (patch 0015): the night window is fixed at 19:00-07:00
+  // local time. Only called while the kLumoDarkModeSchedule
+  // experiment is enabled.
+  base::Time::Exploded exploded;
+  base::Time::Now().LocalExplode(&exploded);
+  const bool is_night = exploded.hour >= 19 || exploded.hour < 7;
+  const BrowserColorScheme target =
+      is_night ? BrowserColorScheme::kDark : BrowserColorScheme::kLight;
+  if (GetBrowserColorScheme() != target) {
+    SetBrowserColorScheme(target);
+  }
+}
+
 bool ThemeService::BrowserUsesDarkColors() const {
   const BrowserColorScheme color_scheme = GetBrowserColorScheme();
   return color_scheme == BrowserColorScheme::kDark ||
