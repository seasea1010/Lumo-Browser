@@ -366,6 +369,19 @@ void ThemeService::Init() {
 
   InitFromPrefs();
 
+  // Lumo (patch 0015): while the kLumoDarkModeSchedule
+  // experiment is enabled, the schedule owns the browser color
+  // scheme. Apply the current time-of-day scheme right away and
+  // re-check every minute. When the experiment is off, none of
+  // this runs and the color scheme is left to the user/OS.
+  if (base::FeatureList::IsEnabled(features::kLumoDarkModeSchedule)) {
+    ApplyLumoDarkModeSchedule();
+    lumo_dark_mode_schedule_timer_.Start(
+        FROM_HERE, base::Minutes(1),
+        base::BindRepeating(&ThemeService::ApplyLumoDarkModeSchedule,
+                            base::Unretained(this)));
+  }
