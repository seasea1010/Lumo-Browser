+
+import {html} from '//resources/lit/v3_0/lit.rollup.js';
+
+import type {SettingsLumoMonitorPageElement} from './lumo_monitor_page.js';
+
+export function getHtml(this: SettingsLumoMonitorPageElement) {
+  return html`<!--_html_template_start_-->
+<settings-section page-title="$i18n{lumoMonitorPageTitle}">
+  ${this.info_ ? html`
+  <div class="cr-row first">
+    <div class="flex cr-padded-text">
+      <div>$i18n{lumoMonitorVersionLabel}</div>
+      <div class="secondary">${this.info_.version}</div>
+    </div>
+  </div>
+  <div class="cr-row">
+    <div class="flex cr-padded-text">
+      <div>$i18n{lumoMonitorProfileNameLabel}</div>
+      <div class="secondary">${this.info_.profileName}</div>
+    </div>
+  </div>
+  <div class="cr-row">
+    <div class="flex cr-padded-text">
+      <div>$i18n{lumoMonitorProfilePathLabel}</div>
+      <div class="secondary">${this.info_.profilePath}</div>
+    </div>
+  </div>
+  <div class="cr-row">
+    <div class="flex cr-padded-text">
+      <div>$i18n{lumoMonitorUptimeLabel}</div>
+      <div class="secondary">
+        ${this.formatUptime_(this.info_.uptimeSeconds)}
+      </div>
+    </div>
+  </div>
+  <div class="cr-row">
+    <div class="flex cr-padded-text">
+      <div>$i18n{lumoMonitorWindowsTabsLabel}</div>
+      <div class="secondary">
+        ${this.info_.windowCount} ウィンドウ / ${this.info_.tabCount} タブ
+      </div>
+    </div>
+  </div>
+  <div class="cr-row">
+    <div class="flex cr-padded-text">
+      <div>$i18n{lumoMonitorMemoryLabel}</div>
+      <div class="secondary">
+        ${this.formatMemory_(this.info_.totalMemoryBytes)}
+      </div>
+    </div>
+  </div>
+  <div class="cr-row">
+    <div class="flex cr-padded-text">
+      <div>$i18n{lumoMonitorSyncLabel}</div>
+      <div class="secondary">${this.syncStateText_()}</div>
+    </div>
+  </div>
+  <div class="cr-row">
+    <div class="flex cr-padded-text">
+      <div>$i18n{lumoMonitorFeaturesLabel}</div>
+      <div class="secondary">${this.featuresText_()}</div>
+    </div>
+  </div>
+  <div class="cr-row">
+    <div class="flex cr-padded-text">
+      <div>$i18n{lumoMonitorApiKeyLabel}</div>
+      <div class="secondary">${this.apiKeyText_()}</div>
+    </div>
+  </div>
+  <div class="cr-row">
+    <div class="flex cr-padded-text">
+      <div>$i18n{lumoMonitorLockLabel}</div>
+      <div class="secondary">${this.lockText_()}</div>
+    </div>
+  </div>
+  <div class="cr-row">
+    <div class="flex cr-padded-text">
+      <div>$i18n{lumoMonitorDebuggerLabel}</div>
+      <div class="secondary">${this.debuggerText_()}</div>
+    </div>
+  </div>
+  <div class="cr-row">
+    <div class="flex cr-padded-text">
+      <div>$i18n{lumoMonitorCrashLabel}</div>
+      <div class="secondary">${this.crashText_()}</div>
+    </div>
+  </div>` : html`
+  <div class="cr-row first">
+    <div class="flex cr-padded-text">
+      <div>読み込み中…</div>
+    </div>
+  </div>`}
+  <div class="cr-row">
+    <cr-button id="lumoMonitorRefresh" @click="${this.onRefreshClick_}">
+      $i18n{lumoMonitorRefresh}
+    </cr-button>
+  </div>
+</settings-section><!--_html_template_end_-->`;
+}
diff --git a/chrome/browser/resources/settings/lumo_monitor_page/lumo_monitor_page.ts b/chrome/browser/resources/settings/lumo_monitor_page/lumo_monitor_page.ts
new file mode 100644
index 0000000..8c94363
--- /dev/null
+++ b/chrome/browser/resources/settings/lumo_monitor_page/lumo_monitor_page.ts
@@ -0,0 +1,148 @@
+// Copyright 2026 seasea1010
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+/**
+ * @fileoverview 'settings-lumo-monitor-page' is the Lumo Monitor
+ * settings page (Lumo patch 0022): a read-only snapshot of the
+ * browser's state — version, profile, uptime, tab/window counts,
+ * total memory, Sync state, enabled Lumo experiments, API key
+ * presence, the startup password lock state, the debugger session
+ * state, and recent crash reports. All data comes from
+ * settings::LumoMonitorHandler; the display strings are Japanese
+ * because the page is Lumo-specific (same approach as the Sync
+ * self-test in patch 0009).
+ */
+
+import 'chrome://resources/cr_elements/cr_button/cr_button.js';
+import '../settings_page/settings_section.js';
+
+import {I18nMixinLit} from 'chrome://resources/cr_elements/i18n_mixin_lit.js';
+import {CrLitElement} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+
+import {getCss} from './lumo_monitor_page.css.js';
+import {getHtml} from './lumo_monitor_page.html.js';
+import type {LumoMonitorInfo} from './lumo_monitor_browser_proxy.js';
+import {LumoMonitorBrowserProxyImpl} from './lumo_monitor_browser_proxy.js';
+
+const SettingsLumoMonitorPageElementBase = I18nMixinLit(CrLitElement);
+
+export class SettingsLumoMonitorPageElement extends
+    SettingsLumoMonitorPageElementBase {
+  static get is() {
+    return 'settings-lumo-monitor-page';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      info_: {type: Object},
+    };
+  }
+
+  protected accessor info_: LumoMonitorInfo|null = null;
+
+  private browserProxy_ = LumoMonitorBrowserProxyImpl.getInstance();
+
+  override connectedCallback() {
+    super.connectedCallback();
+    this.refresh_();
+  }
+
+  protected onRefreshClick_() {
+    this.refresh_();
+  }
+
+  private refresh_() {
+    this.browserProxy_.getLumoMonitorInfo().then(info => {
+      this.info_ = info;
+    });
+  }
+
+  protected formatUptime_(seconds: number): string {
+    const totalMinutes = Math.floor(seconds / 60);
+    const hours = Math.floor(totalMinutes / 60);
+    const minutes = totalMinutes % 60;
+    return hours > 0 ? `${hours} 時間 ${minutes} 分` : `${minutes} 分`;
+  }
+
+  protected formatMemory_(bytes: number): string {
+    const mb = bytes / (1024 * 1024);
+    if (mb >= 1024) {
+      return `${(mb / 1024).toFixed(2)} GB`;
+    }
+    return `${mb.toFixed(0)} MB`;
+  }
+
+  protected syncStateText_(): string {
+    if (!this.info_) {
+      return '';
+    }
+    if (!this.info_.syncSignedIn) {
+      return 'サインインしていません';
+    }
+    return this.info_.syncActive ?
+        'サインイン済み・同期中' :
+        `サインイン済み（状態: ${this.info_.syncTransportState}）`;
+  }
+
+  protected featuresText_(): string {
+    if (!this.info_ || this.info_.enabledFeatures.length === 0) {
+      return 'なし';
+    }
+    return this.info_.enabledFeatures.join(', ');
+  }
+
+  protected apiKeyText_(): string {
+    if (!this.info_) {
+      return '';
+    }
+    if (this.info_.apiKeyConfigured && this.info_.oauthClientConfigured) {
+      return '組み込み済み（サインインと同期が使えます）';
+    }
+    return '未組み込み';
+  }
+
+  protected lockText_(): string {
+    if (!this.info_) {
+      return '';
+    }
+    if (!this.info_.lockConfigured) {
+      return '設定されていません';
+    }
+    return this.info_.lockUnlocked ? '設定済み（解除済み）' :
+                                      '設定済み（未解除）';
+  }
+
+  protected debuggerText_(): string {
+    if (!this.info_) {
+      return '';
+    }
+    return this.info_.debuggerSession ? 'デバッガー連携セッション中' :
+                                         '通常起動（連携なし）';
+  }
+
+  protected crashText_(): string {
+    if (!this.info_ || this.info_.crashReportCount === 0) {
+      return 'なし';
+    }
+    const latest = new Date(this.info_.latestCrashTimeMs).toLocaleString();
+    return `${this.info_.crashReportCount} 件（最新: ${latest}）`;
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'settings-lumo-monitor-page': SettingsLumoMonitorPageElement;
+  }
+}
+
+customElements.define(
+    SettingsLumoMonitorPageElement.is, SettingsLumoMonitorPageElement);
