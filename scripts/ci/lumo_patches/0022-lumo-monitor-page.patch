+#include "components/version_info/version_info.h"
+#include "google_apis/google_api_keys.h"
+
+// Lumo (patch 0019): the startup password lock's build-time
+// configuration. scripts/ci/stage.py generates this header from the
+// LUMO_LOCK_HASH secret during setup; it is deliberately not part of
+// the source tree, and a tree without it (or with an empty hash)
+// builds with the lock disabled.
+#if __has_include("chrome/browser/lumo/lumo_lock_config.h")
+#include "chrome/browser/lumo/lumo_lock_config.h"
+#define LUMO_MONITOR_LOCK_CONFIG_AVAILABLE 1
+#endif  // __has_include("chrome/browser/lumo/lumo_lock_config.h")
+
+namespace settings {
+
+namespace {
+
+// String form of a Sync transport state, mirroring the Sync
+// self-test in PeopleHandler (Lumo patch 0009).
+const char* TransportStateToString(
+    syncer::SyncService::TransportState state) {
+  using TransportState = syncer::SyncService::TransportState;
+  switch (state) {
+    case TransportState::DISABLED:
+      return "DISABLED";
+    case TransportState::PAUSED:
+      return "PAUSED";
+    case TransportState::START_DEFERRED:
+      return "START_DEFERRED";
+    case TransportState::INITIALIZING:
+      return "INITIALIZING";
+    case TransportState::PENDING_DESIRED_CONFIGURATION:
+      return "PENDING_DESIRED_CONFIGURATION";
+    case TransportState::CONFIGURING:
+      return "CONFIGURING";
+    case TransportState::ACTIVE:
+      return "ACTIVE";
+  }
+}
+
+// Collects the browser's total memory usage through MemoryDetails
+// (the same source chrome://memory-internals used): the private
+// memory footprint of the browser process and every child process
+// belonging to this browser, summed. Self-owned via the MemoryDetails
+// refcount; the callback runs on the UI thread.
+class LumoMemoryDetails : public MemoryDetails {
+ public:
+  using Callback = base::OnceCallback<void(uint64_t)>;
+
+  explicit LumoMemoryDetails(Callback callback)
+      : callback_(std::move(callback)) {}
+
+  LumoMemoryDetails(const LumoMemoryDetails&) = delete;
+  LumoMemoryDetails& operator=(const LumoMemoryDetails&) = delete;
+
+  // MemoryDetails:
+  void OnDetailsAvailable() override {
+    uint64_t total_kb = 0;
+    if (ProcessData* browser = ChromeBrowser()) {
+      for (const ProcessMemoryInformation& info : browser->processes) {
+        total_kb += info.private_memory_footprint_kb;
+      }
+    }
+    std::move(callback_).Run(total_kb * 1024);
+  }
+
+ private:
+  ~LumoMemoryDetails() override = default;
+
+  Callback callback_;
+};
+
+
+
+// True when this build carries a startup password lock
+// configuration (patch 0019): stage.py generated the config header
+// with a non-empty expected hash. The hash itself is only compared
+// for emptiness here; it is never exposed to the page.
+bool IsStartupLockConfigured() {
+#if defined(LUMO_MONITOR_LOCK_CONFIG_AVAILABLE)
+  return !std::string_view(lumo::kLockHashHex).empty();
+#else
+  return false;
+#endif
+}
+
+void AppendFeatureIfEnabled(base::ListValue* list,
+                            const base::Feature& feature) {
+  if (base::FeatureList::IsEnabled(feature)) {
+    list->Append(feature.name);
+  }
+}
+
+}  // namespace
+
+LumoMonitorHandler::LumoMonitorHandler(Profile* profile)
+    : profile_(profile) {}
+
+LumoMonitorHandler::~LumoMonitorHandler() = default;
+
+void LumoMonitorHandler::RegisterMessages() {
+  web_ui()->RegisterMessageCallback(
+      "getLumoMonitorInfo",
+      base::BindRepeating(&LumoMonitorHandler::HandleGetLumoMonitorInfo,
+                          base::Unretained(this)));
+}
+
+void LumoMonitorHandler::OnJavascriptAllowed() {}
+
+void LumoMonitorHandler::OnJavascriptDisallowed() {
+  pending_callback_id_ = base::Value();
+  weak_ptr_factory_.InvalidateWeakPtrs();
+}
+
+// static
+LumoMonitorHandler::CrashReportSummary LumoMonitorHandler::ScanCrashReports(
+    const base::FilePath& user_data_dir) {
+  CrashReportSummary summary;
+  const base::FilePath crashpad_dir =
+      user_data_dir.Append(FILE_PATH_LITERAL("Crashpad"));
+  for (const char* subdir : {"reports", "pending"}) {
+    base::FileEnumerator enumerator(
+        crashpad_dir.Append(base::FilePath::FromUTF8Unsafe(subdir)),
+        false, base::FileEnumerator::FILES, FILE_PATH_LITERAL("*.dmp"));
+    for (base::FilePath path = enumerator.Next(); !path.empty();
+         path = enumerator.Next()) {
+      ++summary.count;
+      const double modified_ms = enumerator.GetInfo()
+                                     .GetLastModifiedTime()
+                                     .InMillisecondsFSinceUnixEpoch();
+      if (modified_ms > summary.latest_time_ms) {
+        summary.latest_time_ms = modified_ms;
+      }
+    }
+  }
+  return summary;
+}
+
+void LumoMonitorHandler::HandleGetLumoMonitorInfo(
+    const base::ListValue& args) {
+  AllowJavascript();
+  CHECK_EQ(1U, args.size());
+  pending_callback_id_ = args[0].Clone();
+  crash_summary_ready_ = false;
+  memory_ready_ = false;
+
+  base::FilePath user_data_dir;
+  base::PathService::Get(chrome::DIR_USER_DATA, &user_data_dir);
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&LumoMonitorHandler::ScanCrashReports, user_data_dir),
+      base::BindOnce(&LumoMonitorHandler::OnCrashReportSummary,
+                     weak_ptr_factory_.GetWeakPtr()));
+
+  scoped_refptr<LumoMemoryDetails> memory_details(new LumoMemoryDetails(
+      base::BindOnce(&LumoMonitorHandler::OnMemoryTotal,
+                     weak_ptr_factory_.GetWeakPtr())));
+  memory_details->StartFetch();
+}
+
+void LumoMonitorHandler::OnCrashReportSummary(CrashReportSummary summary) {
+  crash_summary_ = summary;
+  crash_summary_ready_ = true;
+  MaybeResolveCallback();
+}
+
+void LumoMonitorHandler::OnMemoryTotal(uint64_t total_bytes) {
+  memory_total_bytes_ = total_bytes;
+  memory_ready_ = true;
+  MaybeResolveCallback();
+}
+
+void LumoMonitorHandler::MaybeResolveCallback() {
+  if (!crash_summary_ready_ || !memory_ready_ ||
+      pending_callback_id_.is_none()) {
+    return;
+  }
+
+  base::DictValue info;
+
+  info.Set("version", std::string(version_info::GetVersionNumber()));
+  info.Set("profileName", profile_->GetProfileUserName());
+  info.Set("profilePath", profile_->GetPath().AsUTF8Unsafe());
+
+  const base::TimeDelta uptime =
+      base::Time::Now() - base::Process::Current().CreationTime();
+  info.Set("uptimeSeconds", static_cast<double>(uptime.InSeconds()));
+
+  int window_count = 0;
+  int tab_count = 0;
+  GlobalBrowserCollection::GetInstance()->ForEach(
+      [&window_count, &tab_count](BrowserWindowInterface* browser) {
+        ++window_count;
+        if (TabStripModel* model = browser->GetTabStripModel()) {
+          tab_count += model->count();
+        }
+        return true;
+      });
+  info.Set("windowCount", window_count);
+  info.Set("tabCount", tab_count);
+
+  info.Set("totalMemoryBytes",
+           static_cast<double>(memory_total_bytes_));
+
+  signin::IdentityManager* identity_manager =
+      IdentityManagerFactory::GetForProfile(profile_);
+  // Signed-in means a primary account at the sign-in consent
+  // level: under the account-storage model the account is held
+  // at kSignin, and requiring kSync here reported a signed-in
+  // profile as "not signed in" (build #29 real-machine check).
+  info.Set("syncSignedIn",
+           identity_manager &&
+               identity_manager->HasPrimaryAccount(
+                   signin::ConsentLevel::kSignin));
+  syncer::SyncService* sync_service =
+      SyncServiceFactory::IsSyncAllowed(profile_)
+          ? SyncServiceFactory::GetForProfile(profile_)
+          : nullptr;
+  const syncer::SyncService::TransportState transport_state =
+      sync_service ? sync_service->GetTransportState()
+                   : syncer::SyncService::TransportState::DISABLED;
+  info.Set("syncTransportState", TransportStateToString(transport_state));
+  info.Set("syncActive",
+           sync_service && sync_service->IsSyncFeatureActive() &&
+               transport_state ==
+                   syncer::SyncService::TransportState::ACTIVE);
+
+  base::ListValue enabled_features;
+  AppendFeatureIfEnabled(&enabled_features, features::kLumoGlicMenu);
+  AppendFeatureIfEnabled(&enabled_features,
+                         features::kLumoHoverCardMemoryUsage);
+  AppendFeatureIfEnabled(&enabled_features,
+                         features::kLumoDarkModeSchedule);
+  AppendFeatureIfEnabled(&enabled_features,
+                         features::kLumoTrackingProtectionStrict);
+  AppendFeatureIfEnabled(&enabled_features,
+                         features::kLumoFullPageScreenshot);
+  AppendFeatureIfEnabled(&enabled_features,
+                         features::kLumoTabGroupSessionSave);
+  AppendFeatureIfEnabled(&enabled_features,
+                         features::kLumoLaunchThoriumProfile);
+  info.Set("enabledFeatures", std::move(enabled_features));
+
+  // Presence only: the key and client values themselves are never
+  // read into the result (same rule as the patch 0009 Sync test).
+  info.Set("apiKeyConfigured", !google_apis::GetAPIKey().empty());
+  info.Set("oauthClientConfigured",
+           !google_apis::GetOAuth2ClientID(google_apis::CLIENT_MAIN)
+                .empty() &&
+               !google_apis::GetOAuth2ClientSecret(
+                    google_apis::CLIENT_MAIN)
+                    .empty());
+
+  const bool lock_configured = IsStartupLockConfigured();
+  info.Set("lockConfigured", lock_configured);
+  bool lock_unlocked = false;
+  if (lock_configured) {
+    base::FilePath user_data_dir;
+    base::PathService::Get(chrome::DIR_USER_DATA, &user_data_dir);
+    lock_unlocked = base::PathExists(
+        user_data_dir.Append(FILE_PATH_LITERAL("lumo-unlock-token")));
+  }
+  info.Set("lockUnlocked", lock_unlocked);
+
+  info.Set("debuggerSession", lumo::debugger::IsEnabled());
+
+  info.Set("crashReportCount", crash_summary_.count);
+  info.Set("latestCrashTimeMs", crash_summary_.latest_time_ms);
+
+  base::Value callback_id = std::move(pending_callback_id_);
+  pending_callback_id_ = base::Value();
+  ResolveJavascriptCallback(callback_id, base::Value(std::move(info)));
+}
+
+}  // namespace settings
