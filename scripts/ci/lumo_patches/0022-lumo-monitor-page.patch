@@ -0,0 +1,59 @@
+// Copyright 2026 seasea1010
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import {sendWithPromise} from 'chrome://resources/js/cr.js';
+
+/**
+ * @fileoverview Browser proxy for the Lumo Monitor settings page
+ * (Lumo patch 0022).
+ */
+
+/**
+ * Snapshot of the browser state shown on the Lumo Monitor page.
+ * Field names mirror the dictionary built by
+ * settings::LumoMonitorHandler.
+ */
+export interface LumoMonitorInfo {
+  version: string;
+  profileName: string;
+  profilePath: string;
+  uptimeSeconds: number;
+  windowCount: number;
+  tabCount: number;
+  totalMemoryBytes: number;
+  syncSignedIn: boolean;
+  syncActive: boolean;
+  syncTransportState: string;
+  enabledFeatures: string[];
+  apiKeyConfigured: boolean;
+  oauthClientConfigured: boolean;
+  lockConfigured: boolean;
+  lockUnlocked: boolean;
+  debuggerSession: boolean;
+  crashReportCount: number;
+  latestCrashTimeMs: number;
+}
+
+export interface LumoMonitorBrowserProxy {
+  /**
+   * Asks the browser for the current Lumo Monitor snapshot.
+   */
+  getLumoMonitorInfo(): Promise<LumoMonitorInfo>;
+}
+
+export class LumoMonitorBrowserProxyImpl implements LumoMonitorBrowserProxy {
+  getLumoMonitorInfo() {
+    return sendWithPromise<LumoMonitorInfo>('getLumoMonitorInfo');
+  }
+
+  static getInstance(): LumoMonitorBrowserProxy {
+    return instance || (instance = new LumoMonitorBrowserProxyImpl());
+  }
+
+  static setInstance(obj: LumoMonitorBrowserProxy) {
+    instance = obj;
+  }
+}
+
+let instance: LumoMonitorBrowserProxy|null = null;
