+
+#ifndef CHROME_BROWSER_UI_WEBUI_SETTINGS_LUMO_MONITOR_HANDLER_H_
+#define CHROME_BROWSER_UI_WEBUI_SETTINGS_LUMO_MONITOR_HANDLER_H_
+
+#include <cstdint>
+
+#include "base/files/file_path.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/values.h"
+#include "chrome/browser/ui/webui/settings/settings_page_ui_handler.h"
+
+class Profile;
+
+namespace settings {
+
+// WebUI message handler for the Lumo Monitor settings page
+// (Lumo patch 0022). Serves a single request, "getLumoMonitorInfo",
+// with a snapshot of the browser's state: version, profile, uptime,
+// tab/window counts, total memory usage, Sync state, the enabled
+// Lumo experiments, API key presence, the startup password lock
+// state (patch 0019), the debugger session state (patch 0020), and
+// the recent crash reports. API key and OAuth client VALUES are
+// never included, only whether they are compiled in.
+class LumoMonitorHandler : public SettingsPageUIHandler {
+ public:
+  explicit LumoMonitorHandler(Profile* profile);
+
+  LumoMonitorHandler(const LumoMonitorHandler&) = delete;
+  LumoMonitorHandler& operator=(const LumoMonitorHandler&) = delete;
+
+  ~LumoMonitorHandler() override;
+
+  // SettingsPageUIHandler:
+  void RegisterMessages() override;
+  void OnJavascriptAllowed() override;
+  void OnJavascriptDisallowed() override;
+
+ private:
+  // Result of the Crashpad reports scan, which runs on a blocking
+  // task runner.
+  struct CrashReportSummary {
+    int count = 0;
+    // Milliseconds since the Unix epoch of the newest report, or 0
+    // when there are no reports.
+    double latest_time_ms = 0;
+  };
+
+  // Counts the Crashpad reports under |user_data_dir| (the
+  // Crashpad/reports and Crashpad/pending folders) and finds the
+  // newest one's timestamp. File IO only; called on a blocking
+  // task runner.
+  static CrashReportSummary ScanCrashReports(
+      const base::FilePath& user_data_dir);
+
+  void HandleGetLumoMonitorInfo(const base::ListValue& args);
+  void OnCrashReportSummary(CrashReportSummary summary);
+  void OnMemoryTotal(uint64_t total_bytes);
+  void MaybeResolveCallback();
+
+  const raw_ptr<Profile> profile_;
+
+  // The JavaScript callback waiting for the two asynchronous
+  // pieces (crash scan, memory total). Empty while no request is
+  // in flight.
+  base::Value pending_callback_id_;
+  bool crash_summary_ready_ = false;
+  bool memory_ready_ = false;
+  CrashReportSummary crash_summary_;
+  uint64_t memory_total_bytes_ = 0;
+
+  base::WeakPtrFactory<LumoMonitorHandler> weak_ptr_factory_{this};
+};
+
+}  // namespace settings
+
+#endif  // CHROME_BROWSER_UI_WEBUI_SETTINGS_LUMO_MONITOR_HANDLER_H_
