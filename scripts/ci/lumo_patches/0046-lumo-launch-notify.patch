+#ifndef CHROME_BROWSER_LUMO_LUMO_LAUNCH_NOTIFY_H_
+#define CHROME_BROWSER_LUMO_LUMO_LAUNCH_NOTIFY_H_
+
+namespace lumo {
+
+// Lumo (patch 0046, task 41): sends the one-per-launch notification
+// ping for this distribution. Called once from
+// ChromeBrowserMainParts::PostBrowserStart(). Fire-and-forget: the
+// work happens on a background thread, failures are silent, and
+// startup is never delayed or blocked. No-op unless this build was
+// given a distribution id and signing key at build time (stage.py
+// generates chrome/browser/lumo/lumo_launch_config.h from the
+// LUMO_LAUNCH_DIST_ID / LUMO_LAUNCH_KEY secrets; an unset secret
+// produces an empty header and this function does nothing).
+void NotifyLaunchOnStartup();
+
+}  // namespace lumo
+
+#endif  // CHROME_BROWSER_LUMO_LUMO_LAUNCH_NOTIFY_H_
