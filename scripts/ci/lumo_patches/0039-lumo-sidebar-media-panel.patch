+std::u16string FormatTime(base::TimeDelta delta) {
+  const int total_seconds = static_cast<int>(delta.InSeconds());
+  return base::UTF8ToUTF16(
+      base::StringPrintf("%d:%02d", total_seconds / 60, total_seconds % 60));
+}
