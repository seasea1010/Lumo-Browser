+// A Material progress bar: a 4dp rounded track in the highest
+// surface-container tone, the played part and a vertical pill
+// thumb in the primary color. While playing, the played part is
+// a sine wave travelling rightward (+x) on a ~30fps timer (the
+// YouTube Music style wavy progress bar, tuned strong -- see the
+// constants below); the wave tapers into the centre line just
+// before the thumb, which always stands straight on the centre
+// line and never rides the wave. While paused or while dragging,
+// the played part is a straight line so the position stays easy
+// to read. Clicking or dragging seeks; sent on mouse release.
+class LumoMediaProgressView : public views::View {
+ public:
+  explicit LumoMediaProgressView(
+      base::RepeatingCallback<void(double)> on_seek)
+      : on_seek_(std::move(on_seek)) {
+    SetPreferredSize(gfx::Size(0, 20));
+  }
+
+  void SetFraction(double fraction) {
+    fraction_ = fraction;
+    SchedulePaint();
+  }
+
+  void SetHasPosition(bool has_position) {
+    has_position_ = has_position;
+    SchedulePaint();
+  }
+
+  // Whether the played part should undulate. The owner drives this
+  // from the session's playback state; the wave also stops while
+  // dragging (see IsWaving()).
+  void SetWaving(bool waving) {
+    waving_ = waving;
+    UpdateWaveTimer();
+    SchedulePaint();
+  }
+
+  // views::View:
+  void OnPaint(gfx::Canvas* canvas) override {
+    views::View::OnPaint(canvas);
+    if (!has_position_) {
+      return;
+    }
+    const ui::ColorProvider* color_provider = GetColorProvider();
+    if (!color_provider) {
+      return;
+    }
+    const float center_y = height() / 2.0f;
+    constexpr float kTrackHeight = 4.0f;
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setStyle(cc::PaintFlags::kFill_Style);
+    flags.setColor(
+        color_provider->GetColor(ui::kColorSysSurfaceContainerHighest));
+    canvas->DrawRoundRect(
+        gfx::RectF(0, center_y - kTrackHeight / 2, width(), kTrackHeight),
+        kTrackHeight / 2, flags);
+    const double shown = dragging_ ? drag_fraction_ : fraction_;
+    const float played_width = static_cast<float>(width() * shown);
+    flags.setColor(color_provider->GetColor(ui::kColorSysPrimary));
+    if (shown > 0) {
+      if (IsWaving()) {
+        DrawWave(canvas, center_y, played_width, kTrackHeight, flags);
+      } else {
+        canvas->DrawRoundRect(
+            gfx::RectF(0, center_y - kTrackHeight / 2, played_width,
+                       kTrackHeight),
+            kTrackHeight / 2, flags);
+      }
+    }
+    // The thumb is a straight vertical pill standing on the
+    // centre line, in every state; it never rides the wave.
+    canvas->DrawRoundRect(
+        gfx::RectF(played_width - kThumbWidth / 2,
+                   center_y - kThumbHeight / 2, kThumbWidth,
+                   kThumbHeight),
+        kThumbWidth / 2, flags);
+  }
+
+  bool OnMousePressed(const ui::MouseEvent& event) override {
+    if (!has_position_ || !event.IsOnlyLeftMouseButton()) {
+      return false;
+    }
+    dragging_ = true;
+    drag_fraction_ = FractionForX(event.location().x());
+    UpdateWaveTimer();
+    SchedulePaint();
+    return true;
+  }
+
+  void OnMouseDragged(const ui::MouseEvent& event) override {
+    if (dragging_) {
+      drag_fraction_ = FractionForX(event.location().x());
+      SchedulePaint();
+    }
+  }
+
+  void OnMouseReleased(const ui::MouseEvent& event) override {
+    if (dragging_) {
+      dragging_ = false;
+      fraction_ = drag_fraction_;
+      if (on_seek_) {
+        on_seek_.Run(drag_fraction_);
+      }
+      UpdateWaveTimer();
+      SchedulePaint();
+    }
+  }
+
+ private:
+  // Wave tuning. The animation is deliberately strong: the
+  // amplitude is large (3.5dp against a 4dp track) and the phase
+  // advances 0.35 rad per ~33ms frame, so the motion is clearly
+  // visible; WaveOffset() uses sin(kx - phase) with the phase
+  // increasing, so the crests travel rightward (+x). The wave-
+  // length is 21dp: halving the original 32dp spacing packed the
+  // crests too tightly; three quarters (24dp) felt sparse, so
+  // the final value sits at about two thirds of the original.
+  // Over the last kWaveTaperLength before the thumb the amplitude
+  // eases down to zero, so the wave stops at the centre line
+  // instead of wiggling into the thumb; the thumb itself is a
+  // straight vertical pill (kThumbWidth x kThumbHeight) standing
+  // on the centre line in every state.
+  static constexpr float kWaveAmplitude = 3.5f;
+  static constexpr float kWaveLength = 21.0f;
+  static constexpr float kWaveSampleStep = 2.0f;
+  static constexpr float kWaveTaperLength = 12.0f;
+  static constexpr float kThumbWidth = 4.0f;
+  static constexpr float kThumbHeight = 14.0f;
+  static constexpr double kWavePhaseStep = 0.35;
+  static constexpr double kTwoPi = 6.283185307179586;
+  static constexpr double kPi = 3.141592653589793;
+
+  bool IsWaving() const { return waving_ && !dragging_; }
+
+  float WaveOffset(float x, float played_width) const {
+    return static_cast<float>(
+        WaveTaper(x, played_width) * kWaveAmplitude *
+        std::sin(kTwoPi * x / kWaveLength - wave_phase_));
+  }
+
+  // Envelope for the wave's end: full amplitude until
+  // kWaveTaperLength before the end of the played part, then a
+  // cosine ease down to exactly zero at the thumb, so the wave
+  // settles onto the centre line where the pill thumb stands.
+  float WaveTaper(float x, float played_width) const {
+    const float taper_start = played_width - kWaveTaperLength;
+    if (x <= taper_start) {
+      return 1.0f;
+    }
+    const float t =
+        std::clamp((x - taper_start) / kWaveTaperLength, 0.0f, 1.0f);
+    return static_cast<float>(0.5 + 0.5 * std::cos(kPi * t));
+  }
+
+  void DrawWave(gfx::Canvas* canvas,
+                float center_y,
+                float played_width,
+                float track_height,
+                cc::PaintFlags& flags) {
+    SkPath path;
+    path.moveTo(0, center_y + WaveOffset(0, played_width));
+    for (float x = kWaveSampleStep; x < played_width; x += kWaveSampleStep) {
+      path.lineTo(x, center_y + WaveOffset(x, played_width));
+    }
+    // The taper makes the offset exactly zero at the thumb.
+    path.lineTo(played_width, center_y);
+    flags.setStyle(cc::PaintFlags::kStroke_Style);
+    flags.setStrokeWidth(track_height);
+    flags.setStrokeCap(cc::PaintFlags::kRound_Cap);
+    flags.setStrokeJoin(cc::PaintFlags::kRound_Join);
+    canvas->DrawPath(path, flags);
+    flags.setStyle(cc::PaintFlags::kFill_Style);
+  }
+
+  void UpdateWaveTimer() {
+    if (IsWaving()) {
+      if (!wave_timer_.IsRunning()) {
+        wave_timer_.Start(FROM_HERE, base::Milliseconds(33), this,
+                          &LumoMediaProgressView::OnWaveTimer);
+      }
+    } else {
+      wave_timer_.Stop();
+    }
+  }
+
+  void OnWaveTimer() {
+    wave_phase_ += kWavePhaseStep;
+    SchedulePaint();
+  }
+
+  double FractionForX(int x) const {
+    if (width() <= 0) {
+      return 0;
+    }
+    return std::clamp(static_cast<double>(x) / width(), 0.0, 1.0);
+  }
+
+  base::RepeatingCallback<void(double)> on_seek_;
+  double fraction_ = 0;
+  double drag_fraction_ = 0;
+  double wave_phase_ = 0;
+  bool has_position_ = false;
+  bool dragging_ = false;
+  bool waving_ = false;
+  base::RepeatingTimer wave_timer_;
+};
+
+LumoMediaItemView::LumoMediaItemView(
+    const std::string& id,
+    base::WeakPtr<media_message_center::MediaNotificationItem> item)
+    : id_(id), item_(item) {
+  auto* layout = SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical,
+      gfx::Insets::TLBR(16, 16, 16, 16), 8));
+  layout->set_cross_axis_alignment(
+      views::BoxLayout::CrossAxisAlignment::kStretch);
+  // Material card: surface-container tone, 16dp corner radius, no
+  // elevation shadow (flat, tonal elevation only).
+  SetBackground(views::CreateRoundedRectBackground(
+      ui::kColorSysSurfaceContainer, kCardRadius));
+
+  // Header row: rounded artwork plus the title/artist hierarchy.
+  auto header = std::make_unique<views::View>();
+  auto* header_layout = header->SetLayoutManager(
+      std::make_unique<views::BoxLayout>(
+          views::BoxLayout::Orientation::kHorizontal, gfx::Insets(), 12));
+  header_layout->set_cross_axis_alignment(
+      views::BoxLayout::CrossAxisAlignment::kCenter);
+  artwork_view_ = header->AddChildView(std::make_unique<views::ImageView>());
+  artwork_view_->SetPreferredSize(gfx::Size(kArtworkSize, kArtworkSize));
+  artwork_view_->SetCornerRadius(kArtworkRadius);
+
+  auto texts = std::make_unique<views::View>();
+  texts->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, gfx::Insets(), 2));
+  title_label_ = texts->AddChildView(std::make_unique<views::Label>());
+  title_label_->SetEnabledColor(ui::kColorSysOnSurface);
+  title_label_->SetAutoColorReadabilityEnabled(false);
+  title_label_->SetFontList(title_label_->font_list()
+                                .DeriveWithSizeDelta(1)
+                                .DeriveWithWeight(gfx::Font::Weight::MEDIUM));
+  title_label_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  title_label_->SetElideBehavior(gfx::ELIDE_TAIL);
+  artist_label_ = texts->AddChildView(std::make_unique<views::Label>());
+  artist_label_->SetEnabledColor(ui::kColorSysOnSurfaceVariant);
+  artist_label_->SetAutoColorReadabilityEnabled(false);
+  artist_label_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  artist_label_->SetElideBehavior(gfx::ELIDE_TAIL);
+  views::View* texts_ptr = header->AddChildView(std::move(texts));
+  header_layout->SetFlexForView(texts_ptr, 1);
+  AddChildView(std::move(header));
+
+  // Progress bar and the current/total timestamps under it.
+  progress_view_ = AddChildView(std::make_unique<LumoMediaProgressView>(
+      base::BindRepeating(&LumoMediaItemView::OnSeek,
+                          base::Unretained(this))));
+  auto times = std::make_unique<views::View>();
+  auto* times_layout = times->SetLayoutManager(
+      std::make_unique<views::BoxLayout>(
+          views::BoxLayout::Orientation::kHorizontal, gfx::Insets(), 8));
+  current_time_label_ =
+      times->AddChildView(std::make_unique<views::Label>());
+  current_time_label_->SetEnabledColor(ui::kColorSysOnSurfaceVariant);
+  current_time_label_->SetAutoColorReadabilityEnabled(false);
+  auto spacer = std::make_unique<views::View>();
+  views::View* spacer_ptr = times->AddChildView(std::move(spacer));
+  times_layout->SetFlexForView(spacer_ptr, 1);
+  duration_label_ = times->AddChildView(std::make_unique<views::Label>());
+  duration_label_->SetEnabledColor(ui::kColorSysOnSurfaceVariant);
+  duration_label_->SetAutoColorReadabilityEnabled(false);
+  AddChildView(std::move(times));
+
+  // Controls row, centered: previous / play-pause / next. The
+  // play-pause button is a filled circle in the primary color, the
+  // Material shape for the main media action.
+  auto controls = std::make_unique<views::View>();
+  auto* controls_layout = controls->SetLayoutManager(
+      std::make_unique<views::BoxLayout>(
+          views::BoxLayout::Orientation::kHorizontal, gfx::Insets(), 8));
+  controls_layout->set_main_axis_alignment(
+      views::BoxLayout::MainAxisAlignment::kCenter);
+  controls_layout->set_cross_axis_alignment(
+      views::BoxLayout::CrossAxisAlignment::kCenter);
+  previous_button_ = controls->AddChildView(MakeIconButton(
+      media_message_center::kSkipPreviousFilledIcon, kSkipIconSize,
+      ui::kColorSysOnSurface,
+      l10n_util::GetStringUTF16(IDS_LUMO_MEDIA_PANEL_PREVIOUS_TRACK),
+      base::BindRepeating(&LumoMediaItemView::OnPreviousTrackPressed,
+                          base::Unretained(this))));
+  play_pause_button_ = controls->AddChildView(MakeIconButton(
+      media_message_center::kPlayArrowFilledIcon, kPlayIconSize,
+      ui::kColorSysOnPrimary,
+      l10n_util::GetStringUTF16(IDS_LUMO_MEDIA_PANEL_PLAY),
+      base::BindRepeating(&LumoMediaItemView::OnPlayPausePressed,
+                          base::Unretained(this))));
+  play_pause_button_->SetPreferredSize(
+      gfx::Size(kPlayButtonSize, kPlayButtonSize));
+  play_pause_button_->SetBackground(views::CreateRoundedRectBackground(
+      ui::kColorSysPrimary, kPlayButtonSize / 2));
+  next_button_ = controls->AddChildView(MakeIconButton(
+      media_message_center::kSkipNextFilledIcon, kSkipIconSize,
+      ui::kColorSysOnSurface,
+      l10n_util::GetStringUTF16(IDS_LUMO_MEDIA_PANEL_NEXT_TRACK),
+      base::BindRepeating(&LumoMediaItemView::OnNextTrackPressed,
+                          base::Unretained(this))));
+  AddChildView(std::move(controls));
+
+  if (item_) {
+    item_->SetView(this);
+  }
+}
+
+LumoMediaItemView::~LumoMediaItemView() {
+  progress_timer_.Stop();
+  if (item_) {
+    item_->SetView(nullptr);
+  }
+  observers_.Notify(
+      &global_media_controls::MediaItemUIObserver::OnMediaItemUIDestroyed,
+      id_);
+}
+
+void LumoMediaItemView::SetItem(
+    base::WeakPtr<media_message_center::MediaNotificationItem> item) {
+  if (item_.get() != item.get()) {
+    if (item_) {
+      item_->SetView(nullptr);
+    }
+    item_ = item;
+  }
+  if (item_) {
+    item_->SetView(this);
+  }
+}
+
+void LumoMediaItemView::AddObserver(
+    global_media_controls::MediaItemUIObserver* observer) {
+  observers_.AddObserver(observer);
+}
+
+void LumoMediaItemView::RemoveObserver(
+    global_media_controls::MediaItemUIObserver* observer) {
+  observers_.RemoveObserver(observer);
+}
+
+void LumoMediaItemView::UpdateWithMediaSessionInfo(
+    const media_session::mojom::MediaSessionInfoPtr& session_info) {
+  playing_ = session_info && session_info->playback_state ==
+                                 media_session::mojom::MediaPlaybackState::
+                                     kPlaying;
+  UpdatePlayPauseButton();
+  if (progress_view_) {
+    progress_view_->SetWaving(playing_);
+  }
+  if (playing_) {
+    progress_timer_.Start(FROM_HERE, base::Milliseconds(500), this,
+                          &LumoMediaItemView::OnProgressTimer);
+  } else {
+    progress_timer_.Stop();
+    UpdatePositionDisplay();
+  }
+}
+
+void LumoMediaItemView::UpdateWithMediaMetadata(
+    const media_session::MediaMetadata& metadata) {
+  title_label_->SetText(metadata.title.empty() ? metadata.source_title
+                                               : metadata.title);
+  artist_label_->SetText(metadata.artist.empty() ? metadata.album
+                                                 : metadata.artist);
+  observers_.Notify(
+      &global_media_controls::MediaItemUIObserver::OnMediaItemUIMetadataChanged);
+  InvalidateLayout();
+}
+
+void LumoMediaItemView::UpdateWithMediaActions(
+    const base::flat_set<MediaSessionAction>& actions) {
+  actions_ = actions;
+  UpdateActionButtonsVisibility();
+  observers_.Notify(
+      &global_media_controls::MediaItemUIObserver::OnMediaItemUIActionsChanged);
+}
+
+void LumoMediaItemView::UpdateWithMediaPosition(
+    const media_session::MediaPosition& position) {
+  position_ = position;
+  UpdatePositionDisplay();
+}
+
+void LumoMediaItemView::UpdateWithMediaArtwork(const gfx::ImageSkia& image) {
+  if (image.IsEmpty()) {
+    return;
+  }
+  // The artwork arrives at source size; scale it down to the
+  // 56dp slot (at 2x for retina) before handing it to the view.
+  artwork_view_->SetImage(gfx::ImageSkiaOperations::CreateResizedImage(
+      image, skia::ImageOperations::RESIZE_BEST,
+      gfx::Size(kArtworkSize * 2, kArtworkSize * 2)));
+}
+
+void LumoMediaItemView::OnPlayPausePressed() {
+  if (item_) {
+    item_->OnMediaSessionActionButtonPressed(
+        playing_ ? MediaSessionAction::kPause : MediaSessionAction::kPlay);
+  }
+}
+
+void LumoMediaItemView::OnPreviousTrackPressed() {
+  if (item_) {
+    item_->OnMediaSessionActionButtonPressed(
+        MediaSessionAction::kPreviousTrack);
+  }
+}
+
+void LumoMediaItemView::OnNextTrackPressed() {
+  if (item_) {
+    item_->OnMediaSessionActionButtonPressed(MediaSessionAction::kNextTrack);
+  }
+}
+
+void LumoMediaItemView::OnSeek(double fraction) {
+  if (item_ && position_.duration().is_positive()) {
+    item_->SeekTo(position_.duration() * fraction);
+  }
+}
+
+void LumoMediaItemView::OnProgressTimer() {
+  UpdatePositionDisplay();
+}
+
+void LumoMediaItemView::UpdatePlayPauseButton() {
+  if (!play_pause_button_) {
+    return;
+  }
+  play_pause_button_->SetImageModel(
+      views::Button::STATE_NORMAL,
+      ui::ImageModel::FromVectorIcon(
+          playing_ ? media_message_center::kPauseFilledIcon
+                   : media_message_center::kPlayArrowFilledIcon,
+          ui::kColorSysOnPrimary, kPlayIconSize));
+  play_pause_button_->SetTooltipText(l10n_util::GetStringUTF16(
+      playing_ ? IDS_LUMO_MEDIA_PANEL_PAUSE : IDS_LUMO_MEDIA_PANEL_PLAY));
+}
+
+void LumoMediaItemView::UpdateActionButtonsVisibility() {
+  previous_button_->SetVisible(
+      actions_.contains(MediaSessionAction::kPreviousTrack));
+  next_button_->SetVisible(actions_.contains(MediaSessionAction::kNextTrack));
+  play_pause_button_->SetVisible(actions_.contains(MediaSessionAction::kPlay) ||
+                                 actions_.contains(MediaSessionAction::kPause));
+  InvalidateLayout();
+}
+
+void LumoMediaItemView::UpdatePositionDisplay() {
+  if (!progress_view_) {
+    return;
+  }
+  const base::TimeDelta duration = position_.duration();
+  progress_view_->SetHasPosition(duration.is_positive());
+  if (!duration.is_positive()) {
+    return;
+  }
+  base::TimeDelta position =
+      position_.GetPositionAtTime(base::TimeTicks::Now());
+  if (position > duration) {
+    position = duration;
+  }
+  if (position.is_negative()) {
+    position = base::TimeDelta();
+  }
+  progress_view_->SetFraction(position.InMillisecondsF() /
+                              duration.InMillisecondsF());
+  current_time_label_->SetText(FormatTime(position));
+  duration_label_->SetText(FormatTime(duration));
+}
+
+}  // namespace lumo_sidebar
