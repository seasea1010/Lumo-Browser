+
+namespace lumo_sidebar {
+
+LumoMediaPanelView::LumoMediaPanelView(Profile* profile) : profile_(profile) {
+  auto* layout = SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical,
+      gfx::Insets::TLBR(12, 12, 12, 12), 12));
+  layout->set_cross_axis_alignment(
+      views::BoxLayout::CrossAxisAlignment::kStretch);
+
+  empty_label_ = AddChildView(std::make_unique<views::Label>(
+      l10n_util::GetStringUTF16(IDS_LUMO_MEDIA_PANEL_EMPTY)));
+  empty_label_->SetEnabledColor(ui::kColorSysOnSurfaceVariant);
+  empty_label_->SetAutoColorReadabilityEnabled(false);
+  empty_label_->SetHorizontalAlignment(gfx::ALIGN_CENTER);
+
+  items_container_ = AddChildView(std::make_unique<views::View>());
+  items_container_->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, gfx::Insets(), 12));
+
+  // Become the dialog delegate of the profile's media item manager.
+  // The manager immediately hands over every active item through
+  // ShowMediaItem(), and keeps doing so while the panel exists.
+  if (MediaNotificationService* service =
+          MediaNotificationServiceFactory::GetForProfile(profile_)) {
+    item_manager_ = service->media_item_manager();
+  }
+  if (item_manager_) {
+    is_dialog_delegate_ = true;
+    item_manager_->SetDialogDelegate(this);
+  }
+}
+
+LumoMediaPanelView::~LumoMediaPanelView() {
+  if (item_manager_ && is_dialog_delegate_) {
+    item_manager_->SetDialogDelegate(nullptr);
+  }
+}
+
+global_media_controls::MediaItemUI* LumoMediaPanelView::ShowMediaItem(
+    const std::string& id,
+    base::WeakPtr<media_message_center::MediaNotificationItem> item) {
+  auto it = items_.find(id);
+  if (it != items_.end()) {
+    return it->second;
+  }
+  auto card = std::make_unique<LumoMediaItemView>(id, item);
+  LumoMediaItemView* card_ptr = card.get();
+  items_container_->AddChildView(std::move(card));
+  items_[id] = card_ptr;
+  UpdateEmptyState();
+  return card_ptr;
+}
+
+void LumoMediaPanelView::HideMediaItem(const std::string& id) {
+  auto it = items_.find(id);
+  if (it == items_.end()) {
+    return;
+  }
+  LumoMediaItemView* card = it->second;
+  items_.erase(it);
+  // Deleting a views::View removes it from its parent automatically.
+  delete card;
+  UpdateEmptyState();
+}
+
+void LumoMediaPanelView::RefreshMediaItem(
+    const std::string& id,
+    base::WeakPtr<media_message_center::MediaNotificationItem> item) {
+  auto it = items_.find(id);
+  if (it == items_.end()) {
+    ShowMediaItem(id, item);
+    return;
+  }
+  it->second->SetItem(item);
+}
+
+void LumoMediaPanelView::HideMediaDialog() {
+  // Another delegate (e.g. the toolbar media dialog) took over. The
+  // side panel framework destroys this view on its own schedule; just
+  // remember not to clear the manager's delegate in the destructor.
+  is_dialog_delegate_ = false;
+}
+
+void LumoMediaPanelView::Focus() {
+  RequestFocus();
+}
+
+void LumoMediaPanelView::UpdateEmptyState() {
+  empty_label_->SetVisible(items_.empty());
+}
+
+}  // namespace lumo_sidebar
