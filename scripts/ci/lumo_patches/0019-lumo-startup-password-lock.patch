+bool RunStartupPasswordLock(const base::FilePath& user_data_dir) {
+  if (kLumoLockSaltHex.empty() || kLumoLockHashHex.empty()) {
+    return true;  // The lock is not configured for this build.
+  }
+  std::vector<LumoLockEntry> entries;
+  LumoLockEntry primary;
+  if (!ParseLumoLockEntry(kLumoLockSaltHex, kLumoLockHashHex,
+                          &primary)) {
+    // stage.py validates the injected value before writing the
+    // header, so this can only be a hand-corrupted header. Do not
+    // brick the browser over it; the lock stays off and this is
+    // logged.
+    LOG(ERROR) << "Lumo startup lock: malformed injected hash; "
+                  "lock disabled.";
+    return true;
+  }
+  entries.push_back(std::move(primary));
+  // The optional second password (LUMO_LOCK_HASH_2): either
+  // password unlocks. A malformed second entry is ignored rather
+  // than disabling the lock the first password provides.
+  if (!kLumoLockSaltHex2.empty() || !kLumoLockHashHex2.empty()) {
+    LumoLockEntry secondary;
+    if (ParseLumoLockEntry(kLumoLockSaltHex2, kLumoLockHashHex2,
+                           &secondary)) {
+      entries.push_back(std::move(secondary));
+    } else {
+      LOG(ERROR) << "Lumo startup lock: malformed second injected "
+                    "hash; second password ignored.";
+    }
+  }
+
+  const base::FilePath token_path =
+      user_data_dir.Append(kLumoUnlockTokenFileName);
+  std::string stored_token;
+  if (base::ReadFileToString(token_path, &stored_token)) {
+    for (const LumoLockEntry& entry : entries) {
+      if (stored_token ==
+          LumoUnlockToken(entry.salt, entry.expected_hash)) {
+        return true;  // Already unlocked on a previous launch.
+      }
+    }
+  }
+
+  LumoLockDialogState state;
+  state.entries = entries;
+  if (!ShowLumoLockDialog(&state)) {
+    return false;
+  }
+
+  // Best effort: remember the unlock for the next launch. The
+  // token is derived from the entry that actually matched, so
+  // unlocking with either password persists. If the write fails
+  // the password is simply asked again next time.
+  const LumoLockEntry& matched =
+      entries[static_cast<size_t>(state.matched_entry)];
+  base::CreateDirectory(user_data_dir);
+  if (!base::WriteFile(
+          token_path,
+          LumoUnlockToken(matched.salt, matched.expected_hash))) {
+    LOG(WARNING) << "Lumo startup lock: could not persist the "
+                    "unlock token.";
+  }
+  return true;
+}
