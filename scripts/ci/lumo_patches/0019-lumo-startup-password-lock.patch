+// ------------------------------------------------------------------
+// Lumo (patch 0019): first-run startup password lock helpers.
+//
+// stage.py writes the salt and the expected hash (SHA-256 over the
+// salt bytes followed by the password's UTF-8 bytes) into the
+// generated header included above. Only the salt and the hash are
+// compiled into the binary; the password itself never is. A
+// second, optional password (the LUMO_LOCK_HASH_2 secret) is
+// configured the same way in lumo_lock_config_2.h; either
+// password unlocks.
+// ------------------------------------------------------------------
+
+#if defined(LUMO_STARTUP_LOCK_CONFIGURED)
+constexpr std::string_view kLumoLockSaltHex = lumo::kLockSaltHex;
+constexpr std::string_view kLumoLockHashHex = lumo::kLockHashHex;
+#else
+constexpr std::string_view kLumoLockSaltHex;
+constexpr std::string_view kLumoLockHashHex;
+#endif
+
+#if defined(LUMO_STARTUP_LOCK_CONFIGURED_2)
+constexpr std::string_view kLumoLockSaltHex2 = lumo::kLockSaltHex2;
+constexpr std::string_view kLumoLockHashHex2 = lumo::kLockHashHex2;
+#else
+constexpr std::string_view kLumoLockSaltHex2;
+constexpr std::string_view kLumoLockHashHex2;
+#endif
+
+constexpr wchar_t kLumoUnlockTokenFileName[] = L"lumo-unlock-token";
+constexpr int kLumoLockMaxAttempts = 3;
+constexpr int kLumoLockPasswordEditId = 101;
+constexpr int kLumoLockErrorTextId = 102;
+
+bool LumoPasswordMatches(const std::string& password_utf8,
+                         base::span<const uint8_t> salt,
+                         base::span<const uint8_t> expected_hash) {
+  std::vector<uint8_t> input;
+  input.reserve(salt.size() + password_utf8.size());
+  input.insert(input.end(), salt.begin(), salt.end());
+  input.insert(input.end(), password_utf8.begin(), password_utf8.end());
+  const std::array<uint8_t, crypto::kSHA256Length> digest =
+      crypto::SHA256Hash(input);
+  return expected_hash.size() == digest.size() &&
+         std::equal(digest.begin(), digest.end(), expected_hash.begin());
+}
+
+// One configured password: the salt and the expected hash from
+// one of the generated lock config headers.
+struct LumoLockEntry {
+  std::vector<uint8_t> salt;
+  std::vector<uint8_t> expected_hash;
+};
+
+// Parses one configured (salt, hash) hex pair into `entry`.
+// Returns false when either half is empty or malformed.
+bool ParseLumoLockEntry(std::string_view salt_hex,
+                        std::string_view hash_hex,
+                        LumoLockEntry* entry) {
+  return !salt_hex.empty() && !hash_hex.empty() &&
+         base::HexStringToBytes(salt_hex, &entry->salt) &&
+         base::HexStringToBytes(hash_hex, &entry->expected_hash) &&
+         entry->salt.size() == 16 &&
+         entry->expected_hash.size() == crypto::kSHA256Length;
+}
+
+// The token persisted in the user data directory after a successful
+// unlock. Deriving it from the configured salt and hash means a
+// marker copied from a build with a different password, or an empty
+// file created by hand, does not unlock this build, and changing
+// the password invalidates markers written by older builds.
+std::string LumoUnlockToken(base::span<const uint8_t> salt,
+                            base::span<const uint8_t> hash) {
+  std::vector<uint8_t> material;
+  material.reserve(salt.size() + hash.size() + 16);
+  material.insert(material.end(), salt.begin(), salt.end());
+  material.insert(material.end(), hash.begin(), hash.end());
+  constexpr char kSuffix[] = "lumo-unlock-v1";
+  material.insert(material.end(), std::begin(kSuffix),
+                  std::end(kSuffix) - 1);
+  const std::array<uint8_t, crypto::kSHA256Length> digest =
+      crypto::SHA256Hash(material);
+  return base::HexEncode(digest);
+}
+
+// Minimal in-memory dialog template builder. The lock dialog is
+// described with a DLGTEMPLATE in memory (no .rc resources), so it
+// can be shown before the Views toolkit and the localized string
+// resources exist.
+class LumoDialogTemplate {
+ public:
+  void Begin(DWORD style,
+             DWORD ex_style,
+             int16_t cx,
+             int16_t cy,
+             std::wstring_view title,
+             uint16_t font_size,
+             std::wstring_view font_name) {
+    PushDword(style);
+    PushDword(ex_style);
+    cdit_offset_ = buffer_.size();
+    PushWord(0);  // cdit; patched by AddControl().
+    PushWord(0);  // x
+    PushWord(0);  // y
+    PushWord(static_cast<uint16_t>(cx));
+    PushWord(static_cast<uint16_t>(cy));
+    PushWord(0);  // menu: none.
+    PushWord(0);  // window class: default dialog class.
+    PushText(title);
+    if (style & DS_SETFONT) {
+      PushWord(font_size);
+      PushText(font_name);
+    }
+  }
+
+  void AddControl(DWORD style,
+                  DWORD ex_style,
+                  int16_t x,
+                  int16_t y,
+                  int16_t cx,
+                  int16_t cy,
+                  uint16_t id,
+                  uint16_t atom_class,
+                  std::wstring_view text) {
+    AlignDword();
+    PushDword(style);
+    PushDword(ex_style);
+    PushWord(static_cast<uint16_t>(x));
+    PushWord(static_cast<uint16_t>(y));
+    PushWord(static_cast<uint16_t>(cx));
+    PushWord(static_cast<uint16_t>(cy));
+    PushWord(id);
+    PushWord(0xFFFF);
+    PushWord(atom_class);
+    PushText(text);
+    PushWord(0);  // No creation data.
+    const uint16_t count = static_cast<uint16_t>(
+        buffer_[cdit_offset_] | (buffer_[cdit_offset_ + 1] << 8)) +
+        1;
+    buffer_[cdit_offset_] = static_cast<uint8_t>(count & 0xFF);
+    buffer_[cdit_offset_ + 1] = static_cast<uint8_t>(count >> 8);
+  }
+
+  const DLGTEMPLATE* get() const {
+    return reinterpret_cast<const DLGTEMPLATE*>(buffer_.data());
+  }
+
+ private:
+  void AlignDword() {
+    while (buffer_.size() % sizeof(DWORD)) {
+      buffer_.push_back(0);
+    }
+  }
+  void PushWord(uint16_t value) {
+    buffer_.push_back(static_cast<uint8_t>(value & 0xFF));
+    buffer_.push_back(static_cast<uint8_t>(value >> 8));
+  }
+  void PushDword(uint32_t value) {
+    PushWord(static_cast<uint16_t>(value & 0xFFFF));
+    PushWord(static_cast<uint16_t>(value >> 16));
+  }
+  void PushText(std::wstring_view text) {
+    for (const wchar_t c : text) {
+      PushWord(static_cast<uint16_t>(c));
+    }
+    PushWord(0);
+  }
+
+  std::vector<uint8_t> buffer_;
+  size_t cdit_offset_ = 0;
+};
+
+struct LumoLockDialogState {
+  std::vector<LumoLockEntry> entries;
+  int matched_entry = -1;
+  int attempts_left = kLumoLockMaxAttempts;
+  bool unlocked = false;
+};
+
+INT_PTR CALLBACK LumoLockDialogProc(HWND dialog,
+                                    UINT message,
+                                    WPARAM wparam,
+                                    LPARAM lparam) {
+  auto* state = reinterpret_cast<LumoLockDialogState*>(
+      GetWindowLongPtr(dialog, GWLP_USERDATA));
+  switch (message) {
+    case WM_INITDIALOG: {
+      state = reinterpret_cast<LumoLockDialogState*>(lparam);
+      SetWindowLongPtr(dialog, GWLP_USERDATA,
+                       reinterpret_cast<LONG_PTR>(state));
+      SetFocus(GetDlgItem(dialog, kLumoLockPasswordEditId));
+      return FALSE;  // Focus was set explicitly.
+    }
+    case WM_COMMAND: {
+      if (!state) {
+        return FALSE;
+      }
+      switch (LOWORD(wparam)) {
+        case IDOK: {
+          HWND edit = GetDlgItem(dialog, kLumoLockPasswordEditId);
+          const int length = GetWindowTextLength(edit);
+          std::wstring password(static_cast<size_t>(length) + 1, L'\0');
+          GetWindowText(edit, password.data(), length + 1);
+          password.resize(static_cast<size_t>(length));
+          const std::string password_utf8 =
+              base::WideToUTF8(password);
+          int matched_entry = -1;
+          for (size_t i = 0; i < state->entries.size(); ++i) {
+            if (LumoPasswordMatches(password_utf8,
+                                    state->entries[i].salt,
+                                    state->entries[i].expected_hash)) {
+              matched_entry = static_cast<int>(i);
+              break;
+            }
+          }
+          if (matched_entry >= 0) {
+            state->matched_entry = matched_entry;
+            state->unlocked = true;
+            EndDialog(dialog, IDOK);
+          } else if (--state->attempts_left <= 0) {
+            EndDialog(dialog, IDCANCEL);
+          } else {
+            const std::wstring error =
+                L"パスワードが違います（残り " +
+                std::to_wstring(state->attempts_left) + L" 回）";
+            SetDlgItemText(dialog, kLumoLockErrorTextId, error.c_str());
+            SetWindowText(edit, L"");
+            SetFocus(edit);
+          }
+          return TRUE;
+        }
+        case IDCANCEL:
+          EndDialog(dialog, IDCANCEL);
+          return TRUE;
+        default:
+          return FALSE;
+      }
+    }
+    case WM_CLOSE:
+      EndDialog(dialog, IDCANCEL);
+      return TRUE;
+    case WM_CTLCOLORSTATIC: {
+      if (GetDlgCtrlID(reinterpret_cast<HWND>(lparam)) ==
+          kLumoLockErrorTextId) {
+        HDC dc = reinterpret_cast<HDC>(wparam);
+        SetTextColor(dc, RGB(0xC0, 0x00, 0x00));
+        SetBkMode(dc, TRANSPARENT);
+        return reinterpret_cast<INT_PTR>(GetSysColorBrush(COLOR_BTNFACE));
+      }
+      return FALSE;
+    }
+    default:
+      return FALSE;
+  }
+}
+
+bool ShowLumoLockDialog(LumoLockDialogState* state) {
+  LumoDialogTemplate tmpl;
+  tmpl.Begin(WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU |
+                 DS_SETFONT | DS_CENTER | DS_MODALFRAME,
+             WS_EX_DLGMODALFRAME, 196, 92, L"Lumo", 9, L"Segoe UI");
+  tmpl.AddControl(WS_CHILD | WS_VISIBLE, 0, 12, 10, 172, 10, 0xFFFF,
+                  0x0082, L"Lumo はパスワードでロックされています");
+  tmpl.AddControl(WS_CHILD | WS_VISIBLE, 0, 12, 22, 172, 10, 0xFFFF,
+                  0x0082, L"続けるにはパスワードを入力してください。");
+  tmpl.AddControl(WS_CHILD | WS_VISIBLE | WS_TABSTOP | ES_PASSWORD |
+                      ES_AUTOHSCROLL,
+                  WS_EX_CLIENTEDGE, 12, 36, 172, 12,
+                  kLumoLockPasswordEditId, 0x0081, L"");
+  tmpl.AddControl(WS_CHILD | WS_VISIBLE, 0, 12, 52, 172, 10,
+                  kLumoLockErrorTextId, 0x0082, L"");
+  tmpl.AddControl(WS_CHILD | WS_VISIBLE | WS_TABSTOP | BS_DEFPUSHBUTTON,
+                  0, 78, 70, 50, 14, IDOK, 0x0080, L"OK");
+  tmpl.AddControl(WS_CHILD | WS_VISIBLE | WS_TABSTOP | BS_PUSHBUTTON, 0,
+                  134, 70, 50, 14, IDCANCEL, 0x0080, L"キャンセル");
+  const INT_PTR result = DialogBoxIndirectParam(
+      ::GetModuleHandleW(nullptr), tmpl.get(), nullptr,
+      &LumoLockDialogProc, reinterpret_cast<LPARAM>(state));
+  return result == IDOK && state->unlocked;
+}
+
