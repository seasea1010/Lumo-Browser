+// Lumo (patch 0017): notification id and notifier id for the
+// full-page screenshot result notifications.
+constexpr char kLumoScreenshotNotificationId[] =
+    "lumo_full_page_screenshot";
+constexpr char kLumoScreenshotNotifierId[] = "lumo_full_page_screenshot";
+
+// Lumo (patch 0017): delegate for the "screenshot saved"
+// notification. Clicking the notification body opens the saved
+// PNG with the desktop's default handler. The profile is held
+// as a raw pointer, like other one-shot notification delegates
+// in the browser (for example ExtensionRequestNotification):
+// the notification is torn down together with the profile's
+// notification display service, so a click can only arrive
+// while the profile is alive.
+class LumoScreenshotNotificationDelegate
+    : public message_center::NotificationDelegate {
+ public:
+  LumoScreenshotNotificationDelegate(Profile* profile,
+                                     base::FilePath file_path)
+      : profile_(profile), file_path_(std::move(file_path)) {}
+
+  // message_center::NotificationDelegate:
+  void Click(const std::optional<int>& button_index,
+             const std::optional<std::u16string>& reply) override {
+    if (button_index) {
+      return;  // The notification has no action buttons.
+    }
+    platform_util::OpenItem(profile_, file_path_,
+                            platform_util::OPEN_FILE,
+                            platform_util::OpenOperationCallback());
+  }
+
+ private:
+  ~LumoScreenshotNotificationDelegate() override = default;
+
+  Profile* const profile_;
+  const base::FilePath file_path_;
+};
+
+// Lumo (patch 0017): shows the result of a full-page screenshot
+// capture as a transient notification. On success the body names
+// the saved file and a click opens it; on failure the body says
+// the file could not be written to the downloads folder.
+void ShowLumoScreenshotNotification(Profile* profile,
+                                    const base::FilePath& file_path,
+                                    bool saved) {
+  if (!profile) {
+    return;
+  }
+  NotificationDisplayService* display_service =
+      NotificationDisplayServiceFactory::GetForProfile(profile);
+  if (!display_service) {
+    return;
+  }
+  std::u16string title;
+  std::u16string body;
+  scoped_refptr<message_center::NotificationDelegate> delegate;
+  if (saved) {
+    title = l10n_util::GetStringUTF16(IDS_LUMO_SCREENSHOT_SAVED_TITLE);
+    body = l10n_util::GetStringFUTF16(IDS_LUMO_SCREENSHOT_SAVED_MESSAGE,
+                                      file_path.AsUTF16Unsafe());
+    delegate = base::MakeRefCounted<LumoScreenshotNotificationDelegate>(
+        profile, file_path);
+  } else {
+    title = l10n_util::GetStringUTF16(IDS_LUMO_SCREENSHOT_FAILED_TITLE);
+    body = l10n_util::GetStringUTF16(IDS_LUMO_SCREENSHOT_FAILED_MESSAGE);
+  }
+  message_center::Notification notification(
+      message_center::NOTIFICATION_TYPE_SIMPLE,
+      kLumoScreenshotNotificationId, title, body,
+      ui::ImageModel::FromVectorIcon(vector_icons::kPhotoIcon,
+                                     ui::kColorIcon,
+                                     message_center::kSmallImageSize),
+      /*display_source=*/std::u16string(), GURL(),
+      message_center::NotifierId(message_center::NotifierType::APPLICATION,
+                                 kLumoScreenshotNotifierId),
+      message_center::RichNotificationData(), delegate);
+  display_service->Display(NotificationHandler::Type::TRANSIENT,
+                           notification, /*metadata=*/nullptr);
+}
+
+// Lumo (patch 0017): one-shot DevTools protocol client that
+// captures a full-page screenshot of a tab through
+// Page.captureScreenshot with captureBeyondViewport, then writes
+// the PNG into the profile's downloads folder and reports the
+// result with a notification (see ShowLumoScreenshotNotification
+// above). The client owns itself: it attaches, drives the two
+// protocol calls, and deletes itself when the capture finishes,
+// fails, or the agent host goes away.
+class LumoFullPageScreenshotClient
+    : public content::DevToolsAgentHostClient {
+ public:
+  LumoFullPageScreenshotClient(
+      scoped_refptr<content::DevToolsAgentHost> host,
+      Profile* profile,
+      base::FilePath download_dir)
+      : host_(std::move(host)),
+        profile_(profile),
+        download_dir_(std::move(download_dir)) {}
+  ~LumoFullPageScreenshotClient() override = default;
+
+  // Attaches and starts the capture. Takes ownership of `this`
+  // in all cases: if attaching fails (for example because
+  // DevTools is already attached to the tab), deletes itself
+  // and returns false.
+  bool Start() {
+    if (!host_->AttachClient(this)) {
+      ShowResultNotification(false);
+      delete this;
+      return false;
+    }
+    SendCommand(1, "Page.enable", base::DictValue());
+    return true;
+  }
+
+  // content::DevToolsAgentHostClient:
+  void DispatchProtocolMessage(
+      content::DevToolsAgentHost* agent_host,
+      base::span<const uint8_t> message) override {
+    std::optional<base::Value> parsed = base::JSONReader::Read(
+        std::string_view(reinterpret_cast<const char*>(message.data()),
+                         message.size()),
+        base::JSON_PARSE_RFC);
+    if (!parsed || !parsed->is_dict()) {
+      return;
+    }
+    const base::DictValue& dict = parsed->GetDict();
+    const int id = dict.FindInt("id").value_or(0);
+    if (id == 1) {
+      base::DictValue params;
+      params.Set("format", "png");
+      params.Set("captureBeyondViewport", true);
+      params.Set("fromSurface", true);
+      SendCommand(2, "Page.captureScreenshot", std::move(params));
+      return;
+    }
+    if (id == 2) {
+      const base::DictValue* result = dict.FindDict("result");
+      const std::string* data =
+          result ? result->FindString("data") : nullptr;
+      if (data) {
+        // SavePng finishes the client once the write completes
+        // (or right away if the data cannot be decoded).
+        SavePng(*data);
+      } else {
+        ShowResultNotification(false);
+        Finish();
+      }
+    }
+  }
+
+  void AgentHostClosed(content::DevToolsAgentHost* agent_host) override {
+    // The host is gone, so there is nothing to detach from;
+    // just clean up. A write that is still in flight has its
+    // reply dropped through the weak pointer below.
+    host_ = nullptr;
+    delete this;
+  }
+
+ private:
+  void SendCommand(int id, const char* method, base::DictValue params) {
+    base::DictValue command;
+    command.Set("id", id);
+    command.Set("method", method);
+    command.Set("params", std::move(params));
+    std::string json;
+    base::JSONWriter::Write(command, &json);
+    host_->DispatchProtocolMessage(
+        this, std::vector<uint8_t>(json.begin(), json.end()));
+  }
+
+  void SavePng(const std::string& base64_data) {
+    std::optional<std::vector<uint8_t>> png =
+        base::Base64Decode(base64_data);
+    if (!png) {
+      ShowResultNotification(false);
+      Finish();
+      return;
+    }
+    base::Time::Exploded exploded;
+    base::Time::Now().LocalExplode(&exploded);
+    saved_path_ = download_dir_.AppendASCII(
+        base::StringPrintf(
+            "lumo-screenshot-%04d%02d%02d-%02d%02d%02d.png",
+            exploded.year, exploded.month, exploded.day_of_month,
+            exploded.hour, exploded.minute, exploded.second));
+    const std::string png_string(png->begin(), png->end());
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE, {base::MayBlock()},
+        base::BindOnce(
+            [](const base::FilePath& file_path, std::string data) {
+              return base::WriteFile(file_path, data);
+            },
+            saved_path_, png_string),
+        base::BindOnce(&LumoFullPageScreenshotClient::OnWriteFinished,
+                       weak_factory_.GetWeakPtr()));
+  }
+
+  void OnWriteFinished(bool saved) {
+    ShowResultNotification(saved);
+    Finish();
+  }
+
+  void ShowResultNotification(bool saved) {
+    ShowLumoScreenshotNotification(profile_, saved_path_, saved);
+  }
+
+  void Finish() {
+    host_->DetachClient(this);
+    delete this;
+  }
+
+  scoped_refptr<content::DevToolsAgentHost> host_;
+  Profile* const profile_;
+  base::FilePath download_dir_;
+  base::FilePath saved_path_;
+  base::WeakPtrFactory<LumoFullPageScreenshotClient> weak_factory_{this};
+};
