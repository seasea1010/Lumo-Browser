diff --git a/chrome/browser/ui/views/frame/browser_view.cc b/chrome/browser/ui/views/frame/browser_view.cc
index cb12e8a..44ef270 100644
--- a/chrome/browser/ui/views/frame/browser_view.cc
+++ b/chrome/browser/ui/views/frame/browser_view.cc
@@ -352,6 +352,8 @@
 #include "ui/gfx/geometry/size.h"
 #include "ui/gfx/scoped_canvas.h"
 #include "ui/gfx/scrollbar_size.h"
+#include "ui/views/controls/label.h"
+#include "ui/views/background.h"
 #include "ui/views/accessibility/view_accessibility.h"
 #include "ui/views/accessibility/view_accessibility_utils.h"
 #include "ui/views/animation/compositor_animation_runner.h"
@@ -1042,6 +1044,31 @@ BrowserView::BrowserView(BrowserWindowInterface* browser)
   side_panel_content_transition_scrim_view_->layer()->SetOpacity(0.0f);
   side_panel_content_transition_scrim_view_->SetVisible(false);
 
+  // Lumo: persistent label noting that this browser is in an
+  // experimental development stage (Lumo patch 0008). It never
+  // processes events, so clicks pass through to whatever is
+  // below it. BrowserView::Layout() positions it at the top-left
+  // of the contents area on every layout pass and keeps it in
+  // front of the other BrowserView children.
+  //
+  // The label MUST paint to its own layer: without one it is
+  // drawn into BrowserView's layer, which always stays behind
+  // the contents view's layer, so it ends up completely hidden
+  // behind the web page (the same reason ScrimView paints to a
+  // layer). Build #23 shipped the label without a layer and it
+  // never appeared (task 24).
+  auto lumo_dev_stage_label = std::make_unique<views::Label>(
+      l10n_util::GetStringUTF16(IDS_LUMO_DEV_STAGE_LABEL));
+  lumo_dev_stage_label->SetEnabledColor(SK_ColorWHITE);
+  lumo_dev_stage_label->SetBackground(views::CreateRoundedRectBackground(
+      SkColorSetARGB(153, 32, 33, 36), 8.0f));
+  lumo_dev_stage_label->SetPaintToLayer();
+  lumo_dev_stage_label->layer()->SetFillsBoundsOpaquely(false);
+  lumo_dev_stage_label->layer()->SetName("Lumo Dev Stage Label");
+  lumo_dev_stage_label->SetCanProcessEventsWithinSubtree(false);
+  lumo_dev_stage_label->SetFocusBehavior(views::View::FocusBehavior::NEVER);
+  lumo_dev_stage_label_ = AddChildView(std::move(lumo_dev_stage_label));
+
 #if BUILDFLAG(IS_WIN)
   // Create a custom JumpList and add it to an observer of TabRestoreService
   // so we can update the custom JumpList when a tab is added or removed.
@@ -5025,6 +5052,28 @@ void BrowserView::Layout(PassKey) {
     startup_layout_state_ = StartupLayoutState::kDeferring;
   }
 
+  // Lumo: keep the development-stage label pinned to the top-left
+  // of the contents area (Lumo patch 0008). The label gets a small
+  // padding around its preferred size; it is click-through, so it
+  // does not block the page content below it.
+  if (lumo_dev_stage_label_ && multi_contents_view_) {
+    const gfx::Size label_preferred =
+        lumo_dev_stage_label_->GetPreferredSize();
+    const gfx::Rect contents_bounds = multi_contents_view_->bounds();
+    lumo_dev_stage_label_->SetBounds(contents_bounds.x() + 6,
+                                     contents_bounds.y() + 6,
+                                     label_preferred.width() + 12,
+                                     label_preferred.height() + 6);
+    // Keep the label (and its layer) in front of any sibling
+    // added after it, so it always paints above the contents.
+    const std::optional<size_t> label_index =
+        GetIndexOf(lumo_dev_stage_label_.get());
+    if (label_index && *label_index + 1 < children().size()) {
+      ReorderChildView(lumo_dev_stage_label_.get(),
+                       children().size() - 1);
+    }
+  }
+
   layout_deferred_while_invisible_ = false;
   last_laid_out_size_ = size();
 }
