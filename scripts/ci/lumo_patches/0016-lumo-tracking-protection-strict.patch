   PrefService* prefs = GetPrefs();
 
+  // Lumo (patch 0016): while the kLumoTrackingProtectionStrict
+  // experiment is enabled, tighten this profile's privacy
+  // settings at every startup: block third-party cookies, send
+  // Do Not Track, enable Global Privacy Control, and turn the
+  // ad privacy (Privacy Sandbox) features off. The values are
+  // written to the profile prefs, so they stay visible (and
+  // editable) in the normal settings UI; turning the experiment
+  // off stops re-applying them on later starts but does not
+  // restore whatever values were there before.
+  if (base::FeatureList::IsEnabled(
+          features::kLumoTrackingProtectionStrict)) {
+    prefs->SetInteger(
+        prefs::kCookieControlsMode,
+        static_cast<int>(CookieControlsMode::kBlockThirdParty));
+    prefs->SetBoolean(prefs::kEnableDoNotTrack, true);
+    prefs->SetBoolean(prefs::kEnableGPC, true);
+    prefs->SetBoolean(prefs::kPrivacySandboxM1TopicsEnabled, false);
+    prefs->SetBoolean(prefs::kPrivacySandboxM1FledgeEnabled, false);
+    prefs->SetBoolean(prefs::kPrivacySandboxM1AdMeasurementEnabled,
+                      false);
+  }
+
