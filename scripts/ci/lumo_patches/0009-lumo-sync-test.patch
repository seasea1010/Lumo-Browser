+namespace {
+
+// Lumo: string form of a Sync transport state, for the Sync
+// self-test result details (Lumo patch 0009).
+const char* LumoTransportStateToString(
+    syncer::SyncService::TransportState state) {
+  using TransportState = syncer::SyncService::TransportState;
+  switch (state) {
+    case TransportState::DISABLED:
+      return "DISABLED";
+    case TransportState::PAUSED:
+      return "PAUSED";
+    case TransportState::START_DEFERRED:
+      return "START_DEFERRED";
+    case TransportState::INITIALIZING:
+      return "INITIALIZING";
+    case TransportState::PENDING_DESIRED_CONFIGURATION:
+      return "PENDING_DESIRED_CONFIGURATION";
+    case TransportState::CONFIGURING:
+      return "CONFIGURING";
+    case TransportState::ACTIVE:
+      return "ACTIVE";
+  }
+}
+
+}  // namespace
+
+void PeopleHandler::HandleLumoSyncTest(const base::ListValue& args) {
+  AllowJavascript();
+
+  CHECK_EQ(1U, args.size());
+  const base::Value& callback_id = args[0];
+
+  // A second click while a test is running resolves immediately
+  // instead of starting a competing test.
+  if (lumo_sync_test_timer_) {
+    ResolveJavascriptCallback(
+        callback_id,
+        BuildLumoSyncTestResult(false, "テストが既に実行中です"));
+    return;
+  }
+
+  syncer::SyncService* service = GetSyncService();
+  signin::IdentityManager* identity_manager =
+      IdentityManagerFactory::GetForProfile(profile_);
+  bookmarks::BookmarkModel* model =
+      BookmarkModelFactory::GetForBrowserContext(profile_);
+  const bool round_trip_possible =
+      service && identity_manager &&
+      identity_manager->HasPrimaryAccount(signin::ConsentLevel::kSync) &&
+      service->IsSyncFeatureActive() &&
+      service->GetTransportState() ==
+          syncer::SyncService::TransportState::ACTIVE &&
+      service->GetUserSettings()->GetSelectedTypes().Has(
+          syncer::UserSelectableType::kBookmarks) &&
+      model && model->loaded();
+  if (!round_trip_possible) {
+    ResolveJavascriptCallback(
+        callback_id,
+        BuildLumoSyncTestResult(
+            false,
+            "Sync が有効でないため、往復テストは実行できませんでした"));
+    return;
+  }
+
+  // Create the test bookmark in "Other bookmarks". The URL is
+  // unique to this test run, so FinishLumoSyncTest() can find and
+  // delete exactly this bookmark again; the host is an .invalid
+  // TLD and is never visited.
+  lumo_sync_test_callback_id_ = callback_id.Clone();
+  lumo_sync_test_bookmark_url_ = GURL(
+      "https://sync-test.lumo.invalid/?t=" +
+      base::NumberToString(
+          base::Time::Now().InMillisecondsFSinceUnixEpoch()));
+  lumo_sync_test_commits_before_ =
+      service->GetLastCycleSnapshotForDebugging()
+          .model_neutral_state()
+          .num_successful_commits;
+  model->AddURL(model->other_node(),
+                model->other_node()->children().size(),
+                u"Lumo Sync Test", lumo_sync_test_bookmark_url_);
+
+  // Completion is detected in OnStateChanged(): a finished cycle
+  // whose successful-commit count grew past the recorded value
+  // and that leaves no unsynced local changes means the bookmark
+  // reached the server. The timer bounds the wait.
+  lumo_sync_test_timer_ = std::make_unique<base::OneShotTimer>();
+  lumo_sync_test_timer_->Start(
+      FROM_HERE, base::Seconds(45),
+      base::BindOnce(&PeopleHandler::OnLumoSyncTestTimeout,
+                     weak_factory_.GetWeakPtr()));
+}
+
+base::DictValue PeopleHandler::BuildLumoSyncTestResult(
+    bool bookmark_round_trip,
+    const std::string& bookmark_round_trip_detail) const {
+  base::DictValue result;
+
+  // (1) The browser's own Google API key and OAuth client are
+  // baked into the build (Lumo injects them from its own Google
+  // Cloud project at build time). Only their presence is
+  // reported; the values themselves are never exposed.
+  result.Set("apiKeyConfigured", !google_apis::GetAPIKey().empty());
+  result.Set("oauthClientConfigured",
+             !google_apis::GetOAuth2ClientID(google_apis::CLIENT_MAIN)
+                  .empty() &&
+                 !google_apis::GetOAuth2ClientSecret(
+                      google_apis::CLIENT_MAIN)
+                      .empty());
+
+  signin::IdentityManager* identity_manager =
+      IdentityManagerFactory::GetForProfile(profile_);
+
+  // (2) Sign-in state (with Sync consent).
+  const bool signed_in =
+      identity_manager &&
+      identity_manager->HasPrimaryAccount(signin::ConsentLevel::kSync);
+  result.Set("signedIn", signed_in);
+
+  syncer::SyncService* service = GetSyncService();
+
+  // (3) Sync engine state.
+  const syncer::SyncService::TransportState transport_state =
+      service ? service->GetTransportState()
+              : syncer::SyncService::TransportState::DISABLED;
+  result.Set("transportState",
+             LumoTransportStateToString(transport_state));
+  result.Set("syncActive",
+             service && service->IsSyncFeatureActive() &&
+                 transport_state ==
+                     syncer::SyncService::TransportState::ACTIVE);
+
+  // (4) Server reachability, approximated from the last completed
+  // cycle: the engine is ACTIVE, at least one cycle completed,
+  // and the account's refresh token is not in a persistent error
+  // state.
+  const syncer::SyncCycleSnapshot snapshot =
+      service ? service->GetLastCycleSnapshotForDebugging()
+              : syncer::SyncCycleSnapshot();
+  const bool persistent_auth_error =
+      signed_in &&
+      identity_manager->HasAccountWithRefreshTokenInPersistentErrorState(
+          identity_manager->GetPrimaryAccountId(
+              signin::ConsentLevel::kSync));
+  result.Set("serverConnected",
+             transport_state ==
+                     syncer::SyncService::TransportState::ACTIVE &&
+                 snapshot.is_initialized() && !persistent_auth_error);
+
+  // (5) Bookmark round trip (filled in by the caller).
+  result.Set("bookmarkRoundTrip", bookmark_round_trip);
+  result.Set("bookmarkRoundTripDetail", bookmark_round_trip_detail);
+
+  // (6) Last sync time and error state.
+  const base::Time last_synced =
+      service ? service->GetLastSyncedTimeForDebugging() : base::Time();
+  result.Set("lastSyncTimeMs",
+             last_synced.is_null()
+                 ? 0.0
+                 : last_synced.InMillisecondsFSinceUnixEpoch());
+  result.Set("hasError",
+             persistent_auth_error ||
+                 snapshot.num_server_conflicts() > 0 ||
+                 (service && service->GetUserActionableError() !=
+                                 syncer::SyncService::
+                                     UserActionableError::kNone));
+  result.Set("serverConflicts", snapshot.num_server_conflicts());
+  return result;
+}
+
+void PeopleHandler::FinishLumoSyncTest(bool bookmark_round_trip,
+                                       const std::string& detail) {
+  if (!lumo_sync_test_timer_) {
+    return;
+  }
+  lumo_sync_test_timer_.reset();
+  DeleteLumoSyncTestBookmark();
+  ResolveJavascriptCallback(
+      lumo_sync_test_callback_id_,
+      BuildLumoSyncTestResult(bookmark_round_trip, detail));
+  lumo_sync_test_callback_id_ = base::Value();
+}
+
+void PeopleHandler::OnLumoSyncTestTimeout() {
+  FinishLumoSyncTest(
+      false, "45秒以内に同期サイクルの完了を確認できませんでした");
+}
+
+void PeopleHandler::DeleteLumoSyncTestBookmark() {
+  if (lumo_sync_test_bookmark_url_.is_empty()) {
+    return;
+  }
+  bookmarks::BookmarkModel* model =
+      BookmarkModelFactory::GetForBrowserContext(profile_);
+  if (model && model->loaded()) {
+    for (const auto& child : model->other_node()->children()) {
+      if (child->url() == lumo_sync_test_bookmark_url_) {
+        model->Remove(child.get(),
+                      bookmarks::metrics::BookmarkEditSource::kOther,
+                      FROM_HERE);
+        break;
+      }
+    }
+  }
+  lumo_sync_test_bookmark_url_ = GURL();
+}
