 void PeopleHandler::OnStateChanged(syncer::SyncService* sync_service) {
+  // Lumo: a pending Sync self-test (Lumo patch 0009) completes
+  // once a sync cycle has committed new data (the test bookmark)
+  // and no local changes remain unsynced.
+  if (lumo_sync_test_timer_) {
+    const syncer::SyncCycleSnapshot snapshot =
+        sync_service->GetLastCycleSnapshotForDebugging();
+    if (snapshot.is_initialized() &&
+        !snapshot.has_remaining_local_changes() &&
+        snapshot.model_neutral_state().num_successful_commits >
+            lumo_sync_test_commits_before_) {
+      FinishLumoSyncTest(true, "テスト用ブックマークが同期されました");
+    }
+  }
   UpdateSyncStatus();
   UpdateStoredAccounts();
   // TODO(crbug.com/40140566): Re-evaluate marking sync as configuring here,
