+// Copyright 2026 The Lumo Authors
+// Lumo NTP customization (patch 0051, task 38): card sections in
+// the standard Customize Chrome idiom. Controls are data-bound to
+// config paths; the element's handlers turn every edit into one
+// lumoNtpSetConfig write (instant preview on the new tab page).
+
+import {html} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+
+import type {LumoNtpSectionElement} from './lumo_ntp_section.js';
+
+export function getHtml(this: LumoNtpSectionElement) {
+  return html`
+<div class="lumo-section">
+  <div class="lumo-card">
+    <div class="lumo-card-title">Lumo をカスタマイズ</div>
+    <label>プリセット
+      <select id="preset"
+          @change="${this.onPreset_}">
+        <option value="default">標準</option>
+        <option value="minimal">ミニマル</option>
+        <option value="focus">集中（ダーク）</option>
+        <option value="colorful">カラフル</option>
+      </select>
+    </label>
+    <div class="lumo-row">
+      <button @click="${this.onExport_}">エクスポート</button>
+      <label class="lumo-file">インポート
+        <input type="file" accept="application/json"
+            @change="${this.onImport_}">
+      </label>
+      <button @click="${this.onReset_}">リセット</button>
+    </div>
+  </div>
+
+  <div class="lumo-card">
+    <div class="lumo-card-title">背景</div>
+    <label>種類
+      <select data-path="background.mode"
+          @change="${this.onText_}">
+        <option value="solid">単色</option>
+        <option value="gradient">グラデーション</option>
+        <option value="pattern">柄</option>
+        <option value="image">画像</option>
+      </select>
+    </label>
+    <label>色 <input type="color" data-path="background.color"
+        @input="${this.onColor_}"></label>
+    <label>色 2 <input type="color" data-path="background.color2"
+        @input="${this.onColor_}"></label>
+    <label>角度 <input type="range" min="0" max="360"
+        data-path="background.gradientAngle"
+        @input="${this.onNumber_}"></label>
+    <label>柄
+      <select data-path="background.pattern"
+          @change="${this.onText_}">
+        <option value="none">なし</option>
+        <option value="dots">ドット</option>
+        <option value="grid">格子</option>
+        <option value="diagonal">斜線</option>
+      </select>
+    </label>
+    <label class="lumo-file">ローカル画像
+      <input type="file" accept="image/*"
+          @change="${this.onImageFile_}">
+    </label>
+    <label>フィット
+      <select data-path="background.imageFit"
+          @change="${this.onText_}">
+        <option value="cover">全体を覆う</option>
+        <option value="contain">全体を表示</option>
+      </select>
+    </label>
+    <label>位置
+      <select data-path="background.imagePosition"
+          @change="${this.onText_}">
+        <option value="center">中央</option>
+        <option value="top">上</option>
+        <option value="bottom">下</option>
+        <option value="left">左</option>
+        <option value="right">右</option>
+      </select>
+    </label>
+    <label>繰り返し <input type="checkbox"
+        data-path="background.imageRepeat"
+        @change="${this.onToggle_}"></label>
+    <label>暗さ <input type="range" min="0" max="100"
+        data-path="background.darkness"
+        @input="${this.onNumber_}"></label>
+    <label>ぼかし <input type="range" min="0" max="40"
+        data-path="background.blur"
+        @input="${this.onNumber_}"></label>
+    <label>彩度 <input type="range" min="0" max="200"
+        data-path="background.saturation"
+        @input="${this.onNumber_}"></label>
+    <label>オーバーレイ色 <input type="color"
+        data-path="background.overlayColor"
+        @input="${this.onColor_}"></label>
+    <label>オーバーレイの濃さ <input type="range" min="0" max="100"
+        data-path="background.overlayOpacity"
+        @input="${this.onNumber_}"></label>
+  </div>
+
+  <div class="lumo-card">
+    <div class="lumo-card-title">時計・日付</div>
+    <label>表示 <input type="checkbox" data-path="clock.enabled"
+        @change="${this.onToggle_}"></label>
+    <label>24 時間表示 <input type="checkbox"
+        data-path="clock.format24h"
+        @change="${this.onToggle_}"></label>
+    <label>秒表示 <input type="checkbox" data-path="clock.showSeconds"
+        @change="${this.onToggle_}"></label>
+    <label>サイズ <input type="range" min="24" max="160"
+        data-path="clock.size" @input="${this.onNumber_}"></label>
+    <label>太さ
+      <select data-path="clock.weight" @change="${this.onNumber_}">
+        <option value="100">細い</option>
+        <option value="300">標準</option>
+        <option value="500">中</option>
+        <option value="700">太い</option>
+      </select>
+    </label>
+    <label>日付を表示 <input type="checkbox" data-path="clock.showDate"
+        @change="${this.onToggle_}"></label>
+    <label>日付の書式
+      <select data-path="clock.dateFormat" @change="${this.onText_}">
+        <option value="weekday-month-day">曜日・月日</option>
+        <option value="full">年月日・曜日</option>
+        <option value="month-day">月日のみ</option>
+      </select>
+    </label>
+    <label>配置
+      <select data-path="clock.align" @change="${this.onText_}">
+        <option value="left">左</option>
+        <option value="center">中央</option>
+        <option value="right">右</option>
+      </select>
+    </label>
+    <label>色 <input type="color" data-path="clock.color"
+        @input="${this.onColor_}"></label>
+    <label>不透明度 <input type="range" min="0" max="100"
+        data-path="clock.opacity" @input="${this.onNumber_}"></label>
+  </div>
+
+  <div class="lumo-card">
+    <div class="lumo-card-title">挨拶文</div>
+    <label>表示 <input type="checkbox" data-path="greeting.enabled"
+        @change="${this.onToggle_}"></label>
+    <label>時間帯で切り替え <input type="checkbox"
+        data-path="greeting.useTimeOfDay"
+        @change="${this.onToggle_}"></label>
+    <label>名前 <input type="text" data-path="greeting.name"
+        @change="${this.onText_}"></label>
+    <label>朝 <input type="text" data-path="greeting.morning"
+        @change="${this.onText_}"></label>
