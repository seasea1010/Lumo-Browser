diff --git a/chrome/browser/resources/side_panel/customize_chrome/lumo_ntp_section.ts b/chrome/browser/resources/side_panel/customize_chrome/lumo_ntp_section.ts
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/chrome/browser/resources/side_panel/customize_chrome/lumo_ntp_section.ts
@@ -100,0 +100,208 @@
+// Copyright 2026 The Lumo Authors
+// Lumo NTP customization (patch 0051, task 38): the
+// "Lumo \u3092\u30ab\u30b9\u30bf\u30de\u30a4\u30ba" section inside the
+// standard Customize Chrome side panel. Every control edits the
+// lumo.ntp.config dictionary pref through the native handler; the
+// new tab page observes the same pref, so edits preview instantly.
+// No network access anywhere in this file.
+
+import {CrLitElement} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+
+import {getCss} from './lumo_ntp_section.css.js';
+import {getHtml} from './lumo_ntp_section.html.js';
+
+interface LumoNtpConfig {
+  [key: string]: unknown;
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'lumo-ntp-section': LumoNtpSectionElement;
+  }
+}
+
+export class LumoNtpSectionElement extends CrLitElement {
+  static get is() {
+    return 'lumo-ntp-section';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)``;
+  }
+
+  static override get properties() {
+    return {
+      config_: {type: Object},
+      memo_: {type: String},
+    };
+  }
+
+  protected accessor config_: LumoNtpConfig = {};
+  protected accessor memo_: string = '';
+
+  override connectedCallback() {
+    super.connectedCallback();
+    chrome.send('lumoNtpGetConfig', [this.resolveConfig_.bind(this)]);
+    chrome.send('lumoNtpGetContent', [this.resolveContent_.bind(this)]);
+  }
+
+  private resolveConfig_(config: LumoNtpConfig) {
+    this.config_ = config;
+    this.requestUpdate();
+  }
+
+  private resolveContent_(content: {memo: string}) {
+    this.memo_ = content.memo;
+  }
+
+  // One write per edit: a deep-cloned dictionary with one leaf
+  // replaced, sent as a single pref write.
+  protected setPath_(path: string, value: unknown) {
+    const next: LumoNtpConfig =
+        JSON.parse(JSON.stringify(this.config_)) as LumoNtpConfig;
+    const keys = path.split('.');
+    let node: Record<string, unknown> = next as Record<string, unknown>;
+    for (const key of keys.slice(0, -1)) {
+      node = node[key] as Record<string, unknown>;
+    }
+    node[keys[keys.length - 1]!] = value;
+    this.config_ = next;
+    chrome.send('lumoNtpSetConfig', [next]);
+    this.requestUpdate();
+  }
+
+  protected getPath_(path: string): unknown {
+    let node: unknown = this.config_;
+    for (const key of path.split('.')) {
+      node = (node as Record<string, unknown>)?.[key];
+    }
+    return node;
+  }
+
+  protected onToggle_(e: CustomEvent<{path: string, checked: boolean}>) {
+    this.setPath_(e.detail.path, e.detail.checked);
+  }
+
+  protected onNumber_(e: CustomEvent<{path: string, value: string}>) {
+    this.setPath_(e.detail.path, Number(e.detail.value));
+  }
+
+  protected onText_(e: CustomEvent<{path: string, value: string}>) {
+    this.setPath_(e.detail.path, e.detail.value);
+  }
+
+  protected onColor_(e: CustomEvent<{path: string, value: string}>) {
+    this.setPath_(e.detail.path, e.detail.value);
+  }
+
+  protected onImageFile_(e: Event) {
+    const input = e.target as HTMLInputElement;
+    const file = input.files?.[0];
+    if (!file) {
+      return;
+    }
+    const reader = new FileReader();
+    reader.onload = () => {
+      chrome.send('lumoNtpSetBackgroundImage', [String(reader.result)]);
+      this.setPath_('background.mode', 'image');
+    };
+    reader.readAsDataURL(file);
+  }
+
+  protected onPreset_(e: CustomEvent<{value: string}>) {
+    const presets =
+        (window as unknown as {LUMO_NTP_PRESETS: Record<string, unknown>})
+            .LUMO_NTP_PRESETS;
+    const preset = presets[e.detail.value];
+    if (preset) {
+      this.config_ = JSON.parse(JSON.stringify(preset)) as LumoNtpConfig;
+      chrome.send('lumoNtpSetConfig', [this.config_]);
+      this.requestUpdate();
+    }
+  }
+
+  protected onExport_() {
+    const blob = new Blob([JSON.stringify(this.config_, null, 2)],
+                          {type: 'application/json'});
+    const url = URL.createObjectURL(blob);
+    const a = document.createElement('a');
+    a.href = url;
+    a.download = 'lumo-ntp-config.json';
+    a.click();
+    URL.revokeObjectURL(url);
+  }
+
+  protected onImport_(e: Event) {
+    const input = e.target as HTMLInputElement;
+    const file = input.files?.[0];
+    if (!file) {
+      return;
+    }
+    file.text().then(text => {
+      try {
+        const parsed = JSON.parse(text) as LumoNtpConfig;
+        if (typeof parsed !== 'object' || parsed === null ||
+            !('background' in parsed)) {
+          return;
+        }
+        this.config_ = parsed;
+        chrome.send('lumoNtpSetConfig', [parsed]);
+        this.requestUpdate();
+      } catch {
+        // Invalid JSON: leave the current config untouched.
+      }
+    });
+  }
+
+  protected onReset_() {
+    chrome.send('lumoNtpResetConfig', []);
+    chrome.send('lumoNtpGetConfig', [this.resolveConfig_.bind(this)]);
+  }
+
+  protected onShortcutAdd_() {
+    const items = [...(this.getPath_('shortcuts.items') as unknown[])];
+    items.push({title: '', url: 'https://'});
+    this.setPath_('shortcuts.items', items);
+  }
+
+  protected onShortcutRemove_(index: number) {
+    const items = [...(this.getPath_('shortcuts.items') as unknown[])];
+    items.splice(index, 1);
+    this.setPath_('shortcuts.items', items);
+  }
+
+  // Drag reorder for shortcut items and widgets: HTML5 drag events
+  // swap the dragged entry with the drop target, then one write.
+  protected onListDrop_(path: string, from: number, to: number) {
+    const items = [...(this.getPath_(path) as unknown[])];
+    const [moved] = items.splice(from, 1);
+    items.splice(to, 0, moved);
+    if (path === 'widgets') {
+      (items as Array<{order: number}>).forEach((w, i) => w.order = i);
+    }
+    this.setPath_(path, items);
+  }
+
+  protected onWidgetToggle_(index: number, checked: boolean) {
+    const widgets =
+        JSON.parse(JSON.stringify(this.getPath_('widgets'))) as
+        Array<Record<string, unknown>>;
+    widgets[index]!['enabled'] = checked;
+    this.setPath_('widgets', widgets);
+  }
+
+  protected onWidgetWidth_(index: number, value: string) {
+    const widgets =
+        JSON.parse(JSON.stringify(this.getPath_('widgets'))) as
+        Array<Record<string, unknown>>;
+    widgets[index]!['width'] = Number(value);
+    this.setPath_('widgets', widgets);
+  }
+}
+
+customElements.define(
+    LumoNtpSectionElement.is, LumoNtpSectionElement);
