+// Copyright 2026 The Lumo Authors
+// Lumo NTP customization (patch 0051, task 38).
+
+#include "chrome/browser/ui/webui/side_panel/customize_chrome/lumo_ntp_customize_handler.h"
+
+#include <string>
+
+#include "base/functional/bind.h"
+#include "base/json/json_writer.h"
+#include "base/values.h"
+#include "chrome/browser/lumo/lumo_ntp_config.h"
+#include "chrome/common/pref_names.h"
+#include "components/prefs/pref_service.h"
+#include "components/version_info/version_info.h"
+#include "content/public/browser/web_ui.h"
+
+LumoNtpCustomizeHandler::LumoNtpCustomizeHandler(PrefService* prefs)
+    : prefs_(prefs) {}
+
+LumoNtpCustomizeHandler::~LumoNtpCustomizeHandler() = default;
+
+void LumoNtpCustomizeHandler::RegisterMessages() {
+  web_ui()->RegisterMessageCallback(
+      "lumoNtpGetConfig",
+      base::BindRepeating(&LumoNtpCustomizeHandler::HandleGetConfig,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "lumoNtpSetConfig",
+      base::BindRepeating(&LumoNtpCustomizeHandler::HandleSetConfig,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "lumoNtpResetConfig",
+      base::BindRepeating(&LumoNtpCustomizeHandler::HandleResetConfig,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "lumoNtpGetContent",
+      base::BindRepeating(&LumoNtpCustomizeHandler::HandleGetContent,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "lumoNtpSetMemo",
+      base::BindRepeating(&LumoNtpCustomizeHandler::HandleSetMemo,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "lumoNtpSetTodos",
+      base::BindRepeating(&LumoNtpCustomizeHandler::HandleSetTodos,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "lumoNtpSetBackgroundImage",
+      base::BindRepeating(
+          &LumoNtpCustomizeHandler::HandleSetBackgroundImage,
+          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "lumoNtpGetLumoInfo",
+      base::BindRepeating(&LumoNtpCustomizeHandler::HandleGetLumoInfo,
+                          base::Unretained(this)));
+}
+
+void LumoNtpCustomizeHandler::HandleGetConfig(
+    const base::ListValue& args) {
+  AllowJavascript();
+  CHECK_EQ(1U, args.size());
+  const base::DictValue& config = prefs_->GetDict(prefs::kLumoNtpConfig);
+  ResolveJavascriptCallback(args[0], base::Value(config.Clone()));
+}
+
+void LumoNtpCustomizeHandler::HandleSetConfig(
+    const base::ListValue& args) {
+  // One dictionary write per edit: the NTP observes the same pref
+  // and re-renders, which is the instant preview.
+  CHECK_EQ(1U, args.size());
+  const base::DictValue* dict = args[0].GetIfDict();
+  if (!dict) {
+    return;
+  }
+  prefs_->SetDict(prefs::kLumoNtpConfig, dict->Clone());
+}
+
+void LumoNtpCustomizeHandler::HandleResetConfig(
+    const base::ListValue& args) {
+  prefs_->ClearPref(prefs::kLumoNtpConfig);
+  prefs_->ClearPref(prefs::kLumoNtpMemo);
+  prefs_->ClearPref(prefs::kLumoNtpTodos);
+  prefs_->ClearPref(prefs::kLumoNtpBackgroundImage);
+}
+
+void LumoNtpCustomizeHandler::HandleGetContent(
+    const base::ListValue& args) {
+  AllowJavascript();
+  CHECK_EQ(1U, args.size());
+  base::DictValue content;
+  content.Set("memo", prefs_->GetString(prefs::kLumoNtpMemo));
+  content.Set("todos", prefs_->GetList(prefs::kLumoNtpTodos).Clone());
+  content.Set("backgroundImage",
+              prefs_->GetString(prefs::kLumoNtpBackgroundImage));
+  ResolveJavascriptCallback(args[0], base::Value(std::move(content)));
+}
+
+void LumoNtpCustomizeHandler::HandleSetMemo(
+    const base::ListValue& args) {
+  CHECK_EQ(1U, args.size());
+  if (const std::string* memo = args[0].GetIfString()) {
+    prefs_->SetString(prefs::kLumoNtpMemo, *memo);
+  }
+}
+
+void LumoNtpCustomizeHandler::HandleSetTodos(
+    const base::ListValue& args) {
+  CHECK_EQ(1U, args.size());
+  if (const base::ListValue* todos = args[0].GetIfList()) {
+    prefs_->SetList(prefs::kLumoNtpTodos, todos->Clone());
+  }
+}
+
+void LumoNtpCustomizeHandler::HandleSetBackgroundImage(
+    const base::ListValue& args) {
+  CHECK_EQ(1U, args.size());
+  if (const std::string* image = args[0].GetIfString()) {
+    prefs_->SetString(prefs::kLumoNtpBackgroundImage, *image);
+  }
+}
+
+void LumoNtpCustomizeHandler::HandleGetLumoInfo(
+    const base::ListValue& args) {
+  AllowJavascript();
+  CHECK_EQ(1U, args.size());
+  base::DictValue info;
+  info.Set("product", "Lumo");
+  info.Set("version", version_info::GetVersionNumber());
+  info.Set("chromiumVersion", version_info::GetVersionNumber());
+  ResolveJavascriptCallback(args[0], base::Value(std::move(info)));
+}
