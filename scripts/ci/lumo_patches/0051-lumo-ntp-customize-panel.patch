+// Copyright 2026 The Lumo Authors
+// Lumo NTP customization (patch 0051, task 38): WebUI message
+// handler that bridges the Customize Chrome side panel and the
+// new tab page to the lumo.ntp.* prefs. No network access: every
+// message is a local pref read/write.
+
+#ifndef CHROME_BROWSER_UI_WEBUI_SIDE_PANEL_CUSTOMIZE_CHROME_LUMO_NTP_CUSTOMIZE_HANDLER_H_
+#define CHROME_BROWSER_UI_WEBUI_SIDE_PANEL_CUSTOMIZE_CHROME_LUMO_NTP_CUSTOMIZE_HANDLER_H_
+
+#include "base/memory/raw_ptr.h"
+#include "content/public/browser/web_ui_message_handler.h"
+
+class PrefService;
+
+class LumoNtpCustomizeHandler : public content::WebUIMessageHandler {
+ public:
+  explicit LumoNtpCustomizeHandler(PrefService* prefs);
+  LumoNtpCustomizeHandler(const LumoNtpCustomizeHandler&) = delete;
+  LumoNtpCustomizeHandler& operator=(const LumoNtpCustomizeHandler&) =
+      delete;
+  ~LumoNtpCustomizeHandler() override;
+
+  // content::WebUIMessageHandler:
+  void RegisterMessages() override;
+
+ private:
+  void HandleGetConfig(const base::ListValue& args);
+  void HandleSetConfig(const base::ListValue& args);
+  void HandleResetConfig(const base::ListValue& args);
+  void HandleGetContent(const base::ListValue& args);
+  void HandleSetMemo(const base::ListValue& args);
+  void HandleSetTodos(const base::ListValue& args);
+  void HandleSetBackgroundImage(const base::ListValue& args);
+  void HandleGetLumoInfo(const base::ListValue& args);
+
+  raw_ptr<PrefService> prefs_;
+};
+
+#endif  // CHROME_BROWSER_UI_WEBUI_SIDE_PANEL_CUSTOMIZE_CHROME_LUMO_NTP_CUSTOMIZE_HANDLER_H_
