+// and the Customize panel fall back to the registered default for
+// anything missing, so older or partial configs keep working.
+//
+//   background: mode(solid|gradient|pattern|image), color,
+//     color2, gradientAngle(0-360), pattern(none|dots|grid|
+//     diagonal), imageFit(cover|contain), imagePosition,
+//     imageRepeat, darkness(0-100), blur(0-40 px),
+//     saturation(0-200 %), overlayColor, overlayOpacity(0-100)
+//   clock: enabled, format24h, showSeconds, size(px), weight,
+//     showDate, dateFormat, align, color, opacity(0-100)
+//   greeting: enabled, useTimeOfDay, name, morning, afternoon,
+//     evening
+//   search: enabled, engine(default|google|bing|duckduckgo|
+//     yahoo_jp|brave), width, height, radius, bgOpacity, blur,
+//     placeholder, align
+//   shortcuts: columns(2-10), rows, tileSize, gap, radius,
+//     bgColor, bgOpacity, showLabel, labelColor, labelSize,
+//     faviconSize, openInNewTab, items[{title, url}]
+//   widgets: [{id, enabled, order, width}] with id one of
+//     clock, calendar, bookmarks, recently_closed, downloads,
+//     memo, todo, open_tabs, lumo_info
+//   layout: verticalAlign(top|center), maxWidth, gap,
+//     density(relaxed|standard|compact), fontScale(%)
+//   theme: mode(light|dark|system), accent
