+
+#include "chrome/browser/lumo/lumo_debugger_reporter.h"
+
+#include <map>
+#include <memory>
+#include <optional>
+#include <set>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/command_line.h"
+#include "base/feature_list.h"
+#include "base/files/file_path.h"
+#include "base/functional/bind.h"
+#include "base/functional/function_ref.h"
+#include "base/json/json_writer.h"
+#include "base/no_destructor.h"
+#include "base/observer_list_types.h"
+#include "base/path_service.h"
+#include "base/process/process.h"
+#include "base/process/process_metrics.h"
+#include "base/scoped_observation.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+#include "base/values.h"
+#include "build/build_config.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/profiles/profile_manager.h"
+#include "chrome/browser/net/system_network_context_manager.h"
+#include "chrome/browser/ui/browser_window/public/browser_collection_observer.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/browser_window/public/global_browser_collection.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/tabs/tab_strip_model_observer.h"
+#include "chrome/browser/ui/ui_features.h"
+#include "chrome/common/chrome_paths.h"
+#include "components/version_info/version_info.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/render_process_host.h"
+#include "content/public/browser/web_contents.h"
+#include "net/base/load_flags.h"
+#include "net/traffic_annotation/network_traffic_annotation.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/cpp/simple_url_loader.h"
+#include "url/gurl.h"
+
+namespace lumo::debugger {
+
+namespace {
+
+// The port the Lumo debugger app listens on, and the only port a
+// valid endpoint may name (the app binds 127.0.0.1:47741).
+constexpr int kDebuggerPort = 47741;
+
+// Parses the --lumo-debugger-endpoint value and returns it only
+// when it points at the debugger app on this machine: the http
+// scheme, a loopback host (127.0.0.1, localhost, or ::1), and
+// kDebuggerPort. Anything else (a remote host, another port,
+// https, a malformed URL) yields nullopt, so a stray or hostile
+// switch value can never make the browser POST session events
+// anywhere but the owner's own debugger app.
+std::optional<GURL> GetValidatedEndpoint() {
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  if (!command_line->HasSwitch(kEndpointSwitch)) {
+    return std::nullopt;
+  }
+  const GURL url(command_line->GetSwitchValueASCII(kEndpointSwitch));
+  if (!url.is_valid() || !url.SchemeIs("http")) {
+    return std::nullopt;
+  }
+  const std::string host(url.host());
+  if (host != "127.0.0.1" && host != "localhost" && host != "::1") {
+    return std::nullopt;
+  }
+  if (url.EffectiveIntPort() != kDebuggerPort) {
+    return std::nullopt;
+  }
+  return url;
+}
+
+}  // namespace
+
+bool IsEnabled() {
+  return GetValidatedEndpoint().has_value();
+}
+
+namespace {
+
+// Serializes |payload| as JSON and POSTs it to the endpoint from
+// the command line. Fire-and-forget: the loader owns itself until
+// the request finishes or times out (3 seconds), the response is
+// ignored, and any failure (no browser process, no network context,
+// invalid endpoint URL) silently drops the event. Never blocks the
+// caller beyond building the request.
+void PostJson(base::DictValue payload) {
+  if (!g_browser_process) {
+    return;
+  }
+  auto* network_context_manager =
+      g_browser_process->system_network_context_manager();
+  if (!network_context_manager) {
+    return;
+  }
+  auto* factory = network_context_manager->GetURLLoaderFactory();
+  if (!factory) {
+    return;
+  }
+  std::string json;
+  if (!base::JSONWriter::Write(payload, &json)) {
+    return;
+  }
+  auto request = std::make_unique<network::ResourceRequest>();
+  std::optional<GURL> endpoint = GetValidatedEndpoint();
+  if (!endpoint) {
+    return;
+  }
+  request->url = *endpoint;
+  request->method = "POST";
+  request->load_flags = net::LOAD_BYPASS_CACHE | net::LOAD_DISABLE_CACHE;
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  static constexpr net::NetworkTrafficAnnotationTag kAnnotation =
+      net::DefineNetworkTrafficAnnotation("lumo_debugger_event", R"(
+        semantics {
+          sender: "Lumo Debugger Reporter"
+          description:
+            "Sends opt-in diagnostic events (startup, tab list, "
+            "relaunch, shutdown) as JSON to the Lumo debugger app "
+            "running on the user's own machine. Only sent in "
+            "sessions the debugger app itself launched with "
+            "--lumo-debugger-endpoint; a normally launched browser "
+            "never sends these."
+          trigger:
+            "Browser startup, tab open/close/title/URL changes "
+            "(debounced, plus a 5 second periodic refresh), "
+            "relaunch, and shutdown, only when "
+            "--lumo-debugger-endpoint is present."
+          data:
+            "Event type; for startup: browser version, user data "
+            "directory path, profile name, enabled Lumo feature "
+            "names; for tabs: title, URL and renderer process "
+            "private memory of tabs in normal (non-incognito) "
+            "windows only; for relaunch: target executable path "
+            "and success flag. No passwords, API keys, or "
+            "incognito data."
+          destination: LOCAL
+        }
+        policy {
+          cookies_allowed: NO
+          setting:
+            "Only active in sessions launched with "
+            "--lumo-debugger-endpoint."
+          policy_exception_justification:
+            "Opt-in local diagnostics for the browser owner's own "
+            "debugger app."
+        })");
+  auto loader =
+      network::SimpleURLLoader::Create(std::move(request), kAnnotation);
+  loader->AttachStringForUpload(json, "application/json");
+  loader->SetTimeoutDuration(base::Seconds(3));
+  network::SimpleURLLoader* loader_ptr = loader.get();
+  loader_ptr->DownloadToString(
+      factory,
+      base::BindOnce(
+          [](std::unique_ptr<network::SimpleURLLoader> owned_loader,
+             std::optional<std::string> body) {
+            // The response body (or a null body on failure) is
+            // ignored; |owned_loader| is destroyed here, once the
+            // request has completed.
+          },
+          std::move(loader)),
+      1024);
+}
+
+// Builds the "tabs" array: one entry per tab in normal,
+// non-off-the-record browser windows. Incognito windows are
+// excluded entirely because tab titles and URLs are private.
+//
+// memory_bytes is the private memory footprint of the renderer
+// process hosting the tab's primary main frame. This is a
+// per-process value: tabs sharing a renderer process (same site,
+// not yet isolated into their own processes, etc.) each report
+// that process's full footprint, so the numbers are an
+// approximation of per-tab cost, not an exact split.
+base::ListValue CollectTabs() {
+  base::ListValue tabs;
+  std::map<base::ProcessHandle, uint64_t> memory_by_pid;
+  GlobalBrowserCollection::GetInstance()->ForEach(
+      [&tabs, &memory_by_pid](BrowserWindowInterface* browser) {
+        Profile* profile = browser->GetProfile();
+        if (browser->GetType() !=
+                BrowserWindowInterface::Type::TYPE_NORMAL ||
+            !profile || profile->IsOffTheRecord()) {
+          return true;
+        }
+        TabStripModel* model = browser->GetTabStripModel();
+        if (!model) {
+          return true;
+        }
+        for (int i = 0; i < model->count(); ++i) {
+          content::WebContents* web_contents = model->GetWebContentsAt(i);
+          if (!web_contents) {
+            continue;
+          }
+          base::DictValue tab;
+          tab.Set("title", base::UTF16ToUTF8(web_contents->GetTitle()));
+          tab.Set("url", web_contents->GetLastCommittedURL().spec());
+          uint64_t memory_bytes = 0;
+          if (content::RenderFrameHost* frame =
+                  web_contents->GetPrimaryMainFrame()) {
+            if (content::RenderProcessHost* host = frame->GetProcess()) {
+              const base::Process& process = host->GetProcess();
+              if (process.IsValid()) {
+                const base::ProcessHandle pid = process.Handle();
+                auto [it, inserted] = memory_by_pid.try_emplace(pid, 0);
+                if (inserted) {
+                  if (std::unique_ptr<base::ProcessMetrics> metrics =
+                          base::ProcessMetrics::CreateProcessMetrics(pid)) {
+                    if (auto info = metrics->GetMemoryInfo();
+                        info.has_value()) {
+#if BUILDFLAG(IS_WIN)
+                      // ProcessMemoryInfo::private_bytes only
+                      // exists on Windows; elsewhere a tab's
+                      // memory is reported as 0.
+                      it->second = info->private_bytes;
+#endif
+                    }
+                  }
+                }
+                memory_bytes = it->second;
+              }
+            }
+          }
+          tab.Set("memory_bytes", static_cast<double>(memory_bytes));
+          tabs.Append(std::move(tab));
+        }
+        return true;
+      });
+  return tabs;
+}
+
+// Observes browser and tab strip changes for the whole session and
+// sends "tabs" events: debounced (1 second) after tab-related
+// changes, and every 5 seconds regardless. Leaked intentionally
+// (base::NoDestructor in StartSession's helper below): it must live
+// until the process exits, and its timer simply stops being
+// serviced during shutdown.
+class SessionReporter : public BrowserCollectionObserver,
+                        public TabStripModelObserver {
+ public:
+  SessionReporter() = default;
+  SessionReporter(const SessionReporter&) = delete;
+  SessionReporter& operator=(const SessionReporter&) = delete;
+
+  void Start() {
+    if (started_) {
+      return;
+    }
+    started_ = true;
+    GlobalBrowserCollection* collection =
+        GlobalBrowserCollection::GetInstance();
+    collection_observation_.Observe(collection);
+    collection->ForEach([this](BrowserWindowInterface* browser) {
+      ObserveBrowser(browser);
+      return true;
+    });
+    tabs_timer_.Start(FROM_HERE, base::Seconds(5),
+                      base::BindRepeating(&SessionReporter::SendTabs,
+                                          base::Unretained(this)));
+    ScheduleTabsSend();
+  }
+
+  // BrowserCollectionObserver:
+  void OnBrowserCreated(BrowserWindowInterface* browser) override {
+    ObserveBrowser(browser);
+    ScheduleTabsSend();
+  }
+  void OnBrowserClosed(BrowserWindowInterface* browser) override {
+    ScheduleTabsSend();
+  }
+
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(
+      TabStripModel* tab_strip_model,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override {
+    ScheduleTabsSend();
+  }
+  void OnTabChangedAt(tabs::TabInterface* tab,
+                      TabChangeType change_type) override {
+    ScheduleTabsSend();
+  }
+  void OnTabStripModelDestroyed(TabStripModel* tab_strip_model) override {
+    observed_models_.erase(tab_strip_model);
+  }
+
+  void SendTabs() {
+    pending_tabs_send_ = false;
+    base::DictValue payload;
+    payload.Set("type", "tabs");
+    payload.Set("tabs", CollectTabs());
+    PostJson(std::move(payload));
+  }
+
+ private:
+  void ObserveBrowser(BrowserWindowInterface* browser) {
+    Profile* profile = browser->GetProfile();
+    if (browser->GetType() != BrowserWindowInterface::Type::TYPE_NORMAL ||
+        !profile || profile->IsOffTheRecord()) {
+      return;
+    }
+    if (TabStripModel* model = browser->GetTabStripModel()) {
+      if (observed_models_.insert(model).second) {
+        model->AddObserver(this);
+      }
+    }
+  }
+
+  void ScheduleTabsSend() {
+    if (pending_tabs_send_) {
+      return;
+    }
+    pending_tabs_send_ = true;
+    base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(&SessionReporter::SendTabs, base::Unretained(this)),
+        base::Seconds(1));
+  }
+
+  bool started_ = false;
+  bool pending_tabs_send_ = false;
+  base::ScopedObservation<GlobalBrowserCollection,
+                          BrowserCollectionObserver>
+      collection_observation_{this};
+  std::set<TabStripModel*> observed_models_;
+  base::RepeatingTimer tabs_timer_;
+};
+
+SessionReporter* GetSessionReporter() {
+  static base::NoDestructor<SessionReporter> reporter;
+  return reporter.get();
+}
+
+void AppendFeatureIfEnabled(base::ListValue* list,
+                            const base::Feature& feature) {
+  if (base::FeatureList::IsEnabled(feature)) {
+    list->Append(feature.name);
+  }
+}
+
+}  // namespace
+
+void StartSession() {
+  if (!IsEnabled()) {
+    return;
+  }
+  base::DictValue payload;
+  payload.Set("type", "startup");
+  payload.Set("version",
+              std::string(version_info::GetVersionNumber()));
+  base::FilePath user_data_dir;
+  if (base::PathService::Get(chrome::DIR_USER_DATA, &user_data_dir)) {
+    payload.Set("user_data_dir", user_data_dir.AsUTF8Unsafe());
+  }
+  std::string profile_name;
+  if (ProfileManager* profile_manager =
+          g_browser_process->profile_manager()) {
+    if (Profile* profile = profile_manager->GetLastUsedProfileIfLoaded()) {
+      profile_name = profile->GetProfileUserName();
+    }
+  }
+  payload.Set("profile_name", profile_name);
+  base::ListValue enabled_features;
+  AppendFeatureIfEnabled(&enabled_features, features::kLumoGlicMenu);
+  AppendFeatureIfEnabled(&enabled_features,
+                         features::kLumoHoverCardMemoryUsage);
+  AppendFeatureIfEnabled(&enabled_features, features::kLumoDarkModeSchedule);
+  AppendFeatureIfEnabled(&enabled_features,
+                         features::kLumoTrackingProtectionStrict);
+  AppendFeatureIfEnabled(&enabled_features, features::kLumoFullPageScreenshot);
+  AppendFeatureIfEnabled(&enabled_features,
+                         features::kLumoTabGroupSessionSave);
+  AppendFeatureIfEnabled(&enabled_features,
+                         features::kLumoLaunchThoriumProfile);
+  payload.Set("enabled_features", std::move(enabled_features));
+  PostJson(std::move(payload));
+
+  GetSessionReporter()->Start();
+}
+
+void ReportRelaunch(const base::FilePath& target_exe,
+                    bool used_fallback,
+                    bool success) {
+  if (!IsEnabled()) {
+    return;
+  }
+  base::DictValue payload;
+  payload.Set("type", "relaunch");
+  payload.Set("target_exe", target_exe.AsUTF8Unsafe());
+  payload.Set("used_fallback", used_fallback);
+  payload.Set("success", success);
+  PostJson(std::move(payload));
+}
+
+void ReportShutdown() {
+  if (!IsEnabled()) {
+    return;
+  }
+  base::DictValue payload;
+  payload.Set("type", "shutdown");
+  PostJson(std::move(payload));
+}
+
+}  // namespace lumo::debugger
