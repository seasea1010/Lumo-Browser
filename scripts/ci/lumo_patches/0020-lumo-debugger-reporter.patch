+
+#ifndef CHROME_BROWSER_LUMO_LUMO_DEBUGGER_REPORTER_H_
+#define CHROME_BROWSER_LUMO_LUMO_DEBUGGER_REPORTER_H_
+
+namespace base {
+class FilePath;
+}  // namespace base
+
+namespace lumo::debugger {
+
+// Command-line switch carrying the Lumo debugger app's event
+// endpoint, e.g. --lumo-debugger-endpoint=http://127.0.0.1:47741/event.
+// Only sessions launched with this switch (i.e. by the debugger app
+// itself) ever send events; a normally launched session sends
+// nothing at all.
+inline constexpr char kEndpointSwitch[] = "lumo-debugger-endpoint";
+
+// True when the current process was launched with a
+// --lumo-debugger-endpoint value that validates as the debugger
+// app's own loopback endpoint (http scheme, host 127.0.0.1,
+// localhost, or ::1, port 47741). Any other value, including
+// a remote URL, leaves the reporter disabled.
+bool IsEnabled();
+
+// Sends the "startup" event (version, user data directory, profile
+// name, enabled Lumo features) and, for the rest of the session,
+// observes tab changes and periodically sends "tabs" events.
+// Called once from ChromeBrowserMainParts::PostBrowserStart().
+// No-op when the endpoint switch is absent.
+void StartSession();
+
+// Sends the "relaunch" event: |target_exe| is the executable the
+// relaunch tried to start, |used_fallback| whether patch 0014's
+// fallback to the running executable kicked in, and |success|
+// whether the new process was created. No-op when disabled.
+void ReportRelaunch(const base::FilePath& target_exe,
+                    bool used_fallback,
+                    bool success);
+
+// Sends the "shutdown" event (type only). Called from
+// ChromeBrowserMainParts::PostMainMessageLoopRun(). Fire-and-
+// forget: this late in shutdown the network stack may already be
+// going away, so delivery is best effort. No-op when disabled.
+void ReportShutdown();
+
+}  // namespace lumo::debugger
+
+#endif  // CHROME_BROWSER_LUMO_LUMO_DEBUGGER_REPORTER_H_
