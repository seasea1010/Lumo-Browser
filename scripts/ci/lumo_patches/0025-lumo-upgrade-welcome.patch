+// Copyright 2026 seasea1010
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_LUMO_LUMO_UPGRADE_WELCOME_H_
+#define CHROME_BROWSER_LUMO_LUMO_UPGRADE_WELCOME_H_
+
+class Profile;
+
+namespace user_prefs {
+class PrefRegistrySyncable;
+}  // namespace user_prefs
+
+namespace lumo {
+
+// Profile pref recording the newest Lumo build whose welcome flow
+// (patch 0010) has been accounted for by this profile: either shown
+// (an existing profile after an upgrade) or covered by the
+// first-run experience itself (a new profile). It is compared
+// against the build number embedded at build time (see
+// lumo_build_config.h, generated by stage.py from the CI run
+// number); the product version string cannot key the decision
+// because it is identical across Lumo builds.
+inline constexpr char kWelcomeShownBuildNumberPref[] =
+    "lumo.welcome_shown_build_number";
+
+void RegisterProfilePrefs(user_prefs::PrefRegistrySyncable* registry);
+
+// True when the welcome flow should be shown for an existing
+// profile because the embedded build number is newer than the one
+// recorded in the profile. The current build number is recorded as
+// a side effect of returning true (mirroring
+// whats_new::ShouldShowForState), so the flow is offered once per
+// build even if the browser is closed before the window is seen.
+// Always false when no build number was embedded (0).
+bool ShouldShowUpgradeWelcome(Profile* profile);
+
+// Records the embedded build number as welcomed without showing
+// anything. Called for newly created profiles: they see the
+// welcome flow in the first-run experience, and this keeps the
+// upgrade path above from showing it a second time.
+void RecordWelcomeShownBuildNumber(Profile* profile);
+
+}  // namespace lumo
+
+#endif  // CHROME_BROWSER_LUMO_LUMO_UPGRADE_WELCOME_H_
