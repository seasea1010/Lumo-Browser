diff --git a/chrome/browser/lumo/lumo_upgrade_welcome.cc b/chrome/browser/lumo/lumo_upgrade_welcome.cc
new file mode 100644
index 0000000..447f903
--- /dev/null
+++ b/chrome/browser/lumo/lumo_upgrade_welcome.cc
@@ -0,0 +1,66 @@
+// Copyright 2026 seasea1010
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/lumo/lumo_upgrade_welcome.h"
+
+#include "chrome/browser/profiles/profile.h"
+#include "components/pref_registry/pref_registry_syncable.h"
+#include "components/prefs/pref_service.h"
+
+// Lumo (patch 0025): build-time configuration for the upgrade
+// welcome flow. scripts/ci/stage.py generates this header from the
+// LUMO_BUILD_NUMBER environment variable (the CI run number of the
+// build) during setup; it is deliberately not part of the source
+// tree (and not part of this patch), so a tree without it simply
+// builds with the upgrade welcome disabled.
+#if __has_include("chrome/browser/lumo/lumo_build_config.h")
+#include "chrome/browser/lumo/lumo_build_config.h"
+#define LUMO_BUILD_CONFIG_GENERATED 1
+#endif  // __has_include("chrome/browser/lumo/lumo_build_config.h")
+
+namespace lumo {
+namespace {
+
+int EmbeddedBuildNumber() {
+#if defined(LUMO_BUILD_CONFIG_GENERATED)
+  return kBuildNumber;
+#else
+  return 0;
+#endif
+}
+
+}  // namespace
+
+void RegisterProfilePrefs(user_prefs::PrefRegistrySyncable* registry) {
+  registry->RegisterIntegerPref(kWelcomeShownBuildNumberPref, 0);
+}
+
+bool ShouldShowUpgradeWelcome(Profile* profile) {
+  const int embedded = EmbeddedBuildNumber();
+  if (embedded <= 0) {
+    return false;
+  }
+  PrefService* prefs = profile->GetPrefs();
+  if (prefs->GetInteger(kWelcomeShownBuildNumberPref) >= embedded) {
+    return false;
+  }
+  // Record at decision time, like whats_new::ShouldShowForState:
+  // the welcome is offered once per build, even across relaunches
+  // where the tab might never have been looked at.
+  prefs->SetInteger(kWelcomeShownBuildNumberPref, embedded);
+  return true;
+}
+
+void RecordWelcomeShownBuildNumber(Profile* profile) {
+  const int embedded = EmbeddedBuildNumber();
+  if (embedded <= 0) {
+    return;
+  }
+  PrefService* prefs = profile->GetPrefs();
+  if (prefs->GetInteger(kWelcomeShownBuildNumberPref) < embedded) {
+    prefs->SetInteger(kWelcomeShownBuildNumberPref, embedded);
+  }
+}
+
+}  // namespace lumo
diff --git a/chrome/browser/lumo/lumo_upgrade_welcome.h b/chrome/browser/lumo/lumo_upgrade_welcome.h
new file mode 100644
index 0000000..7c2d143
--- /dev/null
+++ b/chrome/browser/lumo/lumo_upgrade_welcome.h
@@ -0,0 +1,46 @@
+// Copyright 2026 seasea1010
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_LUMO_LUMO_UPGRADE_WELCOME_H_
+#define CHROME_BROWSER_LUMO_LUMO_UPGRADE_WELCOME_H_
+
+class Profile;
+
+namespace user_prefs {
+class PrefRegistrySyncable;
+}  // namespace user_prefs
+
+namespace lumo {
+
+// Profile pref recording the newest Lumo build whose welcome flow
+// (patch 0010) has been accounted for by this profile: either shown
+// (an existing profile after an upgrade) or covered by the
+// first-run experience itself (a new profile). It is compared
+// against the build number embedded at build time (see
+// lumo_build_config.h, generated by stage.py from the CI run
+// number); the product version string cannot key the decision
+// because it is identical across Lumo builds.
+inline constexpr char kWelcomeShownBuildNumberPref[] =
+    "lumo.welcome_shown_build_number";
+
+void RegisterProfilePrefs(user_prefs::PrefRegistrySyncable* registry);
+
+// True when the welcome flow should be shown for an existing
+// profile because the embedded build number is newer than the one
+// recorded in the profile. The current build number is recorded as
+// a side effect of returning true (mirroring
+// whats_new::ShouldShowForState), so the flow is offered once per
+// build even if the browser is closed before the tab is seen.
+// Always false when no build number was embedded (0).
+bool ShouldShowUpgradeWelcome(Profile* profile);
+
+// Records the embedded build number as welcomed without showing
+// anything. Called for newly created profiles: they see the
+// welcome flow in the first-run experience, and this keeps the
+// upgrade path above from showing it a second time.
+void RecordWelcomeShownBuildNumber(Profile* profile);
+
+}  // namespace lumo
+
+#endif  // CHROME_BROWSER_LUMO_LUMO_UPGRADE_WELCOME_H_
