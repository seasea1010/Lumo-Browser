+
+// Lumo (patch 0025): resume callback for the upgrade welcome,
+// mirroring FirstRunService::OnFirstRunHasExited's status
+// mapping: the browser launch proceeds when the flow completed
+// (or finished with an intent to quit at the end), and is
+// abandoned when the user closed the welcome window or aborted
+// the flow — no window opens then and the process exits,
+// exactly like the FRE. ShouldShowUpgradeWelcome() recorded the
+// build number when the welcome was offered, so the recursive
+// LaunchBrowser() call takes the normal path and cannot loop.
+void OnLumoUpgradeWelcomeExited(
+    const base::CommandLine& command_line,
+    Profile* profile,
+    const base::FilePath& cur_dir,
+    const std::vector<GURL>& first_run_urls,
+    chrome::startup::IsProcessStartup process_startup,
+    chrome::startup::IsFirstRun is_first_run,
+    ProfilePicker::FirstRunExitStatus status,
+    ProfilePicker::FirstRunFinishReason finish_reason) {
+  if (status != ProfilePicker::FirstRunExitStatus::kCompleted &&
+      status != ProfilePicker::FirstRunExitStatus::kQuitAtEnd) {
+    return;
+  }
+  StartupBrowserCreator browser_creator;
+  browser_creator.AddFirstRunTabs(first_run_urls);
+  browser_creator.LaunchBrowser(command_line, profile, cur_dir,
+                                process_startup, is_first_run,
+                                /*restore_tabbed_browser=*/true);
 }
 #endif  // BUILDFLAG(ENABLE_DICE_SUPPORT)
 
