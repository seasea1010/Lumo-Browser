+      return;
+    }
+
+    // Lumo (patch 0025): after an upgrade to a newer Lumo build,
+    // show the welcome flow once for existing profiles — in the
+    // profile picker's dedicated window, hosted by
+    // FirstRunFlowController, and let
+    // `OnLumoUpgradeWelcomeExited()` handle the browser launch,
+    // exactly like the FRE above. The welcome is never a startup
+    // tab: hosted in a tab, the intro's sign-in buttons are dead
+    // (nothing wires the sign-in choice callback outside the
+    // picker host), which build #29's real-machine check proved.
+    if (!profile->IsNewProfile() && !profile->IsOffTheRecord() &&
+        lumo::ShouldShowUpgradeWelcome(profile)) {
+      ProfilePicker::Show(ProfilePicker::Params::ForLumoUpgradeWelcome(
+          profile->GetPath(),
+          base::BindOnce(&OnLumoUpgradeWelcomeExited, command_line,
+                         profile, cur_dir, first_run_tabs_,
+                         process_startup, is_first_run)));
       return;
     }
 #endif
