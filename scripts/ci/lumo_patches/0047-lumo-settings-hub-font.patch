+// Copyright 2026 seasea1010
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_LUMO_LUMO_UI_FONT_H_
+#define CHROME_BROWSER_LUMO_LUMO_UI_FONT_H_
+
+class Profile;
+
+namespace lumo {
+
+// Applies the UI font chosen on the Lumo font settings page
+// (chrome://settings/lumoFont, Lumo patch 0047) to the whole browser
+// UI. The chosen family is stored in the profile pref
+// prefs::kLumoUiFontFamily; when it is non-empty this installs it as
+// the default gfx::FontList description (keeping the platform
+// default size), which is the single base every toolkit-views
+// surface derives its font from: tabs, the toolbar, the omnibox,
+// menus, dialogs, bubbles, context menus and popups. Web content is
+// not affected: renderer font settings are never touched.
+//
+// gfx::FontList::SetDefaultFontDescription() must run before the
+// default FontList is first materialised for the window being
+// created, so this is called from
+// StartupBrowserCreatorImpl::DetermineStartupTabs(), before the
+// first browser window exists. Changing the pref therefore takes
+// full effect on the next launch; the font page says so and offers
+// a restart button. Does nothing when no font is chosen (the
+// platform default stays in charge) or for off-the-record profiles.
+void ApplyLumoUiFontOverride(Profile* profile);
+
+}  // namespace lumo
+
+#endif  // CHROME_BROWSER_LUMO_LUMO_UI_FONT_H_
