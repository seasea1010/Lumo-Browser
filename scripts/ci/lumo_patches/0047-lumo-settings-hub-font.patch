+// Copyright 2026 seasea1010
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import {html} from '//resources/lit/v3_0/lit.rollup.js';
+
+import type {SettingsLumoFontPageElement} from './lumo_font_page.js';
+
+export function getHtml(this: SettingsLumoFontPageElement) {
+  return html`<!--_html_template_start_-->
+<settings-section page-title="$i18n{lumoFontPageTitle}">
+  <div class="cr-row first">
+    <div class="flex cr-padded-text">
+      <div>$i18n{lumoFontUiLabel}</div>
+      <div class="secondary">$i18n{lumoFontUiDesc}</div>
+    </div>
+    ${this.info_ ? html`
+    <select id="lumoUiFontSelect" @change="${this.onFontChange_}"
+        aria-label="$i18n{lumoFontUiLabel}">
+      <option value=""
+          ?selected="${this.info_.currentFont === ''}">
+        $i18n{lumoFontDefaultOption}
+      </option>
+      ${this.info_.fonts.map(family => html`
+      <option value="${family}"
+          ?selected="${family === this.info_!.currentFont}">
+        ${family}
+      </option>`)}
+    </select>` : ''}
+  </div>
+  ${this.info_ ? html`
+  <div class="cr-row">
+    <div class="flex cr-padded-text">
+      <div>$i18n{lumoFontCurrentLabel}</div>
+      <div class="secondary">${this.currentFontText_()}</div>
+    </div>
+  </div>` : ''}
+  <div class="cr-row">
+    <cr-button id="lumoFontRestart" @click="${this.onRestartClick_}">
+      $i18n{lumoFontRestart}
+    </cr-button>
+  </div>
+</settings-section><!--_html_template_end_-->`;
+}
