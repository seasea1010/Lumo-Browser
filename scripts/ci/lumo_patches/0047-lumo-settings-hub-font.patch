@@ -100,0 +100,96 @@
+// Copyright 2026 seasea1010
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+/**
+ * @fileoverview 'settings-lumo-font-page' is the Lumo font settings
+ * page (Lumo patch 0047), reached from the Lumo hub page. It lets
+ * the user pick one of the fonts installed on this machine as the
+ * font for the whole browser UI (tabs, toolbar, omnibox, menus,
+ * dialogs, popups). The choice is stored by
+ * settings::LumoFontHandler in the profile pref
+ * prefs::kLumoUiFontFamily and applied at the next launch by
+ * lumo::ApplyLumoUiFontOverride() as the default FontList
+ * description, so it covers every toolkit-views surface at once.
+ * Web content fonts are never touched.
+ */
+
+import 'chrome://resources/cr_elements/cr_button/cr_button.js';
+import '../settings_page/settings_section.js';
+
+import {I18nMixinLit} from 'chrome://resources/cr_elements/i18n_mixin_lit.js';
+import {CrLitElement} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+
+import {LifetimeBrowserProxyImpl} from '../settings.js';
+
+import {getCss} from './lumo_font_page.css.js';
+import {getHtml} from './lumo_font_page.html.js';
+import type {LumoUiFontInfo} from './lumo_font_browser_proxy.js';
+import {LumoFontBrowserProxyImpl} from './lumo_font_browser_proxy.js';
+
+const SettingsLumoFontPageElementBase = I18nMixinLit(CrLitElement);
+
+export class SettingsLumoFontPageElement extends
+    SettingsLumoFontPageElementBase {
+  static get is() {
+    return 'settings-lumo-font-page';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      info_: {type: Object},
+    };
+  }
+
+  protected accessor info_: LumoUiFontInfo|null = null;
+
+  private browserProxy_ = LumoFontBrowserProxyImpl.getInstance();
+
+  override connectedCallback() {
+    super.connectedCallback();
+    this.browserProxy_.getLumoUiFontInfo().then(info => {
+      this.info_ = info;
+    });
+  }
+
+  protected onFontChange_(event: Event) {
+    const family = (event.target as HTMLSelectElement).value;
+    const request = family === '' ?
+        this.browserProxy_.resetLumoUiFont() :
+        this.browserProxy_.setLumoUiFont(family);
+    request.then(info => {
+      this.info_ = info;
+    });
+  }
+
+  protected onRestartClick_() {
+    LifetimeBrowserProxyImpl.getInstance().restart();
+  }
+
+  protected currentFontText_(): string {
+    if (!this.info_ || this.info_.currentFont === '') {
+      return this.info_ ?
+          `${this.i18n('lumoFontDefaultOption')} (${
+              this.info_.platformDefault})` :
+          '';
+    }
+    return this.info_.currentFont;
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'settings-lumo-font-page': SettingsLumoFontPageElement;
+  }
+}
