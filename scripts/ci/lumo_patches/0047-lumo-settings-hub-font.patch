@@ -100,0 +100,53 @@
+// Copyright 2026 seasea1010
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import {sendWithPromise} from 'chrome://resources/js/cr.js';
+
+/**
+ * @fileoverview Browser proxy for the Lumo font settings page
+ * (Lumo patch 0047).
+ */
+
+/**
+ * State of the UI font setting, mirroring the dictionary built by
+ * settings::LumoFontHandler.
+ */
+export interface LumoUiFontInfo {
+  /** The chosen font family, or '' for the platform default. */
+  currentFont: string;
+  /** The platform default font family (for display only). */
+  platformDefault: string;
+  /** Font families installed on this machine, sorted by name. */
+  fonts: string[];
+}
+
+export interface LumoFontBrowserProxy {
+  getLumoUiFontInfo(): Promise<LumoUiFontInfo>;
+  setLumoUiFont(family: string): Promise<LumoUiFontInfo>;
+  resetLumoUiFont(): Promise<LumoUiFontInfo>;
+}
+
+export class LumoFontBrowserProxyImpl implements LumoFontBrowserProxy {
+  getLumoUiFontInfo() {
+    return sendWithPromise<LumoUiFontInfo>('getLumoUiFontInfo');
+  }
+
+  setLumoUiFont(family: string) {
+    return sendWithPromise<LumoUiFontInfo>('setLumoUiFont', family);
+  }
+
+  resetLumoUiFont() {
+    return sendWithPromise<LumoUiFontInfo>('resetLumoUiFont');
+  }
+
+  static getInstance(): LumoFontBrowserProxy {
+    return instance || (instance = new LumoFontBrowserProxyImpl());
+  }
+
+  static setInstance(obj: LumoFontBrowserProxy) {
+    instance = obj;
+  }
+}
+
+let instance: LumoFontBrowserProxy|null = null;
