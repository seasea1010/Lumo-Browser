+// Copyright 2026 seasea1010
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_WEBUI_SETTINGS_LUMO_FONT_HANDLER_H_
+#define CHROME_BROWSER_UI_WEBUI_SETTINGS_LUMO_FONT_HANDLER_H_
+
+#include <string>
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "base/values.h"
+#include "chrome/browser/ui/webui/settings/settings_page_ui_handler.h"
+
+class Profile;
+
+namespace settings {
+
+// WebUI message handler for the Lumo font settings page
+// (Lumo patch 0047). Serves three requests:
+//   "getLumoUiFontInfo" - the current choice plus the font
+//       families installed on this machine (enumerated from the
+//       OS: EnumFontFamiliesEx on Windows);
+//   "setLumoUiFont"     - stores a chosen family in the profile
+//       pref prefs::kLumoUiFontFamily (validated against the
+//       enumerated list, so the page cannot store arbitrary
+//       strings);
+//   "resetLumoUiFont"   - clears the pref (platform default).
+// The pref is applied to the whole browser UI at the next launch
+// by lumo::ApplyLumoUiFontOverride(); this handler never touches
+// renderer (web content) font settings.
+class LumoFontHandler : public SettingsPageUIHandler {
+ public:
+  explicit LumoFontHandler(Profile* profile);
+
+  LumoFontHandler(const LumoFontHandler&) = delete;
+  LumoFontHandler& operator=(const LumoFontHandler&) = delete;
+
+  ~LumoFontHandler() override;
+
+  // SettingsPageUIHandler:
+  void RegisterMessages() override;
+  void OnJavascriptAllowed() override;
+  void OnJavascriptDisallowed() override;
+
+ private:
+  // Font families installed on this machine, sorted, without the
+  // vertical-writing "@"-prefixed aliases EnumFontFamiliesEx also
+  // reports. Empty off Windows (Lumo ships for Windows only).
+  static std::vector<std::string> EnumerateInstalledFonts();
+
+  base::DictValue BuildInfo();
+
+  void HandleGetLumoUiFontInfo(const base::ListValue& args);
+  void HandleSetLumoUiFont(const base::ListValue& args);
+  void HandleResetLumoUiFont(const base::ListValue& args);
+
+  const raw_ptr<Profile> profile_;
+};
+
+}  // namespace settings
+
+#endif  // CHROME_BROWSER_UI_WEBUI_SETTINGS_LUMO_FONT_HANDLER_H_
diff --git a/chrome/browser/ui/webui/settings/lumo_font_handler.cc b/chrome/browser/ui/webui/settings/lumo_font_handler.cc
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/chrome/browser/ui/webui/settings/lumo_font_handler.cc
@@ -100,0 +100,133 @@
+// Copyright 2026 seasea1010
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/settings/lumo_font_handler.h"
+
+#include <algorithm>
+#include <set>
+#include <string>
+#include <utility>
+
+#include "base/check.h"
+#include "base/functional/bind.h"
+#include "base/strings/utf_string_conversions.h"
+#include "build/build_config.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/common/pref_names.h"
+#include "components/prefs/pref_service.h"
+#include "ui/gfx/font.h"
+
+#if BUILDFLAG(IS_WIN)
+#include <windows.h>
+#endif  // BUILDFLAG(IS_WIN)
+
+namespace settings {
+
+namespace {
+
+#if BUILDFLAG(IS_WIN)
+// EnumFontFamiliesEx callback: collects the face name of every
+// enumerated font family into |families| (a std::set<std::string>
+// passed as LPARAM). The "@"-prefixed names are vertical-writing
+// aliases of the same families, not separate fonts, and are
+// skipped.
+int CALLBACK CollectFontFamily(const LOGFONTW* log_font,
+                               const TEXTMETRICW* text_metric,
+                               DWORD font_type,
+                               LPARAM param) {
+  auto* families = reinterpret_cast<std::set<std::string>*>(param);
+  const std::wstring face_name(log_font->lfFaceName);
+  if (!face_name.empty() && face_name.front() != L'@') {
+    families->insert(base::WideToUTF8(face_name));
+  }
+  return 1;
+}
+#endif  // BUILDFLAG(IS_WIN)
+
+}  // namespace
+
+LumoFontHandler::LumoFontHandler(Profile* profile) : profile_(profile) {}
+
+LumoFontHandler::~LumoFontHandler() = default;
+
+void LumoFontHandler::RegisterMessages() {
+  web_ui()->RegisterMessageCallback(
+      "getLumoUiFontInfo",
+      base::BindRepeating(&LumoFontHandler::HandleGetLumoUiFontInfo,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "setLumoUiFont",
+      base::BindRepeating(&LumoFontHandler::HandleSetLumoUiFont,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "resetLumoUiFont",
+      base::BindRepeating(&LumoFontHandler::HandleResetLumoUiFont,
+                          base::Unretained(this)));
+}
+
+void LumoFontHandler::OnJavascriptAllowed() {}
+
+void LumoFontHandler::OnJavascriptDisallowed() {}
+
+// static
+std::vector<std::string> LumoFontHandler::EnumerateInstalledFonts() {
+  std::set<std::string> families;
+#if BUILDFLAG(IS_WIN)
+  LOGFONTW log_font = {};
+  log_font.lfCharSet = DEFAULT_CHARSET;
+  HDC dc = ::GetDC(nullptr);
+  if (dc) {
+    ::EnumFontFamiliesExW(dc, &log_font, &CollectFontFamily,
+                          reinterpret_cast<LPARAM>(&families), 0);
+    ::ReleaseDC(nullptr, dc);
+  }
+#endif  // BUILDFLAG(IS_WIN)
+  return std::vector<std::string>(families.begin(), families.end());
+}
+
+base::DictValue LumoFontHandler::BuildInfo() {
+  base::DictValue info;
+  info.Set("currentFont",
+           profile_->GetPrefs()->GetString(prefs::kLumoUiFontFamily));
+  info.Set("platformDefault", gfx::Font().GetFontName());
+  base::ListValue fonts;
+  for (const std::string& family : EnumerateInstalledFonts()) {
+    fonts.Append(family);
+  }
+  info.Set("fonts", std::move(fonts));
+  return info;
+}
+
+void LumoFontHandler::HandleGetLumoUiFontInfo(
+    const base::ListValue& args) {
+  AllowJavascript();
+  CHECK_EQ(1U, args.size());
+  ResolveJavascriptCallback(args[0], base::Value(BuildInfo()));
+}
+
+void LumoFontHandler::HandleSetLumoUiFont(const base::ListValue& args) {
+  AllowJavascript();
+  CHECK_EQ(2U, args.size());
+  const std::string* family = args[1].GetIfString();
+  if (family && !family->empty()) {
+    // Only families the OS actually reports may be stored, so the
+    // pref always names a font the FontList override can resolve.
+    const std::vector<std::string> installed = EnumerateInstalledFonts();
+    if (std::find(installed.begin(), installed.end(), *family) !=
+        installed.end()) {
+      profile_->GetPrefs()->SetString(prefs::kLumoUiFontFamily, *family);
+    }
+  }
+  ResolveJavascriptCallback(args[0], base::Value(BuildInfo()));
+}
+
+void LumoFontHandler::HandleResetLumoUiFont(
+    const base::ListValue& args) {
+  AllowJavascript();
+  CHECK_EQ(1U, args.size());
+  profile_->GetPrefs()->ClearPref(prefs::kLumoUiFontFamily);
+  ResolveJavascriptCallback(args[0], base::Value(BuildInfo()));
+}
+
+}  // namespace settings
