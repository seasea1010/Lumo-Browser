new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/chrome/browser/lumo/lumo_ui_font.cc
@@ -100,0 +100,41 @@
+// Copyright 2026 seasea1010
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/lumo/lumo_ui_font.h"
+
+#include <string>
+
+#include "base/strings/string_number_conversions.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/common/pref_names.h"
+#include "components/prefs/pref_service.h"
+#include "ui/gfx/font.h"
+#include "ui/gfx/font_list.h"
+
+namespace lumo {
+
+void ApplyLumoUiFontOverride(Profile* profile) {
+  if (!profile || profile->IsOffTheRecord()) {
+    return;
+  }
+  const std::string family =
+      profile->GetPrefs()->GetString(prefs::kLumoUiFontFamily);
+  if (family.empty()) {
+    return;
+  }
+  // Keep the platform default size (and, through FontList's own
+  // derivation, every relative size the UI uses); only the family
+  // changes. A FontList description is "<family list> <size>px",
+  // and a family name never contains a comma, so the chosen family
+  // can be used verbatim.
+  const gfx::Font default_font;
+  const int size_pixels = default_font.GetFontSize();
+  if (size_pixels <= 0) {
+    return;
+  }
+  gfx::FontList::SetDefaultFontDescription(
+      family + " " + base::NumberToString(size_pixels) + "px");
+}
+
+}  // namespace lumo
