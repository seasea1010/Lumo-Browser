+std::optional<std::pair<std::string, std::string>> ParseRepoInput(
+    std::string_view input) {
+  std::string text(base::TrimWhitespaceASCII(input, base::TRIM_ALL));
+  constexpr std::string_view kPrefix = "https://github.com/";
+  constexpr std::string_view kPrefixHttp = "http://github.com/";
+  if (base::StartsWith(text, kPrefix)) {
+    text = text.substr(kPrefix.size());
+  } else if (base::StartsWith(text, kPrefixHttp)) {
+    text = text.substr(kPrefixHttp.size());
+  } else if (text.find("://") != std::string::npos ||
+             text.find('@') != std::string::npos) {
+    return std::nullopt;
+  }
+  base::TrimString(text, "/", &text);
+  if (base::EndsWith(text, ".git")) {
+    text = text.substr(0, text.size() - 4);
+  }
+  std::vector<std::string> parts = base::SplitString(
+      text, "/", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+  if (parts.size() != 2 || !IsValidRepoComponent(parts[0]) ||
+      !IsValidRepoComponent(parts[1])) {
+    return std::nullopt;
+  }
+  return std::make_pair(parts[0], parts[1]);
+}
+
+bool IsCheckDue(int interval_hours, double last_check_unix, double now_unix) {
+  if (interval_hours <= 0) {
+    return false;
+  }
+  return now_unix - last_check_unix >= interval_hours * 3600.0;
+}
+
+bool IsNewerVersion(std::string_view candidate, std::string_view current) {
+  base::Version candidate_version(candidate);
+  if (!candidate_version.IsValid()) {
+    return false;
+  }
+  if (current.empty()) {
+    return true;
+  }
+  base::Version current_version(current);
+  return current_version.IsValid() &&
+         candidate_version.CompareTo(current_version) > 0;
+}
+
+std::optional<std::string> DeriveExtensionIdFromCrx(
+    std::string_view crx_bytes) {
+  // CRX3 layout: "Cr24" magic, uint32 format version (3), uint32
+  // header length, then the CrxFileHeader protobuf whose first RSA
+  // proof carries the signing public key (SPKI DER).
+  if (crx_bytes.size() < 12 || crx_bytes.substr(0, 4) != "Cr24") {
+    return std::nullopt;
+  }
+  auto read_u32 = [&crx_bytes](size_t offset) {
+    return static_cast<uint32_t>(static_cast<uint8_t>(crx_bytes[offset])) |
+           (static_cast<uint32_t>(static_cast<uint8_t>(crx_bytes[offset + 1]))
+            << 8) |
+           (static_cast<uint32_t>(static_cast<uint8_t>(crx_bytes[offset + 2]))
+            << 16) |
+           (static_cast<uint32_t>(static_cast<uint8_t>(crx_bytes[offset + 3]))
+            << 24);
+  };
+  if (read_u32(4) != 3) {
+    return std::nullopt;
+  }
+  const uint32_t header_len = read_u32(8);
+  if (12 + static_cast<size_t>(header_len) > crx_bytes.size()) {
+    return std::nullopt;
+  }
+  crx_file::CrxFileHeader header;
+  if (!header.ParseFromArray(crx_bytes.data() + 12, header_len) ||
+      header.sha256_with_rsa_size() == 0 ||
+      header.sha256_with_rsa(0).public_key().empty()) {
+    return std::nullopt;
+  }
+  return crx_file::id_util::GenerateId(
+      header.sha256_with_rsa(0).public_key());
+}
+
+struct LumoGithubExtensionUpdater::PendingInstall
+    : public base::RefCounted<PendingInstall> {
+  std::string extension_id;
+  std::string repo;
+  std::string tag;
+  std::string asset;
+  int interval_hours = kIntervalDefaultHours;
+  bool is_update = false;
+  AddCallback add_callback;
+};
+
+LumoGithubExtensionUpdater::LumoGithubExtensionUpdater(Profile* profile)
+    : profile_(profile) {
+  if (auto* registry = extensions::ExtensionRegistry::Get(profile_)) {
+    registry_observation_.Observe(registry);
+  }
+  check_timer_.Start(FROM_HERE, base::Hours(1),
+                     base::BindRepeating(
+                         &LumoGithubExtensionUpdater::CheckForUpdates,
+                         weak_factory_.GetWeakPtr(), /*startup=*/false));
+  // Startup check, delayed so the network stack and the extension
+  // service are up; startup checks ignore the per-entry interval.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&LumoGithubExtensionUpdater::CheckForUpdates,
+                     weak_factory_.GetWeakPtr(), /*startup=*/true),
+      base::Seconds(20));
+}
+
+LumoGithubExtensionUpdater::~LumoGithubExtensionUpdater() = default;
+
+void LumoGithubExtensionUpdater::Shutdown() {
+  check_timer_.Stop();
+  pending_installs_.clear();
+}
+
+void LumoGithubExtensionUpdater::FetchLatestRelease(
+    std::string repo_input,
+    FetchCallback callback) {
+  auto parsed = ParseRepoInput(repo_input);
+  if (!parsed) {
+    std::move(callback).Run(std::nullopt, "invalid repository");
+    return;
+  }
+  const GURL url(kGithubApiBase + parsed->first + "/" + parsed->second +
+                 "/releases/latest");
+  GetJson(url, base::BindOnce(
+                   [](FetchCallback callback,
+                      std::optional<std::string> body) {
+                     if (!body) {
+                       std::move(callback).Run(std::nullopt,
+                                               "network error");
+                       return;
+                     }
+                     std::optional<ReleaseInfo> info =
+                         ParseReleaseJson(*body);
+                     if (!info) {
+                       std::move(callback).Run(
+                           std::nullopt, "no release found");
+                       return;
+                     }
+                     if (info->crx_assets.empty()) {
+                       std::move(callback).Run(
+                           std::nullopt,
+                           "the latest release has no .crx asset");
+                       return;
+                     }
+                     std::move(callback).Run(std::move(info), "");
+                   },
+                   std::move(callback)));
+}
+
+void LumoGithubExtensionUpdater::AddExtension(std::string repo_input,
+                                              std::string asset_name,
+                                              int interval_hours,
+                                              AddCallback callback) {
+  auto parsed = ParseRepoInput(repo_input);
+  if (!parsed) {
+    std::move(callback).Run(false, "invalid repository");
+    return;
+  }
+  FetchLatestRelease(
+      repo_input,
+      base::BindOnce(&LumoGithubExtensionUpdater::OnReleaseForAdd,
+                     weak_factory_.GetWeakPtr(),
+                     parsed->first + "/" + parsed->second, asset_name,
+                     interval_hours, std::move(callback)));
+}
+
+void LumoGithubExtensionUpdater::OnReleaseForAdd(
+    std::string repo,
+    std::string asset_name,
+    int interval_hours,
+    AddCallback callback,
+    std::optional<ReleaseInfo> release,
+    std::string error) {
+  if (!release) {
+    std::move(callback).Run(false, error);
+    return;
+  }
+  const ReleaseAsset* chosen = nullptr;
+  for (const ReleaseAsset& asset : release->crx_assets) {
+    if (asset.name == asset_name) {
+      chosen = &asset;
+      break;
+    }
+  }
+  if (!chosen) {
+    std::move(callback).Run(false, "asset not found in the latest release");
+    return;
+  }
+  auto pending = base::MakeRefCounted<PendingInstall>();
+  pending->repo = repo;
+  pending->tag = release->tag;
+  pending->asset = asset_name;
+  pending->interval_hours = interval_hours;
+  pending->is_update = false;
+  pending->add_callback = std::move(callback);
+  DownloadCrx(chosen->download_url,
+              base::BindOnce(&LumoGithubExtensionUpdater::VerifyAndInstall,
+                             weak_factory_.GetWeakPtr(), pending));
+}
+
+void LumoGithubExtensionUpdater::DownloadCrx(
+    std::string download_url,
+    base::OnceCallback<void(std::optional<std::string> crx_bytes,
+                            std::string error)> callback) {
+  GetJson(GURL(download_url),
+          base::BindOnce(
+              [](base::OnceCallback<void(std::optional<std::string>,
+                                         std::string)> callback,
+                 std::optional<std::string> body) {
+                if (!body) {
+                  std::move(callback).Run(std::nullopt, "download failed");
+                  return;
+                }
+                std::move(callback).Run(std::move(body), "");
+              },
+              std::move(callback)));
+}
+
+void LumoGithubExtensionUpdater::VerifyAndInstall(
+    scoped_refptr<PendingInstall> pending,
+    std::optional<std::string> crx_bytes,
+    std::string error) {
+  if (!crx_bytes) {
+    FinishInstall(pending->extension_id, /*success=*/false);
+    if (pending->add_callback) {
+      std::move(pending->add_callback).Run(false, error);
+    } else {
+      NotifyUser(pending->extension_id, /*updated=*/false, error);
+    }
+    return;
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&VerifyCrxBytes, std::move(*crx_bytes),
+                     profile_->GetPath()),
+      base::BindOnce(
+          [](scoped_refptr<PendingInstall> pending,
+             base::WeakPtr<LumoGithubExtensionUpdater> self,
+             CrxVerification verification) {
+            if (!self) {
+              return;
+            }
+            // Verification (b): the package must parse, and for an
+            // update its derived ID must equal the registered ID
+            // (same signing key) and its manifest version must be
+            // strictly newer than the installed one.
+            if (!verification.error.empty()) {
+              self->FinishInstall(pending->extension_id, false);
+              if (pending->add_callback) {
+                std::move(pending->add_callback)
+                    .Run(false, verification.error);
+              } else {
+                self->NotifyUser(pending->extension_id, false,
+                                 verification.error);
+              }
+              return;
+            }
+            pending->extension_id = verification.extension_id;
+            if (pending->is_update) {
+              const extensions::Extension* installed =
+                  extensions::ExtensionRegistry::Get(self->profile_)
+                      ->GetInstalledExtension(pending->extension_id);
+              const std::string current =
+                  installed ? installed->VersionString() : "";
+              if (current.empty() ||
+                  !IsNewerVersion(verification.version, current)) {
+                self->FinishInstall(pending->extension_id, false);
+                self->NotifyUser(pending->extension_id, false,
+                                 "not newer than the installed version");
+                return;
+              }
+            }
+            // The verified bytes are already stored in the
+            // profile (VerifyCrxBytes); CrxInstaller reads them
+            // from there and re-verifies the CRX3 signature itself
+            // before anything is applied.
+            scoped_refptr<extensions::CrxInstaller> installer(
+                extensions::CrxInstaller::CreateSilent(self->profile_));
+            self->pending_installs_[pending->extension_id] = pending;
+            installer->InstallCrxFile(extensions::CRXFileInfo(
+                verification.crx_path, crx_file::VerifierFormat::CRX3));
+          pending, weak_factory_.GetWeakPtr()));
+}
+
+void LumoGithubExtensionUpdater::FinishInstall(
+    const std::string& extension_id,
+    bool success) {
+  pending_installs_.erase(extension_id);
+}
+
+void LumoGithubExtensionUpdater::OnExtensionInstalled(
+    content::BrowserContext* browser_context,
+    const extensions::Extension* extension,
+    bool is_update) {
+  auto it = pending_installs_.find(extension->id());
+  if (it == pending_installs_.end()) {
+    return;
+  }
+  scoped_refptr<PendingInstall> pending = it->second;
+  pending_installs_.erase(it);
+  SaveEntry(extension->id(), pending->repo, pending->tag,
+            extension->VersionString(), pending->asset,
+            pending->interval_hours);
+  if (pending->add_callback) {
+    std::move(pending->add_callback).Run(true, extension->id());
+  } else {
+    NotifyUser(extension->id(), /*updated=*/true, pending->tag);
+  }
+}
+
+void LumoGithubExtensionUpdater::OnExtensionUninstalled(
+    content::BrowserContext* browser_context,
+    const extensions::Extension* extension,
+    extensions::UninstallReason reason) {
+  // Uninstalling a GitHub-managed extension also drops its
+  // registration, so it is never silently reinstalled.
+  PrefService* prefs = profile_->GetPrefs();
+  base::DictValue entries = prefs->GetDict(prefs::kLumoGithubExtensions).Clone();
+  if (entries.Remove(extension->id())) {
+    prefs->SetDict(prefs::kLumoGithubExtensions, std::move(entries));
+  }
+}
+
+void LumoGithubExtensionUpdater::SaveEntry(const std::string& extension_id,
+                                           const std::string& repo,
+                                           const std::string& tag,
+                                           const std::string& version,
+                                           const std::string& asset,
+                                           int interval_hours) {
+  PrefService* prefs = profile_->GetPrefs();
+  base::DictValue entries =
+      prefs->GetDict(prefs::kLumoGithubExtensions).Clone();
+  base::DictValue entry;
+  entry.Set("repo", repo);
+  entry.Set("tag", tag);
+  entry.Set("version", version);
+  entry.Set("asset", asset);
+  entry.Set("interval_hours", interval_hours);
+  entry.Set("last_check_unix",
+            base::Time::Now().InSecondsFSinceUnixEpoch());
+  entries.Set(extension_id, std::move(entry));
+  prefs->SetDict(prefs::kLumoGithubExtensions, std::move(entries));
+}
+
+void LumoGithubExtensionUpdater::SetUpdateInterval(
+    const std::string& extension_id,
+    int interval_hours) {
+  PrefService* prefs = profile_->GetPrefs();
+  base::DictValue entries =
+      prefs->GetDict(prefs::kLumoGithubExtensions).Clone();
+  base::DictValue* entry = entries.FindDict(extension_id);
+  if (!entry) {
+    return;
+  }
+  entry->Set("interval_hours", interval_hours);
+  prefs->SetDict(prefs::kLumoGithubExtensions, std::move(entries));
+}
+
+bool LumoGithubExtensionUpdater::IsGithubManaged(
+    const std::string& extension_id) const {
+  return profile_->GetPrefs()
+      ->GetDict(prefs::kLumoGithubExtensions)
+      .contains(extension_id);
+}
+
+base::DictValue LumoGithubExtensionUpdater::GetWebUiInfo(
+    const std::string& extension_id) const {
+  base::DictValue info;
+  const base::DictValue& entries =
+      profile_->GetPrefs()->GetDict(prefs::kLumoGithubExtensions);
+  const base::DictValue* entry = entries.FindDict(extension_id);
+  if (!entry) {
+    return info;
+  }
+  if (const std::string* repo = entry->FindString("repo")) {
+    info.Set("lumoGithubRepo", *repo);
+  }
+  if (const std::string* tag = entry->FindString("tag")) {
+    info.Set("lumoGithubTag", *tag);
+  }
+  info.Set("lumoGithubIntervalHours",
+           entry->FindInt("interval_hours").value_or(kIntervalDefaultHours));
+  return info;
+}
+
+void LumoGithubExtensionUpdater::CheckForUpdates(bool startup) {
+  const base::DictValue entries =
+      profile_->GetPrefs()->GetDict(prefs::kLumoGithubExtensions).Clone();
+  const double now = base::Time::Now().InSecondsFSinceUnixEpoch();
+  for (const auto [id, value] : entries) {
+    if (!value.is_dict()) {
+      continue;
+    }
+    const base::DictValue& entry = value.GetDict();
+    const std::string* repo = entry.FindString("repo");
+    const std::string* asset = entry.FindString("asset");
+    if (!repo || !asset) {
+      continue;
+    }
+    const int interval = entry.FindInt("interval_hours")
+                             .value_or(kIntervalDefaultHours);
+    const double last_check = entry.FindDouble("last_check_unix").value_or(0);
+    if (!startup && !IsCheckDue(interval, last_check, now)) {
+      continue;
+    }
+    FetchLatestRelease(
+        *repo, base::BindOnce(&LumoGithubExtensionUpdater::OnReleaseForUpdate,
+                              weak_factory_.GetWeakPtr(), id));
+  }
+}
+
+void LumoGithubExtensionUpdater::OnReleaseForUpdate(
+    std::string extension_id,
+    std::optional<ReleaseInfo> release,
+    std::string error) {
+  if (!release) {
+    NotifyUser(extension_id, /*updated=*/false, error);
+    return;
+  }
+  const base::DictValue& entries =
+      profile_->GetPrefs()->GetDict(prefs::kLumoGithubExtensions);
+  const base::DictValue* entry = entries.FindDict(extension_id);
+  if (!entry) {
+    return;
+  }
+  const std::string* asset_name = entry->FindString("asset");
+  const std::string* repo = entry->FindString("repo");
+  if (!asset_name || !repo) {
+    return;
+  }
+  const ReleaseAsset* chosen = nullptr;
+  for (const ReleaseAsset& asset : release->crx_assets) {
+    if (asset.name == *asset_name) {
+      chosen = &asset;
+      break;
+    }
+  }
+  if (!chosen) {
+    NotifyUser(extension_id, /*updated=*/false,
+               "the registered asset is gone from the latest release");
+    return;
+  }
+  auto pending = base::MakeRefCounted<PendingInstall>();
+  pending->extension_id = extension_id;
+  pending->repo = *repo;
+  pending->tag = release->tag;
+  pending->asset = *asset_name;
+  pending->interval_hours =
+      entry->FindInt("interval_hours").value_or(kIntervalDefaultHours);
+  pending->is_update = true;
+  DownloadCrx(chosen->download_url,
+              base::BindOnce(&LumoGithubExtensionUpdater::VerifyAndInstall,
+                             weak_factory_.GetWeakPtr(), pending));
+}
+
+void LumoGithubExtensionUpdater::NotifyUser(const std::string& extension_id,
+                                            bool updated,
+                                            const std::string& detail) {
+  NotificationDisplayService* display_service =
+      NotificationDisplayServiceFactory::GetForProfile(profile_);
+  if (!display_service) {
+    return;
+  }
+  const extensions::Extension* extension =
+      extensions::ExtensionRegistry::Get(profile_)
+          ->GetInstalledExtension(extension_id);
+  const std::u16string name =
+      extension ? extension->name()
+                : base::UTF8ToUTF16(extension_id);
+  message_center::Notification notification(
+      message_center::NotificationType::NOTIFICATION_TYPE_SIMPLE,
+      kNotifierId + extension_id,
+      l10n_util::GetStringUTF16(updated
+                                    ? IDS_LUMO_GITHUB_NOTIFY_UPDATED_TITLE
+                                    : IDS_LUMO_GITHUB_NOTIFY_FAILED_TITLE),
+      l10n_util::GetStringFUTF16(
+          updated ? IDS_LUMO_GITHUB_NOTIFY_UPDATED_BODY
+                  : IDS_LUMO_GITHUB_NOTIFY_FAILED_BODY,
+          name, base::UTF8ToUTF16(detail)),
+      ui::ImageModel(), std::u16string(), GURL(),
+      message_center::NotifierId(message_center::NotifierType::APPLICATION,
+                                 kNotifierId),
+      message_center::RichNotificationData(),
+      base::MakeRefCounted<message_center::NotificationDelegate>());
+  display_service->Display(NotificationHandler::Type::TRANSIENT,
+                           notification, /*metadata=*/nullptr);
+}
+
+LumoGithubExtensionUpdater* GetForProfile(Profile* profile) {
+  return UpdaterFactory::GetForProfile(profile);
+}
+
+void StartForLoadedProfiles() {
+  ProfileManager* manager = g_browser_process->profile_manager();
+  if (!manager) {
+    return;
+  }
+  for (Profile* profile : manager->GetLoadedProfiles()) {
+    if (profile && !profile->IsOffTheRecord()) {
+      UpdaterFactory::GetForProfile(profile);
+    }
+  }
+}
+
+}  // namespace lumo::github_updater
