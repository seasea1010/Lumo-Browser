+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_LUMO_LUMO_GITHUB_EXTENSION_UPDATER_H_
+#define CHROME_BROWSER_LUMO_LUMO_GITHUB_EXTENSION_UPDATER_H_
+
+#include <map>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/timer/timer.h"
+#include "base/values.h"
+#include "components/keyed_service/core/keyed_service.h"
+#include "extensions/browser/extension_registry_observer.h"
+
+class Profile;
+
+namespace extensions {
+class ExtensionRegistry;
+}  // namespace extensions
+
+namespace lumo::github_updater {
+
+// One asset of a GitHub release that can be installed (a .crx file).
+struct ReleaseAsset {
+  std::string name;
+  std::string download_url;
+};
+
+// The subset of a GitHub "latest release" response the updater
+// needs: the tag and every .crx asset attached to the release.
+struct ReleaseInfo {
+  std::string tag;
+  std::vector<ReleaseAsset> crx_assets;
+};
+
+// Parses what the user typed into the add dialog: either a full
+// GitHub URL ("https://github.com/owner/repo", with an optional
+// trailing "/" or ".git") or the bare "owner/repo" form. Returns
+// the (owner, repo) pair, or nullopt for anything else. Only the
+// two name components are ever used to build the API URL, so a
+// hostile string cannot redirect the request away from
+// api.github.com.
+std::optional<std::pair<std::string, std::string>> ParseRepoInput(
+    std::string_view input);
+
+// Update-check intervals, in hours. 0 means "only at startup".
+inline constexpr int kIntervalStartupOnly = 0;
+inline constexpr int kIntervalDefaultHours = 24;
+
+// Whether a periodic check is due for an entry: never for the
+// startup-only interval, otherwise when at least |interval_hours|
+// have elapsed since |last_check_unix| (seconds since the epoch).
+bool IsCheckDue(int interval_hours, double last_check_unix, double now_unix);
+
+// Whether |candidate| is a usable, strictly newer version than the
+// currently installed |current| (an empty |current| means the
+// extension is not installed yet, so any valid candidate applies).
+bool IsNewerVersion(std::string_view candidate, std::string_view current);
+
+// Derives the extension ID a CRX3 package claims: the ID is a
+// function of the signing public key in the CRX3 header (see
+// crx_file::id_util::GenerateId), so comparing the derived ID
+// against the registered one proves the downloaded package was
+// signed with the same key as the installed extension. Returns
+// nullopt when the bytes are not a CRX3 package with an RSA proof.
+std::optional<std::string> DeriveExtensionIdFromCrx(
+    std::string_view crx_bytes);
+
+// Per-profile service behind Lumo patch 0048 (task 36): tracks the
+// extensions the user added from GitHub releases, checks for new
+// releases at startup and on each entry's interval, verifies every
+// downloaded CRX before applying it (signature key / extension ID
+// match, strictly newer version, parseable manifest), and installs
+// it through the normal CrxInstaller path, which re-verifies the
+// CRX3 signature cryptographically. Nothing is ever fetched or
+// installed for a repository the user did not explicitly enter.
+//
+// Registrations live in the profile pref |prefs::kLumoGithubExtensions|:
+// a dictionary keyed by extension ID with "repo" ("owner/repo"),
+// "tag", "version", "asset", "interval_hours" and "last_check_unix"
+// entries.
+class LumoGithubExtensionUpdater : public KeyedService,
+                                   public extensions::ExtensionRegistryObserver {
+ public:
+  using FetchCallback =
+      base::OnceCallback<void(std::optional<ReleaseInfo> release,
+                              std::string error)>;
+  using AddCallback =
+      base::OnceCallback<void(bool success, std::string id_or_error)>;
+
+  explicit LumoGithubExtensionUpdater(Profile* profile);
+  LumoGithubExtensionUpdater(const LumoGithubExtensionUpdater&) = delete;
+  LumoGithubExtensionUpdater& operator=(const LumoGithubExtensionUpdater&) =
+      delete;
+  ~LumoGithubExtensionUpdater() override;
+
+  // Fetches the latest release of |repo_input| ("owner/repo" or a
+  // github.com URL) and reports its tag and .crx assets. Used by
+  // the add dialog before anything is downloaded or installed.
+  void FetchLatestRelease(std::string repo_input, FetchCallback callback);
+
+  // Downloads the named .crx asset of the latest release, verifies
+  // it, installs it, and on success records the registration in the
+  // pref with the chosen check interval.
+  void AddExtension(std::string repo_input,
+                    std::string asset_name,
+                    int interval_hours,
+                    AddCallback callback);
+
+  // Changes one registered extension's check interval (from the
+  // extension's detail page on chrome://extensions).
+  void SetUpdateInterval(const std::string& extension_id, int interval_hours);
+
+  // Whether |extension_id| was added through this updater (drives
+  // the " (Github)" suffix and the detail-page section).
+  bool IsGithubManaged(const std::string& extension_id) const;
+
+  // The registration fields the extensions WebUI shows on the
+  // detail page ("repo", "tag", "interval_hours"); empty when the
+  // extension is not GitHub-managed.
+  base::DictValue GetWebUiInfo(const std::string& extension_id) const;
+
+  // Checks every registered extension now. |startup| checks also
+  // run for startup-only entries and ignore the per-entry interval.
+  void CheckForUpdates(bool startup);
+
+  // KeyedService:
+  void Shutdown() override;
+
+ private:
+  struct PendingInstall;
+
+  void OnReleaseForAdd(std::string repo,
+                       std::string asset_name,
+                       int interval_hours,
+                       AddCallback callback,
+                       std::optional<ReleaseInfo> release,
+                       std::string error);
+  void OnReleaseForUpdate(std::string extension_id,
+                          std::optional<ReleaseInfo> release,
+                          std::string error);
+  void DownloadCrx(
+      std::string download_url,
+      base::OnceCallback<void(std::optional<std::string> crx_bytes,
+                              std::string error)> callback);
+  void VerifyAndInstall(scoped_refptr<PendingInstall> pending,
+                        std::optional<std::string> crx_bytes,
+                        std::string error);
+  void FinishInstall(const std::string& extension_id, bool success);
+  void SaveEntry(const std::string& extension_id,
+                 const std::string& repo,
+                 const std::string& tag,
+                 const std::string& version,
+                 const std::string& asset,
+                 int interval_hours);
+  void NotifyUser(const std::string& extension_id,
+                  bool updated,
+                  const std::string& detail);
+
+  // extensions::ExtensionRegistryObserver:
+  void OnExtensionInstalled(content::BrowserContext* browser_context,
+                            const extensions::Extension* extension,
+                            bool is_update) override;
+  void OnExtensionUninstalled(content::BrowserContext* browser_context,
+                               const extensions::Extension* extension,
+                               extensions::UninstallReason reason) override;
+
+  raw_ptr<Profile> profile_;
+  std::map<std::string, scoped_refptr<PendingInstall>> pending_installs_;
+  base::RepeatingTimer check_timer_;
+  base::ScopedObservation<extensions::ExtensionRegistry,
+                          extensions::ExtensionRegistryObserver>
+      registry_observation_{this};
+  base::WeakPtrFactory<LumoGithubExtensionUpdater> weak_factory_{this};
+};
+
+// Returns the profile's updater, creating it on first use.
+LumoGithubExtensionUpdater* GetForProfile(Profile* profile);
+
+// Creates the updater for every loaded, non-incognito profile.
+// Called once from ChromeBrowserMainParts::PostBrowserStart (patch
+// 0048); the WebUI reaches the same instances through the factory.
+void StartForLoadedProfiles();
+
+}  // namespace lumo::github_updater
+
+#endif  // CHROME_BROWSER_LUMO_LUMO_GITHUB_EXTENSION_UPDATER_H_
