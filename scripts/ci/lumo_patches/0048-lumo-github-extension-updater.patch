+
+namespace extensions {
+
+namespace {
+
+using ReleaseInfo = lumo::github_updater::ReleaseInfo;
+
+}  // namespace
+
+LumoGithubExtensionsHandler::LumoGithubExtensionsHandler(Profile* profile)
+    : profile_(profile) {}
+
+LumoGithubExtensionsHandler::~LumoGithubExtensionsHandler() = default;
+
+void LumoGithubExtensionsHandler::RegisterMessages() {
+  web_ui()->RegisterMessageCallback(
+      "lumoGithubFetchRelease",
+      base::BindRepeating(&LumoGithubExtensionsHandler::HandleFetchRelease,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "lumoGithubAddExtension",
+      base::BindRepeating(&LumoGithubExtensionsHandler::HandleAddExtension,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "lumoGithubSetUpdateInterval",
+      base::BindRepeating(
+          &LumoGithubExtensionsHandler::HandleSetUpdateInterval,
+          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "lumoGithubGetInfo",
+      base::BindRepeating(&LumoGithubExtensionsHandler::HandleGetInfo,
+                          base::Unretained(this)));
+}
+
+void LumoGithubExtensionsHandler::HandleFetchRelease(
+    const base::ListValue& args) {
+  AllowJavascript();
+  const std::string& callback_id = args[0].GetString();
+  const std::string& repo = args[1].GetString();
+  auto* updater = lumo::github_updater::GetForProfile(profile_);
+  updater->FetchLatestRelease(
+      repo,
+      base::BindOnce(
+          [](base::WeakPtr<LumoGithubExtensionsHandler> self,
+             std::string callback_id,
+             std::optional<ReleaseInfo> release, std::string error) {
+            if (!self || !self->web_ui()) {
+              return;
+            }
+            if (!release) {
+              self->RejectJavascriptCallback(base::Value(callback_id),
+                                             base::Value(error));
+              return;
+            }
+            base::DictValue result;
+            result.Set("tag", release->tag);
+            base::ListValue assets;
+            for (const auto& asset : release->crx_assets) {
+              assets.Append(asset.name);
+            }
+            result.Set("assets", std::move(assets));
+            self->ResolveJavascriptCallback(base::Value(callback_id),
+                                            base::Value(std::move(result)));
+          },
+          weak_factory_.GetWeakPtr(), callback_id));
+}
+
+void LumoGithubExtensionsHandler::HandleAddExtension(
+    const base::ListValue& args) {
+  AllowJavascript();
+  const std::string& callback_id = args[0].GetString();
+  const std::string& repo = args[1].GetString();
+  const std::string& asset = args[2].GetString();
+  const int interval_hours = args[3].GetInt();
+  auto* updater = lumo::github_updater::GetForProfile(profile_);
+  updater->AddExtension(
+      repo, asset, interval_hours,
+      base::BindOnce(
+          [](base::WeakPtr<LumoGithubExtensionsHandler> self,
+             std::string callback_id, bool success,
+             std::string id_or_error) {
+            if (!self || !self->web_ui()) {
+              return;
+            }
+            if (success) {
+              self->ResolveJavascriptCallback(base::Value(callback_id),
+                                              base::Value(id_or_error));
+            } else {
+              self->RejectJavascriptCallback(base::Value(callback_id),
+                                             base::Value(id_or_error));
+            }
+          },
+          weak_factory_.GetWeakPtr(), callback_id));
+}
+
+void LumoGithubExtensionsHandler::HandleSetUpdateInterval(
+    const base::ListValue& args) {
+  const std::string& extension_id = args[0].GetString();
+  const int interval_hours = args[1].GetInt();
+  lumo::github_updater::GetForProfile(profile_)->SetUpdateInterval(
+      extension_id, interval_hours);
+}
+void LumoGithubExtensionsHandler::HandleGetInfo(
+    const base::ListValue& args) {
+  AllowJavascript();
+  const std::string& callback_id = args[0].GetString();
+  const std::string& extension_id = args[1].GetString();
+  auto* updater = lumo::github_updater::GetForProfile(profile_);
+  base::DictValue info = updater->GetWebUiInfo(extension_id);
+  // Empty when the extension is not GitHub-managed; the page
+  // treats a missing lumoGithubRepo as "no GitHub section".
+  ResolveJavascriptCallback(base::Value(callback_id),
+                            base::Value(std::move(info)));
+}
+
+}  // namespace extensions
