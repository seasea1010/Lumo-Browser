+namespace lumo::github_updater {
+
+namespace {
+
+// GitHub's API caps unauthenticated requests at 60/hour per IP; the
+// largest plausible extension CRX is far below this download cap.
+constexpr int64_t kMaxCrxDownloadBytes = 64 * 1024 * 1024;
+constexpr char kGithubApiBase[] = "https://api.github.com/repos/";
+constexpr char kNotifierId[] = "lumo_github_extension_updater";
+
+bool IsValidRepoComponent(std::string_view part) {
+  if (part.empty() || part.size() > 100 || part == "." || part == "..") {
+    return false;
+  }
+  for (char c : part) {
+    if (!base::IsAsciiAlphaNumeric(c) && c != '-' && c != '_' && c != '.') {
+      return false;
+    }
+  }
+  return true;
+}
+
+network::mojom::URLLoaderFactory* GetLoaderFactory() {
+  if (!g_browser_process) {
+    return nullptr;
+  }
+  auto* manager = g_browser_process->system_network_context_manager();
+  return manager ? manager->GetURLLoaderFactory() : nullptr;
+}
+
+void GetJson(
+    const GURL& url,
+    base::OnceCallback<void(std::optional<std::string> body)> callback) {
+  auto* factory = GetLoaderFactory();
+  if (!factory) {
+    std::move(callback).Run(std::nullopt);
+    return;
+  }
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = url;
+  request->method = "GET";
+  request->load_flags = net::LOAD_BYPASS_CACHE | net::LOAD_DISABLE_CACHE;
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  request->headers.SetHeader(net::HttpRequestHeaders::kAccept,
+                             "application/vnd.github+json");
+  request->headers.SetHeader(net::HttpRequestHeaders::kUserAgent,
+                             "Lumo-Browser");
+  static constexpr net::NetworkTrafficAnnotationTag kAnnotation =
+      net::DefineNetworkTrafficAnnotation("lumo_github_extension_update", R"(
+        semantics {
+          sender: "Lumo GitHub Extension Updater"
+          description:
+            "Fetches the latest GitHub release (metadata, then the "
+            ".crx asset) of a repository the user explicitly "
+            "registered on chrome://extensions, to install or "
+            "update that extension. No repository is contacted "
+            "unless the user added it."
+          trigger:
+            "Browser startup and a per-extension interval for "
+            "registered repositories, and when the user adds a new "
+            "repository in the chrome://extensions dialog."
+          data:
+            "The repository owner/name in the API URL. No "
+            "credentials, cookies, or profile data."
+          destination: WEBSITE
+        }
+        policy {
+          cookies_allowed: NO
+          setting:
+            "Only repositories the user added on "
+            "chrome://extensions are ever queried."
+          policy_exception_justification:
+            "User-registered extension update source for the "
+            "browser owner's own extensions."
+        })");
+  auto loader =
+      network::SimpleURLLoader::Create(std::move(request), kAnnotation);
+  loader->SetTimeoutDuration(base::Seconds(30));
+  network::SimpleURLLoader* loader_ptr = loader.get();
+  loader_ptr->DownloadToString(
+      factory,
+      base::BindOnce(
+          [](std::unique_ptr<network::SimpleURLLoader> owned_loader,
+             base::OnceCallback<void(std::optional<std::string> body)>
+                 callback,
+             std::optional<std::string> body) {
+            if (owned_loader->NetError() != net::OK) {
+              body = std::nullopt;
+            }
+            std::move(callback).Run(std::move(body));
+          },
+          std::move(loader), std::move(callback)),
+      kMaxCrxDownloadBytes);
+}
+
+// Parses a GitHub "latest release" JSON body into the tag and the
+// .crx assets. Returns nullopt on any shape mismatch.
+std::optional<ReleaseInfo> ParseReleaseJson(const std::string& body) {
+  std::optional<base::Value> parsed =
+      base::JSONReader::Read(body, base::JSON_PARSE_RFC);
+  if (!parsed || !parsed->is_dict()) {
+    return std::nullopt;
+  }
+  const base::DictValue& dict = parsed->GetDict();
+  const std::string* tag = dict.FindString("tag_name");
+  const base::ListValue* assets = dict.FindList("assets");
+  if (!tag || tag->empty() || !assets) {
+    return std::nullopt;
+  }
+  ReleaseInfo info;
+  info.tag = *tag;
+  for (const base::Value& item : *assets) {
+    if (!item.is_dict()) {
+      continue;
+    }
+    const std::string* name = item.GetDict().FindString("name");
+    const std::string* url =
+        item.GetDict().FindString("browser_download_url");
+    if (name && url && base::EndsWith(*name, ".crx",
+                                      base::CompareCase::INSENSITIVE_ASCII)) {
+      info.crx_assets.push_back({*name, *url});
+    }
+  }
+  return info;
+}
+
+// Result of the pre-apply verification (task 36 requirement (b)),
+// computed off the UI thread because it touches the file system.
+struct CrxVerification {
+  std::string extension_id;
+  std::string version;
+  std::string error;
+  // Where the verified bytes were stored for CrxInstaller (under
+  // the profile's "Lumo GitHub Extensions" directory).
+  base::FilePath crx_path;
+};
+
+CrxVerification VerifyCrxBytes(std::string crx_bytes,
+                               base::FilePath profile_path) {
+  CrxVerification result;
+  std::optional<std::string> id = DeriveExtensionIdFromCrx(crx_bytes);
+  if (!id) {
+    result.error = "not a CRX3 package signed with an RSA key";
+    return result;
+  }
+  result.extension_id = *id;
+  // The manifest lives in the zip payload after the CRX header.
+  if (crx_bytes.size() < 12) {
+    result.error = "truncated CRX";
+    return result;
+  }
+  uint32_t header_len = static_cast<uint8_t>(crx_bytes[8]) |
+                        (static_cast<uint8_t>(crx_bytes[9]) << 8) |
+                        (static_cast<uint8_t>(crx_bytes[10]) << 16) |
+                        (static_cast<uint8_t>(crx_bytes[11]) << 24);
+  const size_t zip_offset = 12 + static_cast<size_t>(header_len);
+  if (zip_offset >= crx_bytes.size()) {
+    result.error = "truncated CRX header";
+    return result;
+  }
+  base::ScopedTempDir temp_dir;
+  if (!temp_dir.CreateUniqueTempDir()) {
+    result.error = "could not create a temp directory";
+    return result;
+  }
+  const base::FilePath zip_path = temp_dir.GetPath().AppendASCII("pkg.zip");
+  const base::FilePath out_dir = temp_dir.GetPath().AppendASCII("out");
+  if (!base::WriteFile(zip_path,
+                       std::string_view(crx_bytes).substr(zip_offset)) ||
+      !base::CreateDirectory(out_dir) || !zip::Unzip(zip_path, out_dir)) {
+    result.error = "CRX payload is not a readable zip";
+    return result;
+  }
+  std::string manifest_json;
+  if (!base::ReadFileToString(out_dir.AppendASCII("manifest.json"),
+                              &manifest_json)) {
+    result.error = "CRX payload has no manifest.json";
+    return result;
+  }
+  std::optional<base::Value> manifest =
+      base::JSONReader::Read(manifest_json, base::JSON_PARSE_RFC);
+  if (!manifest || !manifest->is_dict() ||
+      !manifest->GetDict().FindString("name")) {
+    result.error = "manifest.json is not a valid extension manifest";
+    return result;
+  }
+  const std::string* version = manifest->GetDict().FindString("version");
+  if (!version || !base::Version(*version).IsValid()) {
+    result.error = "manifest.json has no valid version";
+    return result;
+  }
+  result.version = *version;
+  // Persist the verified bytes where CrxInstaller can read them
+  // asynchronously (the same reason patch 0026 keeps the uBlock
+  // Origin source in the profile). One file per extension ID,
+  // overwritten by the next verified update.
+  const base::FilePath dir =
+      profile_path.AppendASCII("Lumo GitHub Extensions");
+  const base::FilePath path = dir.AppendASCII(result.extension_id + ".crx");
+  if (!base::CreateDirectory(dir) || !base::WriteFile(path, crx_bytes)) {
+    result.error = "could not store the verified CRX in the profile";
+    result.crx_path.clear();
+    return result;
+  }
+  result.crx_path = path;
+  return result;
+}
