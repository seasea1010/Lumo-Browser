+      // Lumo: start a separate browser process that uses the
+      // original Thorium user profile data directory
+      // (%LOCALAPPDATA%\Thorium\User Data). The user-data-dir
+      // differs from this process's, so the new process is
+      // independent of the profile singleton and can run alongside
+      // this window.
+      base::FilePath exe_path;
+      base::FilePath local_app_data;
+      if (base::PathService::Get(base::FILE_EXE, &exe_path) &&
+          base::PathService::Get(base::DIR_LOCAL_APP_DATA,
+                                 &local_app_data)) {
+        const base::FilePath thorium_user_data =
+            local_app_data.Append(FILE_PATH_LITERAL("Thorium"))
+                .Append(FILE_PATH_LITERAL("User Data"));
+        base::CommandLine command_line(exe_path);
+        command_line.AppendSwitchPath(switches::kUserDataDir,
+                                      thorium_user_data);
+        base::LaunchProcess(command_line, base::LaunchOptions());
+      }
+      break;
+    }
+#endif  // BUILDFLAG(IS_WIN)
