+void BrowserCommandController::OnLumoTabGroupsFileLoaded(
+    std::optional<std::string> json) {
+  // Lumo (patch 0018): rebuild the tab groups saved by
+  // IDC_LUMO_SAVE_TAB_GROUPS. Each saved group becomes a fresh
+  // set of tabs appended to this window, grouped under the
+  // saved title and color. Anything malformed is skipped.
+  if (!json) {
+    return;
+  }
+  std::optional<base::Value> parsed = base::JSONReader::Read(*json, base::JSON_PARSE_RFC);
+  if (!parsed || !parsed->is_dict()) {
+    return;
+  }
+  const base::ListValue* groups = parsed->GetDict().FindList("groups");
+  if (!groups) {
+    return;
+  }
+  TabStripModel* tab_strip_model = browser_->tab_strip_model();
+  if (!tab_strip_model->SupportsTabGroups()) {
+    return;
+  }
+  for (const base::Value& group_value : *groups) {
+    if (!group_value.is_dict()) {
+      continue;
+    }
+    const base::DictValue& group_dict = group_value.GetDict();
+    const base::ListValue* urls = group_dict.FindList("urls");
+    if (!urls || urls->empty()) {
+      continue;
+    }
+    std::vector<int> indices;
+    for (const base::Value& url_value : *urls) {
+      const std::string* url_string = url_value.GetIfString();
+      if (!url_string) {
+        continue;
+      }
+      const GURL url(*url_string);
+      if (!url.is_valid()) {
+        continue;
+      }
+      auto contents = content::WebContents::Create(
+          content::WebContents::CreateParams(profile()));
+      content::WebContents* contents_ptr = contents.get();
+      const int index = tab_strip_model->InsertWebContentsAt(
+          tab_strip_model->count(), std::move(contents),
+          AddTabTypes::ADD_NONE);
+      if (index == TabStripModel::kNoTab) {
+        continue;
+      }
+      content::NavigationController::LoadURLParams params(url);
+      params.transition_type = ui::PAGE_TRANSITION_AUTO_TOPLEVEL;
+      contents_ptr->GetController().LoadURLWithParams(params);
+      indices.push_back(index);
+    }
+    if (indices.empty()) {
+      continue;
+    }
+    const tab_groups::TabGroupId new_group_id =
+        tab_strip_model->AddToNewGroup(indices);
+    TabGroup* new_group =
+        tab_strip_model->group_model()->GetTabGroup(new_group_id);
+    if (!new_group) {
+      continue;
+    }
+    const std::string* title = group_dict.FindString("title");
+    const int color_int = group_dict.FindInt("color").value_or(
+        static_cast<int>(tab_groups::TabGroupColorId::kGrey));
+    tab_groups::TabGroupColorId color =
+        tab_groups::TabGroupColorId::kGrey;
+    if (color_int >= 0 &&
+        color_int <
+            static_cast<int>(tab_groups::TabGroupColorId::kNumEntries)) {
+      color = static_cast<tab_groups::TabGroupColorId>(color_int);
+    }
+    new_group->SetVisualData(
+        tab_groups::TabGroupVisualData(
+            base::UTF8ToUTF16(title ? *title : std::string()), color),
+        /*is_customized=*/true);
+  }
+}
