diff --git a/chrome/browser/resources/lumo_tools/tools.css b/chrome/browser/resources/lumo_tools/tools.css
index 3b6027c..4ea5bca 100644
--- a/chrome/browser/resources/lumo_tools/tools.css
+++ b/chrome/browser/resources/lumo_tools/tools.css
@@ -301,3 +301,50 @@ section.cat-group > h2 {
 .hidden {
   display: none !important;
 }
+
+.ext-section {
+  margin-top: 36px;
+}
+
+.ext-section > h2 {
+  border-bottom: 1px solid var(--border);
+  font-size: 16px;
+  font-weight: 600;
+  margin: 0 0 12px;
+  padding-bottom: 6px;
+}
+
+.ext-card {
+  border: 1px solid var(--border);
+  border-radius: 6px;
+  margin-bottom: 12px;
+  padding: 12px 14px;
+}
+
+.ext-card h3 {
+  font-size: 14px;
+  font-weight: 600;
+  margin: 0 0 2px;
+}
+
+.ext-card .desc {
+  color: var(--muted);
+  font-size: 12px;
+  margin: 0 0 10px;
+}
+
+.ext-badge {
+  background: var(--accent);
+  border-radius: 4px;
+  color: var(--accent-fg);
+  font-size: 11px;
+  font-weight: 400;
+  margin-left: 6px;
+  padding: 1px 6px;
+  vertical-align: 2px;
+}
+
+.ext-card a {
+  color: var(--accent);
+  font-size: 12px;
+}
diff --git a/chrome/browser/resources/lumo_tools/tools.html b/chrome/browser/resources/lumo_tools/tools.html
