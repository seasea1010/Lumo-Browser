+/* Copyright 2026 The Lumo Authors
+ * Lumo NTP customization (patch 0052, task 38): flat styling for
+ * the customized new tab page. All geometry and colors come from
+ * the config at runtime; this file only carries the static shape.
+ */
+
+/* #css_wrapper_metadata_start
+ * #type=vars
+ * #css_wrapper_metadata_end */
+
+#lumo-ntp-root {
+  display: flex;
+  flex-direction: column;
+  margin: 0 auto;
+  min-height: 100vh;
+  position: relative;
+}
+
+.lumo-bg-overlay {
+  inset: 0;
+  pointer-events: none;
+  position: absolute;
+}
+
+.lumo-clock-main {
+  line-height: 1.1;
+}
+
+.lumo-date {
+  font-size: 0.35em;
+  text-align: inherit;
+}
+
+.lumo-greeting {
+  font-size: 1.25em;
+  text-align: center;
+}
+
+.lumo-search {
+  display: flex;
+  padding: 0 16px;
+}
+
+.lumo-search input {
+  background: transparent;
+  border: none;
+  flex: 1;
+  font-size: 1em;
+  outline: none;
+}
+
+.lumo-tile {
+  align-items: center;
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+  justify-content: center;
+  text-decoration: none;
+}
+
+.lumo-widgets {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 16px;
+  justify-content: center;
+}
+
+.lumo-widget {
+  background: var(--color-ntp-card-background, #fff);
+  border-radius: 16px;
+  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.12);
+  padding: 16px;
+}
+
+.lumo-widget-title {
+  font-weight: 500;
+  margin-bottom: 8px;
+}
+
+.lumo-calendar {
+  display: grid;
+  gap: 4px;
+  grid-template-columns: repeat(7, 1fr);
+  text-align: center;
+}
+
+.lumo-calendar-today {
+  background: var(--lumo-accent, #00acc1);
+  border-radius: 50%;
+  color: #fff;
+}
+
+#lumo-ntp-root[data-density='compact'] .lumo-widget {
+  padding: 8px;
+}
+
+#lumo-ntp-root[data-density='relaxed'] .lumo-widget {
+  padding: 24px;
+}
