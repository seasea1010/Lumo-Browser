+   desc: '元利均等返済の月々の返済額を計算します。',
+   fields: [
+     {k: 'principal', label: '借入額（円）', type: 'number',
+      def: '3000000'},
+     {k: 'rate', label: '年利（%）', type: 'number', def: '1.5'},
+     {k: 'years', label: '返済期間（年）', type: 'number', def: '5'},
+   ],
+   fn: v => {
+     const p = +v.principal || 0;
+     const r = (+v.rate || 0) / 100 / 12;
+     const n = Math.max(1, Math.round((+v.years || 0) * 12));
+     const monthly = r === 0 ? p / n :
+         p * r * Math.pow(1 + r, n) / (Math.pow(1 + r, n) - 1);
+     const total = monthly * n;
+     return [
+       ['月々の返済額', `${fmtNum(Math.round(monthly))} 円`],
+       ['総返済額', `${fmtNum(Math.round(total))} 円`],
+       ['利息の合計', `${fmtNum(Math.round(total - p))} 円`],
+       ['返済回数', `${n} 回`],
+     ];
+   }},
+  {id: 'compound', cat: 'num', name: '複利・積立計算', kind: 'form',
+   desc: '元金と毎月の積立が複利でいくらになるか計算します。',
+   fields: [
+     {k: 'principal', label: '元金（円）', type: 'number', def: '100000'},
+     {k: 'monthly', label: '毎月の積立（円）', type: 'number',
