@@ -0,0 +1,35 @@
+// Copyright 2026 seasea1010
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_WEBUI_LUMO_TOOLS_LUMO_TOOLS_UI_H_
+#define CHROME_BROWSER_UI_WEBUI_LUMO_TOOLS_LUMO_TOOLS_UI_H_
+
+#include "chrome/common/webui_url_constants.h"
+#include "content/public/browser/web_ui_controller.h"
+#include "content/public/browser/webui_config.h"
+#include "content/public/common/url_constants.h"
+
+class LumoToolsUI;
+
+class LumoToolsUIConfig : public content::DefaultWebUIConfig<LumoToolsUI> {
+ public:
+  LumoToolsUIConfig()
+      : DefaultWebUIConfig(content::kChromeUIScheme,
+                           chrome::kChromeUIToolsHost) {}
+};
+
+// The WebUI for chrome://tools (Lumo patch 0028): a collection of
+// small utilities that run entirely in the page's own resources
+// (no browser-side handler, no network access). Registering the
+// "tools" host under the chrome scheme is enough to also make the
+// page reachable as thorium://tools and lumo://tools, because the
+// internal URL scheme aliases (patch 0023) rewrite any host's
+// scheme to chrome:// before WebUI config lookup.
+class LumoToolsUI : public content::WebUIController {
+ public:
+  explicit LumoToolsUI(content::WebUI* web_ui);
+  ~LumoToolsUI() override;
+};
+
+#endif  // CHROME_BROWSER_UI_WEBUI_LUMO_TOOLS_LUMO_TOOLS_UI_H_
