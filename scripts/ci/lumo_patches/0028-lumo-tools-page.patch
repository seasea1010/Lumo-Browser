+         elapsed += Date.now() - startAt;
+         clearInterval(timer);
+         timer = null;
+         btnStart.textContent = '再開';
+       } else {
+         startAt = Date.now();
+         timer = setInterval(tick, 31);
+         btnStart.textContent = 'ストップ';
+       }
+     });
+     btnLap.addEventListener('click', () => {
+       const now = elapsed + (timer ? Date.now() - startAt : 0);
