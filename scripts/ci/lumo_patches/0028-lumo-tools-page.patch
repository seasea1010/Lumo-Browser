+++ b/chrome/browser/resources/lumo_tools/tools.js
@@ -0,0 +1,2799 @@
+// Copyright 2026 seasea1010
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// chrome://tools (Lumo patch 0028): a collection of small utilities
+// that run entirely on this page. No input ever leaves the browser:
+// there are no network calls and no external libraries. The DOM is
+// built with createElement/textContent only, because WebUI data
+// sources enforce Trusted Types (innerHTML is never used).
+'use strict';
+
+/* ------------------------------------------------------------------ */
+/* Small helpers                                                       */
+/* ------------------------------------------------------------------ */
+
+function h(tag, cls, text) {
+  const e = document.createElement(tag);
+  if (cls) {
+    e.className = cls;
+  }
+  if (text != null) {
+    e.textContent = text;
+  }
+  return e;
+}
+
+const textEncoder = new TextEncoder();
+const textDecoder = new TextDecoder('utf-8', {fatal: true});
+
+function utf8Bytes(str) {
+  return textEncoder.encode(str);
+}
+
+function bytesToHex(bytes) {
+  return [...bytes].map(b => b.toString(16).padStart(2, '0')).join('');
+}
+
+function bytesToB64(bytes) {
+  let bin = '';
+  const chunk = 0x8000;
+  for (let i = 0; i < bytes.length; i += chunk) {
+    bin += String.fromCharCode.apply(
+        null, bytes.subarray(i, i + chunk));
+  }
+  return btoa(bin);
+}
+
+function b64ToBytes(b64) {
+  const bin = atob(b64.replace(/\s+/g, ''));
+  const bytes = new Uint8Array(bin.length);
+  for (let i = 0; i < bin.length; i++) {
+    bytes[i] = bin.charCodeAt(i);
+  }
+  return bytes;
+}
+
+async function shaHex(algo, bytes) {
+  const buf = await crypto.subtle.digest(algo, bytes);
+  return bytesToHex(new Uint8Array(buf));
+}
+
+function fmtNum(n) {
+  return n.toLocaleString('ja-JP');
+}
+
+/* ------------------------------------------------------------------ */
+/* MD5 (pure JavaScript; crypto.subtle has no MD5)                     */
+/* ------------------------------------------------------------------ */
+
+const MD5_K = [
+  0xd76aa478, 0xe8c7b756, 0x242070db, 0xc1bdceee, 0xf57c0faf, 0x4787c62a,
+  0xa8304613, 0xfd469501, 0x698098d8, 0x8b44f7af, 0xffff5bb1, 0x895cd7be,
+  0x6b901122, 0xfd987193, 0xa679438e, 0x49b40821, 0xf61e2562, 0xc040b340,
+  0x265e5a51, 0xe9b6c7aa, 0xd62f105d, 0x02441453, 0xd8a1e681, 0xe7d3fbc8,
+  0x21e1cde6, 0xc33707d6, 0xf4d50d87, 0x455a14ed, 0xa9e3e905, 0xfcefa3f8,
+  0x676f02d9, 0x8d2a4c8a, 0xfffa3942, 0x8771f681, 0x6d9d6122, 0xfde5380c,
+  0xa4beea44, 0x4bdecfa9, 0xf6bb4b60, 0xbebfbc70,
+  0x289b7ec6, 0xeaa127fa, 0xd4ef3085, 0x04881d05, 0xd9d4d039, 0xe6db99e5,
+  0x1fa27cf8, 0xc4ac5665, 0xf4292244, 0x432aff97, 0xab9423a7, 0xfc93a039,
+  0x655b59c3, 0x8f0ccc92, 0xffeff47d, 0x85845dd1, 0x6fa87e4f, 0xfe2ce6e0,
+  0xa3014314, 0x4e0811a1, 0xf7537e82, 0xbd3af235, 0x2ad7d2bb, 0xeb86d391,
+];
+const MD5_S = [
+  7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22,
+  5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20,
+  4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23,
+  6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21,
+];
+
+function md5Hex(bytes) {
+  const bitLen = bytes.length * 8;
+  const total = (((bytes.length + 8) >> 6) + 1) << 6;
+  const msg = new Uint8Array(total);
+  msg.set(bytes);
+  msg[bytes.length] = 0x80;
+  const dv = new DataView(msg.buffer);
+  dv.setUint32(total - 8, bitLen >>> 0, true);
+  dv.setUint32(total - 4, Math.floor(bitLen / 4294967296), true);
+  let a0 = 0x67452301, b0 = 0xefcdab89, c0 = 0x98badcfe, d0 = 0x10325476;
+  const m = new Uint32Array(16);
+  for (let off = 0; off < total; off += 64) {
+    for (let i = 0; i < 16; i++) {
+      m[i] = dv.getUint32(off + i * 4, true);
+    }
+    let a = a0, b = b0, c = c0, d = d0;
+    for (let i = 0; i < 64; i++) {
+      let f, g;
+      if (i < 16) {
+        f = (b & c) | (~b & d);
+        g = i;
+      } else if (i < 32) {
+        f = (d & b) | (~d & c);
+        g = (5 * i + 1) % 16;
+      } else if (i < 48) {
+        f = b ^ c ^ d;
+        g = (3 * i + 5) % 16;
+      } else {
+        f = c ^ (b | ~d);
+        g = (7 * i) % 16;
+      }
+      const sum = (f + a + MD5_K[i] + m[g]) | 0;
+      a = d;
+      d = c;
+      c = b;
+      const rot = (sum << MD5_S[i]) | (sum >>> (32 - MD5_S[i]));
+      b = (b + rot) | 0;
+    }
+    a0 = (a0 + a) | 0;
+    b0 = (b0 + b) | 0;
+    c0 = (c0 + c) | 0;
+    d0 = (d0 + d) | 0;
+  }
+  const out = new Uint8Array(16);
+  const odv = new DataView(out.buffer);
+  odv.setUint32(0, a0 >>> 0, true);
+  odv.setUint32(4, b0 >>> 0, true);
+  odv.setUint32(8, c0 >>> 0, true);
+  odv.setUint32(12, d0 >>> 0, true);
+  return bytesToHex(out);
+}
+
+/* ------------------------------------------------------------------ */
+/* Shared text utilities                                               */
+/* ------------------------------------------------------------------ */
+
+function splitLines(text) {
+  return text.replace(/\r\n?/g, '\n').split('\n');
+}
+
+function splitWords(text) {
+  const trimmed = text.trim();
+  if (!trimmed) {
+    return [];
+  }
+  return trimmed.split(/[\s\u3000]+/).filter(w => w.length > 0);
+}
+
+// Halfwidth <-> fullwidth katakana maps (with dakuten composition).
+const KANA_HALF = 'ｱｲｳｴｵｶｷｸｹｺｻｼｽｾｿﾀﾁﾂﾃﾄﾅﾆﾇﾈﾉﾊﾋﾌﾍﾎﾏﾐﾑﾒﾓﾔﾕﾖﾗﾘﾙﾚﾛﾜｦﾝｧｨｩｪｫｬｭｮｯｰ､｡｢｣';
+const KANA_FULL = 'アイウエオカキクケコサシスセソタチツテトナニヌネノハヒフヘホマミムメモヤユヨラリルレロワヲンァィゥェォャュョッー、。「」';
+const KANA_VOICED = {
+  'カ': 'ガ', 'キ': 'ギ', 'ク': 'グ', 'ケ': 'ゲ', 'コ': 'ゴ',
+  'サ': 'ザ', 'シ': 'ジ', 'ス': 'ズ', 'セ': 'ゼ', 'ソ': 'ゾ',
+  'タ': 'ダ', 'チ': 'ヂ', 'ツ': 'ヅ', 'テ': 'デ', 'ト': 'ド',
+  'ハ': 'バ', 'ヒ': 'ビ', 'フ': 'ブ', 'ヘ': 'ベ', 'ホ': 'ボ',
+  'ウ': 'ヴ',
+};
+const KANA_SEMIVOICED = {
+  'ハ': 'パ', 'ヒ': 'ピ', 'フ': 'プ', 'ヘ': 'ペ', 'ホ': 'ポ',
+};
+const KANA_VOICED_REV = {};
+for (const k of Object.keys(KANA_VOICED)) {
+  KANA_VOICED_REV[KANA_VOICED[k]] = k;
+}
+const KANA_SEMIVOICED_REV = {};
+for (const k of Object.keys(KANA_SEMIVOICED)) {
+  KANA_SEMIVOICED_REV[KANA_SEMIVOICED[k]] = k;
+}
+
+function kanaToFull(text) {
+  let out = '';
+  const chars = [...text];
+  for (let i = 0; i < chars.length; i++) {
+    const ch = chars[i];
+    const idx = KANA_HALF.indexOf(ch);
+    if (idx >= 0) {
+      let full = KANA_FULL[idx];
+      const next = chars[i + 1];
+      if (next === 'ﾞ' && KANA_VOICED[full]) {
+        full = KANA_VOICED[full];
+        i++;
+      } else if (next === 'ﾟ' && KANA_SEMIVOICED[full]) {
+        full = KANA_SEMIVOICED[full];
+        i++;
+      }
+      out += full;
+    } else if (ch === 'ﾞ' || ch === 'ﾟ') {
+      out += ch === 'ﾞ' ? '゛' : '゜';
+    } else {
+      out += ch;
+    }
+  }
+  return out;
+}
+
+function kanaToHalf(text) {
+  let out = '';
+  for (const ch of text) {
+    if (KANA_VOICED_REV[ch]) {
+      const idx = KANA_FULL.indexOf(KANA_VOICED_REV[ch]);
+      out += KANA_HALF[idx] + 'ﾞ';
+    } else if (KANA_SEMIVOICED_REV[ch]) {
+      const idx = KANA_FULL.indexOf(KANA_SEMIVOICED_REV[ch]);
+      out += KANA_HALF[idx] + 'ﾟ';
+    } else {
+      const idx = KANA_FULL.indexOf(ch);
+      out += idx >= 0 ? KANA_HALF[idx] : ch;
+    }
+  }
+  return out;
+}
+
+function asciiToFull(text) {
+  return text.replace(/[!-~]/g,
+      ch => String.fromCharCode(ch.charCodeAt(0) + 0xFEE0))
+      .replace(/ /g, '　');
+}
+
+function asciiToHalf(text) {
+  return text.replace(/[！-～]/g,
+      ch => String.fromCharCode(ch.charCodeAt(0) - 0xFEE0))
+      .replace(/　/g, ' ');
+}
+
+function wordTokens(text) {
+  // Tokens for case conversion: split on whitespace, '_', '-' and
+  // case boundaries.
+  return text.replace(/([a-z0-9])([A-Z])/g, '$1 $2')
+      .split(/[\s_\-]+/)
+      .filter(w => w.length > 0)
+      .map(w => w.toLowerCase());
+}
+
+function cap(word) {
+  return word ? word[0].toUpperCase() + word.slice(1) : word;
+}
+
+/* ------------------------------------------------------------------ */
+/* Tool registry                                                       */
+/*                                                                     */
+/* One tool = one independent conversion / calculation / display.    */
+/* kind: 'io'     textarea -> textarea (live unless live:false)      */
+/*       'stat'   textarea -> label/value rows (live)                */
+/*       'form'   fields -> text or label/value rows                 */
+/*       'table'  static reference table                             */
+/*       'custom' render(body) builds its own UI                     */
+/* ------------------------------------------------------------------ */
+
+const CATS = [
+  {key: 'text', label: 'テキスト操作'},
+  {key: 'encode', label: 'エンコード'},
+  {key: 'data', label: 'データ整形'},
+  {key: 'hash', label: 'ハッシュ・セキュリティ'},
+  {key: 'gen', label: '生成'},
+  {key: 'num', label: '数値・単位'},
+  {key: 'time', label: '時刻'},
+  {key: 'color', label: '色'},
+  {key: 'web', label: 'Web・参照'},
+];
+
+const TOOLS = [
+  /* ---------------- テキスト操作 ---------------- */
+  {id: 'char-count', cat: 'text', name: '文字数カウント', kind: 'stat',
+   desc: '文字数を数えます（サロゲートペアは1文字として数えた数も表示）。',
+   fn: text => [
+     ['文字数（コードポイント）', fmtNum([...text].length)],
+     ['文字数（UTF-16 コード単位）', fmtNum(text.length)],
+     ['文字数（空白・改行を除く）',
+      fmtNum([...text.replace(/\s/g, '')].length)],
