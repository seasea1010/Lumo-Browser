+     colS.appendChild(h('label', null, '秒'));
+     colS.appendChild(secInput);
+     wrap.appendChild(colM);
+     wrap.appendChild(colS);
+     body.appendChild(wrap);
+     const disp = h('div', 'big-clock', '03:00');
+     body.appendChild(disp);
+     const btn = h('button', 'action', 'スタート');
+     body.appendChild(btn);
+     let timer = null;
+     let remain = 0;
+     const fmt = s => `${String(Math.floor(s / 60)).padStart(2, '0')}:` +
+         `${String(s % 60).padStart(2, '0')}`;
+     const beep = () => {
+       try {
+         const ctx = new AudioContext();
+         const osc = ctx.createOscillator();
+         const gain = ctx.createGain();
+         osc.connect(gain);
+         gain.connect(ctx.destination);
+         osc.frequency.value = 880;
+         gain.gain.value = 0.15;
+         osc.start();
+         osc.stop(ctx.currentTime + 0.6);
+       } catch (e) {
+         // Audio may be unavailable; the display still signals.
+       }
+     };
+     btn.addEventListener('click', () => {
+       if (timer) {
+         clearInterval(timer);
+         timer = null;
+         btn.textContent = 'スタート';
+         return;
+       }
+       remain = (Math.max(0, +minInput.value || 0) * 60) +
+           Math.min(59, Math.max(0, +secInput.value || 0));
+       if (remain <= 0) {
+         return;
+       }
+       disp.textContent = fmt(remain);
+       btn.textContent = '停止';
+       timer = setInterval(() => {
+         remain--;
+         disp.textContent = fmt(Math.max(0, remain));
+         if (remain <= 0) {
+           clearInterval(timer);
+           timer = null;
+           btn.textContent = 'スタート';
+           disp.textContent = '時間になりました';
+           beep();
+         }
+       }, 1000);
+     });
+   }},
