+   render: body => {
+     const disp = h('div', 'big-clock', '00:00.00');
+     body.appendChild(disp);
+     const row = h('div');
+     const btnStart = h('button', 'action', 'スタート');
+     const btnLap = h('button', 'plain', 'ラップ');
+     const btnReset = h('button', 'plain', 'リセット');
+     row.appendChild(btnStart);
+     row.appendChild(btnLap);
+     row.appendChild(btnReset);
+     body.appendChild(row);
+     const laps = h('div', 'result');
+     body.appendChild(laps);
+     let startAt = 0;
+     let elapsed = 0;
+     let timer = null;
+     const fmt = ms => {
+       const m = Math.floor(ms / 60000);
+       const s = Math.floor(ms / 1000) % 60;
+       const cs = Math.floor(ms / 10) % 100;
+       return `${String(m).padStart(2, '0')}:` +
+           `${String(s).padStart(2, '0')}.` +
+           `${String(cs).padStart(2, '0')}`;
+     };
+     const tick = () => {
+       disp.textContent = fmt(elapsed + (Date.now() - startAt));
