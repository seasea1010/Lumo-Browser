+     {k: 'rate', label: '年利（%）', type: 'number', def: '3'},
+     {k: 'years', label: '期間（年）', type: 'number', def: '10'},
+   ],
+   fn: v => {
+     const p = +v.principal || 0;
+     const m = +v.monthly || 0;
+     const r = (+v.rate || 0) / 100 / 12;
+     const n = Math.max(0, Math.round((+v.years || 0) * 12));
+     const fvP = p * Math.pow(1 + r, n);
+     const fvM = r === 0 ? m * n :
+         m * (Math.pow(1 + r, n) - 1) / r;
+     const paid = p + m * n;
+     return [
+       ['将来の金額', `${fmtNum(Math.round(fvP + fvM))} 円`],
+       ['払い込んだ金額', `${fmtNum(Math.round(paid))} 円`],
+       ['増えた金額（運用益）', `${fmtNum(Math.round(fvP + fvM - paid))} 円`],
+     ];
+   }},
