+  'KiB': {label: 'KiB (2^10 B)', factor: 1024},
+  'MiB': {label: 'MiB (2^20 B)', factor: 1024 ** 2},
+  'GiB': {label: 'GiB (2^30 B)', factor: 1024 ** 3},
+  'TiB': {label: 'TiB (2^40 B)', factor: 1024 ** 4},
+};
+const LENGTH_UNITS = {
+  'mm': {label: 'mm', factor: 0.001},
+  'cm': {label: 'cm', factor: 0.01},
+  'm': {label: 'm', factor: 1},
+  'km': {label: 'km', factor: 1000},
+  'in': {label: 'インチ', factor: 0.0254},
+  'ft': {label: 'フィート', factor: 0.3048},
+  'yd': {label: 'ヤード', factor: 0.9144},
+  'mi': {label: 'マイル', factor: 1609.344},
+  'nmi': {label: '海里', factor: 1852},
+};
+const WEIGHT_UNITS = {
+  'mg': {label: 'mg', factor: 0.001},
+  'g': {label: 'g', factor: 1},
+  'kg': {label: 'kg', factor: 1000},
+  't': {label: 't', factor: 1e6},
+  'oz': {label: 'オンス', factor: 28.349523125},
+  'lb': {label: 'ポンド', factor: 453.59237},
