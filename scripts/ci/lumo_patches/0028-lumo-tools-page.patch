+  {id: 'luhn-check', cat: 'hash', name: 'クレジットカード番号チェック',
+   kind: 'form',
+   desc: 'Luhn アルゴリズムで番号の妥当性を確認します（番号は外部に送信されません）。',
+   fields: [
+     {k: 'num', label: 'カード番号', type: 'text'},
+   ],
+   fn: v => {
+     const digits = (v.num || '').replace(/[\s-]/g, '');
+     if (!/^\d{12,19}$/.test(digits)) {
+       return '12〜19桁の数字を入力してください。';
+     }
+     let sum = 0;
+     let alt = false;
+     for (let i = digits.length - 1; i >= 0; i--) {
+       let d = +digits[i];
+       if (alt) {
+         d *= 2;
+         if (d > 9) {
+           d -= 9;
+         }
+       }
+       sum += d;
+       alt = !alt;
+     }
+     const brand = /^4/.test(digits) ? 'Visa' :
+         /^(5[1-5]|2[2-7])/.test(digits) ? 'Mastercard' :
+         /^3[47]/.test(digits) ? 'American Express' :
+         /^35/.test(digits) ? 'JCB' :
+         /^3(0[0-5]|[68])/.test(digits) ? 'Diners Club' :
+         /^6/.test(digits) ? 'Discover' : '不明';
+     return [
+       ['桁数', `${digits.length} 桁`],
+       ['Luhn チェック', sum % 10 === 0 ? '有効な番号形式です' :
+           'チェックディジットが一致しません'],
+       ['カード種別の推定', brand],
+     ];
+   }},
