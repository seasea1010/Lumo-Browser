+     const rows = parseCsv(text);
+     if (rows.length < 1) {
+       return '[]';
+     }
+     const head = rows[0];
+     const objs = rows.slice(1).filter(r => r.length > 1 ||
+         (r.length === 1 && r[0] !== '')).map(r => {
+       const o = {};
+       head.forEach((key, i) => {
