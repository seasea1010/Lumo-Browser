+  {id: 'ua-parse', cat: 'web', name: 'User Agent 解析', kind: 'io',
+   desc: 'User Agent 文字列からブラウザと OS を推定します（簡易判定）。',
+   fn: text => {
+     const ua = text.trim();
+     if (!ua) {
+       return '';
+     }
+     const pick = (list) => {
+       for (const [re, name] of list) {
+         const m = ua.match(re);
+         if (m) {
+           return `${name} ${m[1] || ''}`.trim();
+         }
+       }
+       return '不明';
+     };
+     const browser = pick([
+       [/Edg\/([\d.]+)/, 'Microsoft Edge'],
+       [/OPR\/([\d.]+)/, 'Opera'],
+       [/Chrome\/([\d.]+)/, 'Chrome / Chromium'],
+       [/Firefox\/([\d.]+)/, 'Firefox'],
+       [/Version\/([\d.]+).*Safari/, 'Safari'],
+     ]);
+     const os = pick([
+       [/Windows NT ([\d.]+)/, 'Windows NT'],
+       [/Mac OS X ([\d_]+)/, 'macOS'],
+       [/Android ([\d.]+)/, 'Android'],
+       [/iPhone OS ([\d_]+)/, 'iOS'],
+       [/Linux/, 'Linux'],
+     ]);
+     return `ブラウザ: ${browser}\nOS: ${os}\nモバイル: ` +
+         (/Mobile|Android|iPhone|iPad/.test(ua) ? 'はい' : 'いいえ');
+   }},
