+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/lumo_tools/lumo_tools_ui.h"
+
+#include "chrome/grit/lumo_tools_resources.h"
+#include "chrome/grit/lumo_tools_resources_map.h"
+#include "content/public/browser/browser_context.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_ui.h"
+#include "content/public/browser/web_ui_data_source.h"
+#include "ui/webui/webui_util.h"
+
+LumoToolsUI::LumoToolsUI(content::WebUI* web_ui)
+    : content::WebUIController(web_ui) {
+  content::WebUIDataSource* source = content::WebUIDataSource::CreateAndAdd(
+      web_ui->GetWebContents()->GetBrowserContext(),
+      chrome::kChromeUIToolsHost);
+
+  // Add required resources. The page is fully self-contained:
+  // tools.html plus its stylesheet and script are the only files.
+  webui::SetupWebUIDataSource(source, kLumoToolsResources,
+                              IDR_LUMO_TOOLS_TOOLS_HTML);
+}
+
+LumoToolsUI::~LumoToolsUI() = default;
diff --git a/chrome/browser/ui/webui/lumo_tools/lumo_tools_ui.h b/chrome/browser/ui/webui/lumo_tools/lumo_tools_ui.h
