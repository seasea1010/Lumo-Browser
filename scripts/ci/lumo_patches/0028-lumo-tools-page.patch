+function convertUnit(value, fromKey, units) {
+  const base = value * units[fromKey].factor;
+  return Object.keys(units).map(k => [
+    units[k].label, roundNice(base / units[k].factor)]);
+}
+
+/* Color helpers (colors are plain {r, g, b} objects, 0-255). */
+
+function parseColor(str) {
+  const s = (str || '').trim().toLowerCase();
+  let m = s.match(/^#([0-9a-f]{3}|[0-9a-f]{6})$/);
+  if (m) {
+    let hex = m[1];
+    if (hex.length === 3) {
+      hex = [...hex].map(c => c + c).join('');
+    }
+    return {
+      r: parseInt(hex.substr(0, 2), 16),
+      g: parseInt(hex.substr(2, 2), 16),
+      b: parseInt(hex.substr(4, 2), 16),
+    };
+  }
+  m = s.match(/^rgb\(\s*(\d+)\s*,\s*(\d+)\s*,\s*(\d+)\s*\)$/);
+  if (m) {
+    return {r: +m[1], g: +m[2], b: +m[3]};
+  }
+  m = s.match(/^hsl\(\s*([\d.]+)\s*,\s*([\d.]+)%\s*,\s*([\d.]+)%\s*\)$/);
+  if (m) {
+    return hslToRgb(+m[1], +m[2] / 100, +m[3] / 100);
+  }
+  throw new Error('色として解釈できません（#rrggbb / rgb() / hsl() 形式で入力してください）。');
+}
+
+function hslToRgb(hDeg, s, l) {
+  const h = (((hDeg % 360) + 360) % 360) / 60;
+  const c = (1 - Math.abs(2 * l - 1)) * s;
+  const x = c * (1 - Math.abs((h % 2) - 1));
+  const m = l - c / 2;
+  let rgb;
+  if (h < 1) {
+    rgb = [c, x, 0];
+  } else if (h < 2) {
+    rgb = [x, c, 0];
+  } else if (h < 3) {
+    rgb = [0, c, x];
+  } else if (h < 4) {
+    rgb = [0, x, c];
+  } else if (h < 5) {
+    rgb = [x, 0, c];
+  } else {
+    rgb = [c, 0, x];
+  }
+  return {
+    r: Math.round((rgb[0] + m) * 255),
+    g: Math.round((rgb[1] + m) * 255),
+    b: Math.round((rgb[2] + m) * 255),
+  };
+}
+
+function rgbToHsl(c) {
+  const r = c.r / 255;
+  const g = c.g / 255;
+  const b = c.b / 255;
+  const max = Math.max(r, g, b);
+  const min = Math.min(r, g, b);
+  const l = (max + min) / 2;
+  if (max === min) {
+    return [0, 0, l];
+  }
+  const d = max - min;
+  const s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
+  let h;
+  if (max === r) {
+    h = ((g - b) / d + (g < b ? 6 : 0)) * 60;
+  } else if (max === g) {
+    h = ((b - r) / d + 2) * 60;
+  } else {
+    h = ((r - g) / d + 4) * 60;
+  }
+  return [h, s, l];
+}
+
+function rgbToHex(c) {
+  return '#' + [c.r, c.g, c.b]
+      .map(v => v.toString(16).padStart(2, '0')).join('');
+}
+
+function rgbCss(c) {
+  return `rgb(${c.r}, ${c.g}, ${c.b})`;
+}
+
+function rgbToHslText(c) {
+  const [hDeg, s, l] = rgbToHsl(c);
+  return `hsl(${Math.round(hDeg)}, ${Math.round(s * 100)}%, ` +
+      `${Math.round(l * 100)}%)`;
+}
+
+function rgbToHsvText(c) {
+  const r = c.r / 255;
+  const g = c.g / 255;
+  const b = c.b / 255;
+  const max = Math.max(r, g, b);
+  const min = Math.min(r, g, b);
+  const d = max - min;
+  let hDeg = 0;
+  if (d !== 0) {
+    if (max === r) {
+      hDeg = ((g - b) / d + (g < b ? 6 : 0)) * 60;
+    } else if (max === g) {
+      hDeg = ((b - r) / d + 2) * 60;
+    } else {
+      hDeg = ((r - g) / d + 4) * 60;
+    }
+  }
+  const s = max === 0 ? 0 : d / max;
+  return `hsv(${Math.round(hDeg)}, ${Math.round(s * 100)}%, ` +
+      `${Math.round(max * 100)}%)`;
+}
+
+function mixColor(c1, c2, t) {
+  return {
+    r: Math.round(c1.r + (c2.r - c1.r) * t),
+    g: Math.round(c1.g + (c2.g - c1.g) * t),
+    b: Math.round(c1.b + (c2.b - c1.b) * t),
+  };
+}
+
+function contrastRatio(c1, c2) {
+  const lum = c => {
+    const f = v => {
+      const s = v / 255;
+      return s <= 0.03928 ? s / 12.92 :
+          Math.pow((s + 0.055) / 1.055, 2.4);
+    };
+    return 0.2126 * f(c.r) + 0.7152 * f(c.g) + 0.0722 * f(c.b);
+  };
+  const l1 = lum(c1);
+  const l2 = lum(c2);
+  return (Math.max(l1, l2) + 0.05) / (Math.min(l1, l2) + 0.05);
+}
+
+/* Wareki (Japanese era) helpers. */
+
+const ERAS = {
+  '令和': {start: new Date(2019, 4, 1)},
+  '平成': {start: new Date(1989, 0, 8)},
+  '昭和': {start: new Date(1926, 11, 25)},
+  '大正': {start: new Date(1912, 6, 30)},
+  '明治': {start: new Date(1868, 0, 25)},
+};
+
+function toWareki(date) {
+  for (const name of Object.keys(ERAS)) {
+    const start = ERAS[name].start;
+    if (date >= start) {
+      const year = date.getFullYear() - start.getFullYear() + 1;
+      return `${name}${year === 1 ? '元' : year}年` +
+          `${date.getMonth() + 1}月${date.getDate()}日`;
+    }
+  }
+  return null;
+}
+
+function rowsEls(rows) {
+  return rows.map(([k, v]) => {
+    const row = h('div', 'row');
+    row.appendChild(h('span', 'k', k));
+    row.appendChild(h('span', 'v', String(v)));
+    return row;
+  });
+}
+
+/* ------------------------------------------------------------------ */
+/* Rendering                                                           */
+/* ------------------------------------------------------------------ */
+
+function makeOutput(body) {
+  const out = h('div');
+  body.appendChild(out);
+  const err = h('div', 'error');
+  body.appendChild(err);
+  let token = 0;
+  return {
+    show(value) {
+      const my = ++token;
+      const render = v => {
+        if (my !== token) {
+          return;
+        }
+        err.textContent = '';
+        if (typeof v === 'string') {
+          const div = h('div', 'result', v);
+          out.replaceChildren(div);
+        } else if (Array.isArray(v)) {
+          const wrap = h('div', 'result-rows');
+          wrap.replaceChildren(...rowsEls(v));
+          out.replaceChildren(wrap);
+        } else {
+          out.replaceChildren();
+        }
+      };
+      if (value && typeof value.then === 'function') {
+        value.then(render, e => {
+          if (my === token) {
+            err.textContent = String((e && e.message) || e);
+            out.replaceChildren();
+          }
+        });
+      } else {
+        render(value);
+      }
+    },
+    fail(e) {
+      token++;
+      err.textContent = String((e && e.message) || e);
+      out.replaceChildren();
+    },
+  };
+}
+
+function buildIo(tool, body) {
+  const opts = {};
+  function run() {
+    const my = ++token;
+    try {
+      const v = tool.fn(ta.value, opts);
+      if (v && typeof v.then === 'function') {
+        v.then(r => {
+          if (my === token) {
+            outTa.value = r;
+            err.textContent = '';
+          }
+        }, e => {
+          if (my === token) {
+            err.textContent = String((e && e.message) || e);
+          }
+        });
+      } else {
+        outTa.value = v;
+        err.textContent = '';
+      }
+    } catch (e) {
+      err.textContent = String((e && e.message) || e);
+    }
+  }
+  let token = 0;
+  if (tool.opts) {
+    const wrap = h('div', 'fields');
+    for (const opt of tool.opts) {
+      const col = h('div');
+      col.appendChild(h('label', null, opt.label));
+      let input;
+      if (opt.type === 'select') {
+        input = h('select');
+        for (const [val, label] of opt.options) {
+          const o = h('option', null, label);
+          o.value = val;
+          input.appendChild(o);
+        }
+        opts[opt.k] = input.value;
+      } else if (opt.type === 'check') {
+        input = h('input');
+        input.type = 'checkbox';
+        input.checked = !!opt.def;
+        opts[opt.k] = input.checked;
+      }
+      input.addEventListener('change', () => {
+        opts[opt.k] = opt.type === 'check' ? input.checked : input.value;
+        run();
+      });
+      col.appendChild(input);
+      wrap.appendChild(col);
+    }
+    body.appendChild(wrap);
+  }
+  body.appendChild(h('label', null, '入力'));
+  const ta = h('textarea');
+  ta.spellcheck = false;
+  body.appendChild(ta);
+  body.appendChild(h('label', null, '出力'));
+  const outTa = h('textarea');
+  outTa.readOnly = true;
+  outTa.spellcheck = false;
+  body.appendChild(outTa);
+  const err = h('div', 'error');
+  body.appendChild(err);
+  ta.addEventListener('input', run);
+  run();
+}
+
+function buildStat(tool, body) {
+  const ta = h('textarea');
+  ta.spellcheck = false;
+  body.appendChild(h('label', null, '入力'));
+  body.appendChild(ta);
+  const wrap = h('div', 'result-rows');
+  body.appendChild(wrap);
+  const err = h('div', 'error');
+  body.appendChild(err);
+  const run = () => {
+    try {
+      wrap.replaceChildren(...rowsEls(tool.fn(ta.value)));
+      err.textContent = '';
+    } catch (e) {
+      err.textContent = String((e && e.message) || e);
+    }
+  };
+  ta.addEventListener('input', run);
+  run();
+}
+
+function fieldControl(field) {
+  let input;
+  if (field.type === 'textarea') {
+    input = h('textarea');
+    input.spellcheck = false;
+  } else if (field.type === 'select') {
+    input = h('select');
+    for (const [val, label] of field.options) {
+      const o = h('option', null, label);
+      o.value = val;
+      input.appendChild(o);
+    }
+  } else {
+    input = h('input');
+    input.type = field.type || 'text';
+    if (field.type === 'number') {
+      if (field.min != null) {
+        input.min = field.min;
+      }
+      if (field.max != null) {
+        input.max = field.max;
+      }
+    }
+    input.spellcheck = false;
+  }
+  if (field.type === 'check') {
+    input.checked = !!field.def;
+  } else if (field.def != null) {
+    input.value = field.def;
+  }
+  return input;
+}
+
+function fieldValue(field, input) {
+  return field.type === 'check' ? input.checked : input.value;
+}
+
+function buildForm(tool, body) {
+  const output = makeOutput(body);
+  const wrap = h('div', 'fields');
+  body.insertBefore(wrap, body.firstChild);
+  const inputs = tool.fields.map(field => {
+    const col = h('div');
+    col.appendChild(h('label', null, field.label));
+    const input = fieldControl(field);
+    col.appendChild(input);
+    wrap.appendChild(col);
+    return [field, input];
+  });
+  const collect = () => {
+    const values = {};
+    for (const [field, input] of inputs) {
+      values[field.k] = fieldValue(field, input);
+    }
+    return values;
+  };
+  const run = () => {
+    try {
+      output.show(tool.fn(collect()));
+    } catch (e) {
+      output.fail(e);
+    }
+  };
+  if (tool.button) {
+    const btn = h('button', 'action', tool.button);
+    btn.addEventListener('click', run);
+    body.insertBefore(btn, body.lastChild.previousSibling);
+  } else {
+    for (const [, input] of inputs) {
+      input.addEventListener('input', run);
+      input.addEventListener('change', run);
+    }
+  }
+  run();
+}
+
+function buildTable(tool, body) {
+  const table = h('table', 'ref');
+  const thead = h('thead');
+  const htr = h('tr');
+  for (const label of tool.head) {
+    htr.appendChild(h('th', null, label));
+  }
+  thead.appendChild(htr);
+  table.appendChild(thead);
+  const tbody = h('tbody');
+  for (const row of tool.rows) {
+    const tr = h('tr');
+    for (const cell of row) {
+      tr.appendChild(h('td', null, cell));
+    }
+    tbody.appendChild(tr);
+  }
+  table.appendChild(tbody);
+  body.appendChild(table);
+}
+
+const BUILDERS = {
+  io: buildIo,
+  stat: buildStat,
+  form: buildForm,
+  table: buildTable,
+  custom: (tool, body) => tool.render(body),
+};
+
+function renderTool(tool) {
+  const card = h('section', 'tool');
+  card.appendChild(h('h3', null, tool.name));
+  if (tool.desc) {
+    card.appendChild(h('p', 'desc', tool.desc));
+  }
+  const body = h('div', 'body');
+  card.appendChild(body);
+  BUILDERS[tool.kind](tool, body);
+  return card;
+}
+
+function init() {
+  const main = document.getElementById('tools');
+  const nav = document.getElementById('cats');
+  const search = document.getElementById('search');
+  const count = document.getElementById('count');
+  const groups = new Map();
+  for (const cat of CATS) {
+    const section = h('section', 'cat-group');
+    section.appendChild(h('h2', null, cat.label));
+    main.appendChild(section);
+    groups.set(cat.key, section);
+  }
+  const cards = TOOLS.map(tool => {
+    const card = renderTool(tool);
+    groups.get(tool.cat).appendChild(card);
+    return {tool, card};
+  });
+  let activeCat = 'all';
+  const navButtons = new Map();
+  const addNav = (key, label) => {
+    const btn = h('button', null, label);
+    btn.addEventListener('click', () => {
+      activeCat = key;
+      for (const [k, b] of navButtons) {
+        b.classList.toggle('active', k === key);
+      }
+      applyFilter();
+    });
+    nav.appendChild(btn);
+    navButtons.set(key, btn);
+  };
+  addNav('all', 'すべて');
+  for (const cat of CATS) {
+    addNav(cat.key, cat.label);
+  }
+  navButtons.get('all').classList.add('active');
+  function applyFilter() {
+    const q = search.value.trim().toLowerCase();
+    let visible = 0;
+    for (const {tool, card} of cards) {
+      const text = (tool.name + ' ' + (tool.desc || '')).toLowerCase();
+      const ok = (activeCat === 'all' || tool.cat === activeCat) &&
+          (!q || text.includes(q));
+      card.classList.toggle('hidden', !ok);
+      if (ok) {
+        visible++;
+      }
+    }
+    for (const section of groups.values()) {
+      const any = [...section.children].some(
+          c => c.tagName === 'SECTION' && !c.classList.contains('hidden'));
+      section.classList.toggle('hidden', !any);
+    }
+    count.textContent = `${visible} / ${TOOLS.length} 個のツール`;
+  }
+  search.addEventListener('input', applyFilter);
+  applyFilter();
+}
+
+init();
