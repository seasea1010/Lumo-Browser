+     }
+     let score = 0;
+     const rows = [];
+     rows.push(['長さ', `${[...pw].length} 文字`]);
+     score += Math.min(40, [...pw].length * 3);
+     const kinds = [/[a-z]/, /[A-Z]/, /[0-9]/, /[^a-zA-Z0-9]/]
+         .filter(re => re.test(pw)).length;
+     rows.push(['文字の種類', `${kinds} 種類`]);
+     score += kinds * 12;
+     if (/(.)\1\1/.test(pw)) {
+       rows.push(['注意', '同じ文字の繰り返しがあります']);
+       score -= 10;
+     }
+     if (/^(password|123456|qwerty|letmein)/i.test(pw)) {
+       rows.push(['注意', 'よく使われるパターンです']);
+       score -= 20;
+     }
+     score = Math.max(0, Math.min(100, score));
+     const label = score >= 80 ? '強い' : score >= 60 ? 'やや強い' :
+         score >= 40 ? '普通' : score >= 20 ? '弱い' : 'とても弱い';
