+     }
+     const birth = new Date(v.birth + 'T00:00:00');
+     const base = v.base ? new Date(v.base + 'T00:00:00') : new Date();
+     let age = base.getFullYear() - birth.getFullYear();
+     const md = (base.getMonth() - birth.getMonth()) ||
+         (base.getDate() - birth.getDate());
+     if (md < 0) {
+       age--;
+     }
+     const days = Math.floor((base - birth) / 86400000);
