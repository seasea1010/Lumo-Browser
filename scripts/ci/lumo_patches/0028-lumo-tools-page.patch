+/* Copyright 2026 seasea1010
+ * Use of this source code is governed by a BSD-style license that can be
+ * found in the LICENSE file. */
+
+/* Flat styling in the spirit of Chromium's internal pages:
+   plain colors, thin borders, no shadows or gradients. */
+
+:root {
+  --bg: #fff;
+  --fg: #202124;
+  --muted: #5f6368;
+  --border: #dadce0;
+  --panel: #f8f9fa;
+  --accent: #1a73e8;
+  --accent-fg: #fff;
+  --input-bg: #fff;
+  --error: #b3261e;
+}
+
+@media (prefers-color-scheme: dark) {
+  :root {
+    --bg: #202124;
+    --fg: #e8eaed;
+    --muted: #9aa0a6;
+    --border: #3c4043;
+    --panel: #292a2d;
+    --accent: #8ab4f8;
+    --accent-fg: #202124;
+    --input-bg: #303134;
+    --error: #f28b82;
+  }
+}
+
+* {
+  box-sizing: border-box;
+}
+
+body {
+  background: var(--bg);
+  color: var(--fg);
+  font-family: system-ui, "Segoe UI", "Hiragino Kaku Gothic ProN",
+      "Yu Gothic UI", sans-serif;
+  font-size: 14px;
+  line-height: 1.5;
+  margin: 0 auto;
+  max-width: 1080px;
+  padding: 24px 20px 48px;
+}
+
+header h1 {
+  font-size: 22px;
+  font-weight: 500;
+  margin: 0 0 4px;
+}
+
+.subtitle {
+  color: var(--muted);
+  margin: 0 0 16px;
+}
+
+.search-row {
+  align-items: center;
+  display: flex;
+  gap: 12px;
+  margin-bottom: 20px;
+}
+
+#search {
+  background: var(--input-bg);
+  border: 1px solid var(--border);
+  border-radius: 4px;
+  color: var(--fg);
+  flex: 1;
+  font: inherit;
+  max-width: 480px;
+  padding: 8px 10px;
+}
+
+.count {
+  color: var(--muted);
+}
+
+.layout {
+  display: flex;
+  gap: 24px;
+  align-items: flex-start;
+}
+
+nav#cats {
+  display: flex;
+  flex-direction: column;
+  flex: 0 0 168px;
+  gap: 2px;
+  position: sticky;
+  top: 16px;
+}
+
+nav#cats button {
+  background: none;
+  border: 1px solid transparent;
+  border-radius: 4px;
+  color: var(--fg);
+  cursor: pointer;
+  font: inherit;
+  padding: 6px 10px;
+  text-align: left;
+}
+
+nav#cats button:hover {
+  background: var(--panel);
+}
+
+nav#cats button.active {
+  border-color: var(--border);
+  background: var(--panel);
+  font-weight: 600;
+}
+
+main#tools {
+  flex: 1;
+  min-width: 0;
+}
+
+section.cat-group {
+  margin-bottom: 28px;
+}
+
+section.cat-group > h2 {
+  border-bottom: 1px solid var(--border);
+  font-size: 16px;
+  font-weight: 600;
+  margin: 0 0 12px;
+  padding-bottom: 6px;
+}
+
+.tool {
+  border: 1px solid var(--border);
+  border-radius: 6px;
+  margin-bottom: 12px;
+  padding: 12px 14px;
+}
+
+.tool h3 {
+  font-size: 14px;
+  font-weight: 600;
+  margin: 0 0 2px;
+}
+
+.tool .desc {
+  color: var(--muted);
+  font-size: 12px;
+  margin: 0 0 10px;
+}
+
+.tool label {
+  display: block;
+  font-size: 12px;
+  color: var(--muted);
+  margin: 8px 0 4px;
+}
+
+.tool textarea,
+.tool input[type="text"],
+.tool input[type="number"],
+.tool input[type="password"],
+.tool input[type="date"],
+.tool input[type="datetime-local"],
+.tool input[type="time"],
+.tool select {
+  background: var(--input-bg);
+  border: 1px solid var(--border);
+  border-radius: 4px;
+  color: var(--fg);
+  font: inherit;
+  padding: 6px 8px;
+  width: 100%;
+}
+
+.tool textarea {
+  font-family: ui-monospace, "Cascadia Mono", Consolas, monospace;
+  font-size: 13px;
+  min-height: 64px;
+  resize: vertical;
+}
+
+.tool textarea[readonly] {
+  background: var(--panel);
+}
+
+.tool .fields {
+  display: grid;
+  gap: 0 12px;
+  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
+}
+
+.tool button.action {
+  background: var(--accent);
+  border: 1px solid var(--accent);
+  border-radius: 4px;
+  color: var(--accent-fg);
+  cursor: pointer;
+  font: inherit;
+  margin-top: 10px;
+  padding: 6px 14px;
+}
+
+.tool button.plain {
+  background: var(--panel);
+  border: 1px solid var(--border);
+  border-radius: 4px;
+  color: var(--fg);
+  cursor: pointer;
+  font: inherit;
+  margin-top: 10px;
+  padding: 6px 14px;
+}
+
+.tool .result {
+  margin-top: 10px;
+  overflow-wrap: anywhere;
+  white-space: pre-wrap;
+}
+
+.tool .result-rows {
+  margin-top: 10px;
+}
+
+.tool .result-rows .row {
+  display: flex;
+  gap: 12px;
+  padding: 2px 0;
+}
+
+.tool .result-rows .row .k {
+  color: var(--muted);
+  flex: 0 0 180px;
+}
+
+.tool .error {
+  color: var(--error);
+  margin-top: 10px;
+  white-space: pre-wrap;
+}
+
+.tool table.ref {
+  border-collapse: collapse;
+  margin-top: 8px;
+  width: 100%;
+}
+
+.tool table.ref th,
+.tool table.ref td {
+  border: 1px solid var(--border);
+  padding: 4px 8px;
+  text-align: left;
+  vertical-align: top;
+}
+
+.tool table.ref th {
+  background: var(--panel);
+  font-weight: 600;
+}
+
+.tool .swatch {
+  border: 1px solid var(--border);
+  border-radius: 4px;
+  display: inline-block;
+  height: 28px;
+  margin-top: 8px;
+  width: 100%;
+}
+
+.tool .big-clock {
+  font-size: 20px;
+  font-variant-numeric: tabular-nums;
+}
+
+.tool .clock-grid {
+  display: grid;
+  gap: 4px 16px;
+  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
+  margin-top: 8px;
+}
+
+.tool .clock-grid .row {
+  display: flex;
+  justify-content: space-between;
+  border-bottom: 1px solid var(--border);
+  padding: 4px 0;
+}
+
+.tool input[type="color"] {
+  background: var(--input-bg);
+  border: 1px solid var(--border);
+  border-radius: 4px;
+  height: 36px;
+  padding: 2px;
+  width: 100%;
+}
+
+.hidden {
+  display: none !important;
+}
