+  private setupLumoWelcome_() {
+    this.$.lumoWelcomeTitle.textContent =
+        loadTimeData.getString('lumoWelcomeTitle');
+    this.$.lumoWelcomeSubtitle.textContent =
+        loadTimeData.getString('lumoWelcomeSubtitle');
+    this.$.lumoWelcomeNext.textContent =
