{
  "manifest_version": 3,
  "name": "Chrome Info Viewer（Chrome情報ビューア）",
  "version": "1.0.0",
  "key": "",
  "description": "Chromeから取得できる情報（ブラウザ・PC・画面・ネットワーク・拡張機能・プライバシー設定など）を分かりやすく一覧表示します。",
  "action": { "default_title": "Chromeの情報を表示" },
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" },
  "permissions": [
    "system.cpu", "system.memory", "system.storage", "system.display",
    "management", "tabs", "tabGroups", "history", "bookmarks", "cookies",
    "downloads", "sessions", "topSites", "identity", "identity.email",
    "privacy", "proxy", "tts", "storage", "contentSettings", "fontSettings"
  ],
  "host_permissions": ["<all_urls>"]
}
